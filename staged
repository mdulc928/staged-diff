# 3. Tier 1 & Tier 2: Zero-Replication Linting, Import Resolution & Typechecking (`staged check`)
# ---------------------------------------------------------------------------

def build_python_overlay_env(session, base_env=None):
    env = dict(os.environ if base_env is None else base_env)
    overlay_entries = [str(session.staging.resolve()), str(session.workspace.resolve())]
    for var in ('PYTHONPATH', 'MYPYPATH'):
        existing = env.get(var, '')
        parts = overlay_entries + ([existing] if existing else [])
        env[var] = os.pathsep.join(parts)
    return env


def check_python_syntax_and_imports(session, rel):
    staged_path = safe_path(session.staging, rel)
    raw = staged_path.read_bytes()
    try:
        source = raw.decode('utf-8')
    except UnicodeDecodeError as exc:
        return False, ['{}:1:1: SyntaxError: invalid UTF-8 encoding ({})'.format(rel, exc)]

    try:
        tree = ast.parse(source, filename=rel)
    except SyntaxError as exc:
        lineno = exc.lineno or 1
        col = exc.offset or 1
        return False, ['{}:{}:{}: SyntaxError: {}'.format(rel, lineno, col, exc.msg)]

    diagnostics = []
    deleted_set = set(session.deletions)
    rename_sources = {old for dst, old in session.manifest.items() if dst != '_deletions' and old != dst}
    unavailable_ws_files = deleted_set | rename_sources

    rel_parent = Path(rel).parent

    def _resolve_module_candidates(mod_name, level=0):
        parts = mod_name.split('.') if mod_name else []
        if level > 0:
            base = rel_parent
            for _ in range(level - 1):
                base = base.parent
            target_rel = base.joinpath(*parts) if parts else base
        else:
            target_rel = Path(*parts) if parts else Path('.')
        posix_base = target_rel.as_posix().lstrip('./')
        if not posix_base:
            return []
        return [
            posix_base + '.py',
            posix_base + '/__init__.py',
        ]

    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                candidates = _resolve_module_candidates(alias.name, level=0)
                if any(c in unavailable_ws_files and not (session.staging / c).is_file() for c in candidates):
                    diagnostics.append(
                        '{}:{}:1: ImportError: module {!r} is staged for deletion/rename'.format(
                            rel, getattr(node, 'lineno', 1), alias.name
                        )
                    )
        elif isinstance(node, ast.ImportFrom):
            candidates = _resolve_module_candidates(node.module or '', level=node.level or 0)
            if any(c in unavailable_ws_files and not (session.staging / c).is_file() for c in candidates):
                diagnostics.append(
                    '{}:{}:1: ImportError: module {!r} is staged for deletion/rename'.format(
                        rel, getattr(node, 'lineno', 1), node.module or '.'
                    )
                )
            elif node.level and node.level > 0:
                resolved_file = None
                for c in candidates:
                    st_cand = session.staging / c
                    ws_cand = session.workspace / c
                    if st_cand.is_file():
                        resolved_file = st_cand
                        break
                    if c not in unavailable_ws_files and ws_cand.is_file():
                        resolved_file = ws_cand
                        break
                if resolved_file is None and candidates:
                    pkg_dir = Path(candidates[0]).parent
                    sub_ok = True
                    for alias in node.names:
                        if alias.name == '*':
                            sub_ok = False
                            break
                        sub_py = (pkg_dir / (alias.name + '.py')).as_posix()
                        if not ((session.staging / sub_py).is_file() or (
                            sub_py not in unavailable_ws_files and (session.workspace / sub_py).is_file()
                        )):
                            sub_ok = False
                            break
                    if not sub_ok:
                        diagnostics.append(
                            '{}:{}:1: ImportError: cannot resolve relative import {!r}'.format(
                                rel, getattr(node, 'lineno', 1), node.module or '.'
                            )
                        )

    return len(diagnostics) == 0, diagnostics


def deleted_set_or_renames(deleted_rels, rename_sources):
    return set(deleted_rels) | set(rename_sources)


def generate_tsconfig_overlay(session, ts_files=None):
    ws_tsconfig = session.workspace / 'tsconfig.json'
    overlay_path = safe_path(session.directory, '.review/tsconfig.staged.json')

    staged_files = session.files(fresh=True)
    deleted_rels = set(session.deletions)
    rename_sources = {old for dst, old in session.manifest.items() if dst != '_deletions' and old != dst}
    shadowed_ws_rels = set(staged_files.keys()) | deleted_set_or_renames(deleted_rels, rename_sources)

    include_list = [
        (session.staging.resolve().as_posix() + '/**/*'),
        (session.workspace.resolve().as_posix() + '/**/*'),
    ]
    exclude_list = [
        (session.workspace.resolve() / 'node_modules').as_posix(),
    ]
    for rel in sorted(shadowed_ws_rels):
        exclude_list.append(safe_path(session.workspace, rel).as_posix())
    for rel in sorted(session.sandbox_entries()):
        exclude_list.append((session.staging.resolve() / rel).as_posix())

    config = {
        'compilerOptions': {
            'noEmit': True,
            'rootDirs': [
                str(session.staging.resolve()),
                str(session.workspace.resolve()),
            ],
        },
        'include': include_list,
        'exclude': exclude_list,
    }
    if ws_tsconfig.is_file():
        config['extends'] = str(ws_tsconfig.resolve())

    write_text_file(overlay_path, json.dumps(config, indent=2) + '\n')
    return overlay_path


def build_c_check_command(session, rel, compiler=None):
    ext = Path(rel).suffix.lower()
    is_cpp = ext in CPP_EXTENSIONS
    if compiler is None:
        candidates = ('clang++', 'g++', 'clang', 'gcc') if is_cpp else ('clang', 'gcc')
        for name in candidates:
            found = resolve_local_binary(session.workspace, name)
            if found:
                compiler = found
                break
    if not compiler:
        return None

    staged_file = safe_path(session.staging, rel)
    ws_file = safe_path(session.workspace, rel)
    return [
        compiler,
        '-fsyntax-only',
        '-I' + str(staged_file.parent),
        '-I' + str(ws_file.parent),
        '-I' + str(session.staging),
        '-I' + str(session.workspace),
        str(staged_file),
    ]


def build_java_check_command(session, rel_or_files, tmp_out, javac_bin=None):
    if javac_bin is None:
        javac_bin = resolve_local_binary(session.workspace, 'javac')
    if not javac_bin:
        return None

    rels = [rel_or_files] if isinstance(rel_or_files, str) else list(rel_or_files)
    staged_targets = [str(safe_path(session.staging, r)) for r in rels]
    sourcepath = os.pathsep.join([str(session.staging.resolve()), str(session.workspace.resolve())])
    return [
        javac_bin,
        '-proc:none',
        '-d', str(tmp_out),
        '-sourcepath', sourcepath,
    ] + staged_targets


def check_staged(ctx, session, target=None):
    args = getattr(ctx, 'args', None)
    if target is None and args is not None:
        target = getattr(args, 'file', None)
    use_sandbox = bool(getattr(args, 'sandbox', False))
    custom_cmd = getattr(args, 'cmd', None) or (ctx.setting('check_cmd') if hasattr(ctx, 'setting') else None)
    as_json = bool(getattr(args, 'json', False))

    if use_sandbox:
        if custom_cmd:
            cmd_tokens = shlex.split(custom_cmd) if isinstance(custom_cmd, str) else list(custom_cmd)
        else:
            cmd_tokens = _detect_project_sandbox_check_command(session.workspace)
        return exec_in_sandbox(ctx, session, cmd_tokens, sync_back=False, as_json=as_json)

    paths = [p for p in selected(session, target) if p not in session.deletions]
    checks = []
    py_env = build_python_overlay_env(session)

    if custom_cmd:
        for rel in paths:
            staged_path = safe_path(session.staging, rel)
            ws_path = safe_path(session.workspace, rel)
            cmd, uses_stdin = _expand_command_template(
                custom_cmd, ws_path, staged_path, session=session, rel=rel
            )
            raw_bytes = staged_path.read_bytes() if uses_stdin else None
            proc = subprocess.run(
                cmd,
                input=raw_bytes,
                capture_output=True,
                cwd=str(session.workspace),
                env=py_env,
            )
            diag_raw = (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip()
            diag = rewrite_diagnostic_paths(diag_raw, session)
            checks.append({
                'path': rel,
                'tool': cmd[0],
                'tier': 1,
                'ok': proc.returncode == 0,
                'returncode': proc.returncode,
                'diagnostics': [diag] if diag else [],
            })
        return _finalize_check_report(checks, as_json=as_json)

    py_files = []
    ts_files = []
    java_files = []

    for rel in paths:
        staged_path = safe_path(session.staging, rel)
        if not staged_path.is_file():
            raise StagedError('Missing staged contents: ' + rel)
        raw_bytes = staged_path.read_bytes()
        if is_binary_bytes(raw_bytes):
            continue

        ws_path = safe_path(session.workspace, rel)
        ext = Path(rel).suffix.lower()

        if ext in PYTHON_EXTENSIONS:
            py_files.append(rel)
            ast_ok, ast_diags = check_python_syntax_and_imports(session, rel)
            checks.append({
                'path': rel,
                'tool': 'python-ast',
                'tier': 1,
                'ok': ast_ok,
                'returncode': 0 if ast_ok else 1,
                'diagnostics': ast_diags,
            })

            ruff = resolve_local_binary(session.workspace, 'ruff')
            if ruff:
                proc = subprocess.run(
                    [ruff, 'check', '--stdin-filename', str(ws_path), '-'],
                    input=raw_bytes,
                    capture_output=True,
                    cwd=str(session.workspace),
                    env=py_env,
                )
                out = rewrite_diagnostic_paths(
                    (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip(), session
                )
                checks.append({
                    'path': rel,
                    'tool': 'ruff',
                    'tier': 1,
                    'ok': proc.returncode == 0,
                    'returncode': proc.returncode,
                    'diagnostics': [out] if (out and proc.returncode != 0) else [],
                })
            else:
                flake8 = resolve_local_binary(session.workspace, 'flake8')
                if flake8:
                    proc = subprocess.run(
                        [flake8, '--stdin-display-name', str(ws_path), '-'],
                        input=raw_bytes,
                        capture_output=True,
                        cwd=str(session.workspace),
                        env=py_env,
                    )
                    out = rewrite_diagnostic_paths(
                        (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip(), session
                    )
                    checks.append({
                        'path': rel,
                        'tool': 'flake8',
                        'tier': 1,
                        'ok': proc.returncode == 0,
                        'returncode': proc.returncode,
                        'diagnostics': [out] if (out and proc.returncode != 0) else [],
                    })

        elif ext in JS_TS_CHECK_EXTENSIONS:
            if ext in TS_EXTENSIONS or (session.workspace / 'tsconfig.json').is_file():
                ts_files.append(rel)
            has_biome = (session.workspace / 'biome.json').is_file() or (session.workspace / 'biome.jsonc').is_file()
            biome = resolve_local_binary(session.workspace, 'biome') if has_biome else None
            eslint = resolve_local_binary(session.workspace, 'eslint')
            if biome:
                proc = subprocess.run(
                    [biome, 'check', '--stdin-file-path=' + str(ws_path)],
                    input=raw_bytes,
                    capture_output=True,
                    cwd=str(session.workspace),
                )
                out = rewrite_diagnostic_paths(
                    (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip(), session
                )
                checks.append({
                    'path': rel,
                    'tool': 'biome',
                    'tier': 1,
                    'ok': proc.returncode == 0,
                    'returncode': proc.returncode,
                    'diagnostics': [out] if (out and proc.returncode != 0) else [],
                })
            elif eslint:
                proc = subprocess.run(
                    [eslint, '--stdin', '--stdin-filename', str(ws_path)],
                    input=raw_bytes,
                    capture_output=True,
                    cwd=str(session.workspace),
                )
                out = rewrite_diagnostic_paths(
                    (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip(), session
                )
                checks.append({
                    'path': rel,
                    'tool': 'eslint',
                    'tier': 1,
                    'ok': proc.returncode == 0,
                    'returncode': proc.returncode,
                    'diagnostics': [out] if (out and proc.returncode != 0) else [],
                })

        elif ext in C_CPP_EXTENSIONS:
            c_cmd = build_c_check_command(session, rel)
            if c_cmd:
                proc = subprocess.run(
                    c_cmd,
                    capture_output=True,
                    cwd=str(session.workspace),
                )
                out = rewrite_diagnostic_paths(
                    (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip(), session
                )
                checks.append({
                    'path': rel,
                    'tool': Path(c_cmd[0]).name,
                    'tier': 1,
                    'ok': proc.returncode == 0,
                    'returncode': proc.returncode,
                    'diagnostics': [out] if (out and proc.returncode != 0) else [],
                })

        elif ext == '.java':
            java_files.append(rel)

        elif ext == '.swift':
            swiftc = resolve_local_binary(session.workspace, 'swiftc')
            if swiftc and not (session.workspace / 'Package.swift').is_file():
                proc = subprocess.run(
                    [swiftc, '-typecheck', str(staged_path)],
                    capture_output=True,
                    cwd=str(session.workspace),
                )
                out = rewrite_diagnostic_paths(
                    (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip(), session
                )
                checks.append({
                    'path': rel,
                    'tool': 'swiftc',
                    'tier': 1,
                    'ok': proc.returncode == 0,
                    'returncode': proc.returncode,
                    'diagnostics': [out] if (out and proc.returncode != 0) else [],
                })

    if java_files:
        tmp_out = session.directory / '.review' / 'javac-classes'
        tmp_out.mkdir(parents=True, exist_ok=True)
        try:
            java_cmd = build_java_check_command(session, java_files, tmp_out)
            if java_cmd:
                proc = subprocess.run(
                    java_cmd,
                    capture_output=True,
                    cwd=str(session.workspace),
                )
                out = rewrite_diagnostic_paths(
                    (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip(), session
                )
                checks.append({
                    'path': ', '.join(java_files),
                    'tool': 'javac',
                    'tier': 2,
                    'ok': proc.returncode == 0,
                    'returncode': proc.returncode,
                    'diagnostics': [out] if (out and proc.returncode != 0) else [],
                })
        finally:
            if tmp_out.exists():
                shutil.rmtree(tmp_out, ignore_errors=True)

    if ts_files and (session.workspace / 'tsconfig.json').is_file():
        tsconfig_staged = generate_tsconfig_overlay(session, ts_files=ts_files)
        tsc = resolve_local_binary(session.workspace, 'tsc')
        if tsc:
            proc = subprocess.run(
                [tsc, '-p', str(tsconfig_staged)],
                capture_output=True,
                cwd=str(session.workspace),
            )
            out = rewrite_diagnostic_paths(
                (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip(), session
            )
            checks.append({
                'path': 'tsconfig.staged.json',
                'tool': 'tsc',
                'tier': 2,
                'ok': proc.returncode == 0,
                'returncode': proc.returncode,
                'diagnostics': [out] if (out and proc.returncode != 0) else [],
            })

    if py_files:
        has_mypy_cfg = any(
            (session.workspace / cfg).is_file()
            for cfg in ('mypy.ini', '.mypy.ini', 'pyproject.toml', 'setup.cfg')
        )
        mypy = resolve_local_binary(session.workspace, 'mypy') if has_mypy_cfg else None
        if mypy:
            staged_py_targets = [str(safe_path(session.staging, r)) for r in py_files]
            proc = subprocess.run(
                [mypy] + staged_py_targets,
                capture_output=True,
                cwd=str(session.workspace),
                env=py_env,
            )
            out = rewrite_diagnostic_paths(
                (proc.stdout + proc.stderr).decode('utf-8', errors='replace').strip(), session
            )
            checks.append({
                'path': ', '.join(py_files),
                'tool': 'mypy',
                'tier': 2,
                'ok': proc.returncode == 0,
                'returncode': proc.returncode,
                'diagnostics': [out] if (out and proc.returncode != 0) else [],
            })

    return _finalize_check_report(checks, as_json=as_json)


def _detect_project_sandbox_check_command(workspace):
    workspace = Path(workspace)
    if (workspace / 'Makefile').is_file() or (workspace / 'makefile').is_file():
        return ['make', 'test']
    if (workspace / 'Package.swift').is_file():
        return ['swift', 'build']
    if (workspace / 'Cargo.toml').is_file():
        return ['cargo', 'check']
    if (workspace / 'go.mod').is_file():
        return ['go', 'vet', './...']
    if (workspace / 'pom.xml').is_file():
        return ['mvn', 'test-compile']
    if (workspace / 'package.json').is_file():
        return ['npm', 'run', 'check']
    return [sys.executable, '-m', 'unittest']


def _finalize_check_report(checks, as_json=False):
    all_diags = []
    for item in checks:
        all_diags.extend(item.get('diagnostics', []))
    failed = [c for c in checks if not c['ok']]
    report = {
        'ok': len(failed) == 0,
        'total_checks': len(checks),
        'passed': len(checks) - len(failed),
        'failed': len(failed),
        'checks': checks,
        'diagnostics': all_diags,
    }
    if as_json:
        print(json.dumps(report))
    else:
        for item in checks:
            status_str = 'PASS' if item['ok'] else 'FAIL'
            code = '32' if item['ok'] else '31'
            print('{} {} ({})'.format(
                color('[{}]'.format(status_str), code),
                item['path'],
                item['tool'],
            ))
            for diag in item.get('diagnostics', []):
                for line in diag.splitlines():
                    print('  ' + line)
    return report


# ---------------------------------------------------------------------------
# 4. Tier 3: Ephemeral Copy-on-Write Overlay Sandbox (`staged exec`)
# ---------------------------------------------------------------------------

def remove_sandbox(sandbox_dir):
    sandbox_dir = Path(sandbox_dir)
    if not sandbox_dir.exists() and not sandbox_dir.is_symlink():
        return
    if sandbox_dir.is_symlink() or sandbox_dir.is_file():
        sandbox_dir.unlink()
        return

    for entry in list(sandbox_dir.iterdir()):
        if entry.is_symlink() or entry.is_file():
            entry.unlink()
        elif entry.is_dir():
            remove_sandbox(entry)
    try:
        sandbox_dir.rmdir()
    except OSError:
        shutil.rmtree(sandbox_dir, ignore_errors=True)


LINUX_FICLONE = 0x40049409
DARWIN_CLONE_NOFOLLOW = 0x0001
SANDBOX_TRASH_STALE_SECONDS = 600
_darwin_libc = []


def darwin_clone(source, target):
    """clonefile(2): copy-on-write clone of a file or a whole directory tree on APFS."""
    if sys.platform != 'darwin':
        return False
    try:
        if not _darwin_libc:
            import ctypes
            _darwin_libc.append(ctypes.CDLL(None, use_errno=True))
        return _darwin_libc[0].clonefile(os.fsencode(str(source)), os.fsencode(str(target)), DARWIN_CLONE_NOFOLLOW) == 0
    except (OSError, AttributeError):
        return False


def clone_file(source, target):
    """Copy `source` to `target` without sharing storage, so writes in the sandbox never reach
    the workspace. Copy-on-write clones keep this cheap on APFS, Btrfs and XFS."""
    source, target = str(source), str(target)
    if darwin_clone(source, target):
        return
    if sys.platform.startswith('linux'):
        try:
            import fcntl
            with open(source, 'rb') as src, open(target, 'wb') as dst:
                fcntl.ioctl(dst.fileno(), LINUX_FICLONE, src.fileno())
            shutil.copystat(source, target)
            return
        except (OSError, ImportError):
            if os.path.lexists(target):
                os.unlink(target)
    shutil.copy2(source, target)


def clone_tree(source, target):
    """Clone a directory without sharing storage: one clonefile() call on APFS, otherwise a
    per-file copy that still uses reflinks where the filesystem supports them."""
    if darwin_clone(source, target):
        return
    if os.path.lexists(str(target)):
        shutil.rmtree(str(target), ignore_errors=True)
    shutil.copytree(str(source), str(target), symlinks=True, copy_function=clone_file)


def delete_detached(path):
    """Delete `path` in the background without holding the caller's stdout/stderr pipes open."""
    path = str(path)
    if not hasattr(os, 'fork'):
        try:
            subprocess.Popen([sys.executable, '-c', 'import shutil, sys; shutil.rmtree(sys.argv[1], ignore_errors=True)', path],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             creationflags=subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP)
        except OSError:
            remove_sandbox(path)
        return
    # Double fork: the grandchild is reparented to init, so nothing is left to reap.
    try:
        child = os.fork()
    except OSError:
        remove_sandbox(path)
        return
    if child:
        os.waitpid(child, 0)
        return
    try:
        os.setsid()
        if os.fork() == 0:
            devnull = os.open(os.devnull, os.O_RDWR)
            for fd in (0, 1, 2):
                os.dup2(devnull, fd)
            os.closerange(3, 1024)
            shutil.rmtree(path, ignore_errors=True)
    finally:
        os._exit(0)


def discard_sandbox(sandbox_dir):
    """Move the sandbox aside, then delete it in a detached process: unlinking a cloned
    node_modules can take several seconds."""
    sandbox_dir = Path(sandbox_dir)
    for leftover in sandbox_dir.parent.glob('.sandbox-trash-*'):
        # Fresh trash still has a deleter running; only retry trash whose deleter died.
        try:
            if time.time() - leftover.stat().st_mtime < SANDBOX_TRASH_STALE_SECONDS:
                continue
            os.utime(str(leftover))
        except OSError:
            continue
        delete_detached(leftover)
    if not os.path.lexists(str(sandbox_dir)):
        return
    trash = sandbox_dir.with_name('.sandbox-trash-' + uuid.uuid4().hex)
    try:
        os.rename(str(sandbox_dir), str(trash))
        os.utime(str(trash))
    except OSError:
        remove_sandbox(sandbox_dir)
        return
    delete_detached(trash)


def rmtree_ignoring_races(path):
    def ignore_missing(function, failed, info):
        if not isinstance(info[1], FileNotFoundError):
            raise info[1]
    shutil.rmtree(str(path), onerror=ignore_missing)


def sandbox_link_target(link, workspace, sandbox_dir):
    target = os.readlink(str(link))
    if os.path.isabs(target):
        try:
            return str(sandbox_dir / Path(target).relative_to(workspace))
        except ValueError:
            pass
    return target


def materialize_sandbox(session, sandbox_dir=None):
    sandbox_dir = Path(sandbox_dir) if sandbox_dir is not None else (session.directory / '.sandbox')
    discard_sandbox(sandbox_dir)
    sandbox_dir.mkdir(parents=True, exist_ok=True)

    staged_files = session.files(fresh=True)
    deleted_rels = set(session.deletions)
    rename_sources = {old for dst, old in session.manifest.items() if dst != '_deletions' and old != dst}
    omitted_ws_files = set(staged_files.keys()) | deleted_rels | rename_sources

    touched_dir_prefixes = set()
    for rel in (set(staged_files.keys()) | deleted_rels | rename_sources):
        for parent in Path(rel).parents:
            if str(parent) != '.':
                touched_dir_prefixes.add(parent.as_posix())

    workspace = session.workspace.resolve()
    for root, dirs, files in os.walk(workspace, topdown=True, followlinks=False):
        root_path = Path(root)
        rel_root = root_path.relative_to(workspace)
        rel_root_posix = '' if str(rel_root) == '.' else rel_root.as_posix()

        kept_dirs = []
        for d in dirs:
            if d.lower() == '.git':
                continue
            dir_rel_posix = (rel_root_posix + '/' + d) if rel_root_posix else d
            ws_subdir = root_path / d
            sb_subdir = sandbox_dir / dir_rel_posix

            if ws_subdir.is_symlink():
                sb_subdir.parent.mkdir(parents=True, exist_ok=True)
                os.symlink(sandbox_link_target(ws_subdir, workspace, sandbox_dir), str(sb_subdir))
                continue

            if d in HEAVY_CLONE_DIRS and dir_rel_posix not in touched_dir_prefixes:
                sb_subdir.parent.mkdir(parents=True, exist_ok=True)
                clone_tree(ws_subdir, sb_subdir)
                continue

            kept_dirs.append(d)
        dirs[:] = kept_dirs

        for fname in files:
            file_rel_posix = (rel_root_posix + '/' + fname) if rel_root_posix else fname
            if file_rel_posix in omitted_ws_files:
                continue
            ws_file = root_path / fname
            sb_file = sandbox_dir / file_rel_posix
            sb_file.parent.mkdir(parents=True, exist_ok=True)
            if ws_file.is_symlink():
                os.symlink(sandbox_link_target(ws_file, workspace, sandbox_dir), str(sb_file))
            else:
                clone_file(ws_file, sb_file)

    for rel, staged_path in staged_files.items():
        sb_target = sandbox_dir / rel
        sb_target.parent.mkdir(parents=True, exist_ok=True)
        if sb_target.exists() or sb_target.is_symlink():
            sb_target.unlink()
        shutil.copy2(str(staged_path), str(sb_target))

    return sandbox_dir


def tool_env(root, cwd):
    """Environment for a command in a sandbox `root`: local bins from `cwd` up to `root` first."""
    env = os.environ.copy()
    py_existing = env.get('PYTHONPATH', '')
    env['PYTHONPATH'] = os.pathsep.join([str(root)] + ([py_existing] if py_existing else []))
    node_modules = root / 'node_modules'
    if node_modules.exists():
        node_existing = env.get('NODE_PATH', '')
        env['NODE_PATH'] = os.pathsep.join([str(node_modules)] + ([node_existing] if node_existing else []))
    bin_dir = 'Scripts' if os.name == 'nt' else 'bin'
    extra_bins = []
    directory = cwd
    while True:
        for candidate in (directory / 'node_modules' / '.bin', directory / '.venv' / bin_dir, directory / 'venv' / bin_dir):
            if candidate.exists():
                extra_bins.append(str(candidate))
        if directory == root:
            break
        directory = directory.parent
    if extra_bins:
        env['PATH'] = os.pathsep.join(extra_bins + [env.get('PATH', '')])
    return env


def run_tool(cmd, cwd, env):
    try:
        proc = subprocess.run(cmd, cwd=str(cwd), env=env, capture_output=True, text=True, errors='replace')
        return proc.returncode, proc.stdout or '', proc.stderr or ''
    except OSError as exc:
        return 127, '', str(exc) + '\n'


def exec_cwd(root, rel):
    if not rel:
        return root
    cwd = safe_path(root, rel)
    if not cwd.is_dir():
        raise StagedError('--cwd must be an existing directory in the sandbox: ' + rel)
    return cwd


def staging_snapshot(session):
    """Non-entry files, symlinks and directories in staging/."""
    entries = session.sandbox_entries()
    items, directories = set(), set()
    for root, dirs, files in os.walk(session.staging, followlinks=False):
        base = Path(root)
        kept = []
        for name in dirs:
            rel = (base / name).relative_to(session.staging).as_posix()
            if rel in entries:
                continue
            if (base / name).is_symlink():
                items.add(rel)
            else:
                directories.add(rel)
                kept.append(name)
        dirs[:] = kept
        items.update(rel for rel in ((base / name).relative_to(session.staging).as_posix() for name in files)
                     if rel not in entries)
    return items, directories


def run_in_staging(session, cmd, cwd_rel=None, sync_back=False):
    """Run directly in staging/ with only the sandbox entries the agent set up. Afterwards,
    files the command created are discarded and proposal edits are reverted unless synced."""
    cwd = exec_cwd(session.staging, cwd_rel)
    proposals = session.files(fresh=True)
    _, directories_before = staging_snapshot(session)
    backup = session.directory / ('.exec-backup-' + uuid.uuid4().hex)
    versions = {}
    synced, reverted, discarded = [], [], []
    try:
        for rel, path in proposals.items():
            (backup / rel).parent.mkdir(parents=True, exist_ok=True)
            clone_file(path, backup / rel)
            versions[rel] = file_version(path)
        returncode, raw_stdout, raw_stderr = run_tool(cmd, cwd, tool_env(session.staging, cwd))
        items_after, directories_after = staging_snapshot(session)
        for rel in sorted(items_after - set(proposals)):
            path = session.staging / rel
            if path.is_symlink() or path.is_file():
                path.unlink()
            discarded.append(rel)
        for rel in sorted(proposals):
            path = session.staging / rel
            regular = path.is_file() and not path.is_symlink()
            if regular and (file_version(path) == versions[rel] or equal_files(path, backup / rel)):
                continue
            if regular and sync_back:
                synced.append(rel)
                continue
            if path.is_symlink() or path.is_file():
                path.unlink()
            elif path.is_dir():
                shutil.rmtree(str(path))
            copy_atomic(backup / rel, path)
            reverted.append(rel)
        for rel in sorted(directories_after - directories_before, key=lambda r: -len(Path(r).parts)):
            path = session.staging / rel
            if path.is_dir() and not path.is_symlink() and not any(path.iterdir()):
                path.rmdir()
    finally:
        shutil.rmtree(str(backup), ignore_errors=True)
    if synced or reverted or discarded:
        session.refresh_index()
    return returncode, raw_stdout, raw_stderr, {'synced': synced, 'reverted': reverted, 'discarded': discarded}


def exec_in_sandbox(ctx, session, command_args, sync_back=False, as_json=False, keep_sandbox=False):
    args = getattr(ctx, 'args', None)
    in_staging = bool(getattr(args, 'staging', False))
    cwd_rel = getattr(args, 'cwd', None)
    if args is not None:
        if not sync_back:
            sync_back = bool(getattr(args, 'sync', False))
        if not as_json:
            as_json = bool(getattr(args, 'json', False))
        if not keep_sandbox:
            keep_sandbox = bool(getattr(args, 'keep_sandbox', False))
    if in_staging and keep_sandbox:
        raise StagedError('--keep-sandbox has no effect with --staging; the command already runs in staging/.')

    if isinstance(command_args, str):
        cmd = shlex.split(command_args)
    else:
        cmd = list(command_args or [])
    if cmd and cmd[0] == '--':
        cmd = cmd[1:]
    if not cmd:
        raise StagedError('Provide a command to execute in the sandbox (e.g. staged exec -- pytest).')

    sandbox_dir = None
    if in_staging:
        returncode, raw_stdout, raw_stderr, changes = run_in_staging(session, cmd, cwd_rel, sync_back)
    else:
        staged_before = {rel: path for rel, path in session.files(fresh=True).items()}
        sandbox_dir = materialize_sandbox(session)
        changes = {'synced': []}
        try:
            cwd = exec_cwd(sandbox_dir, cwd_rel)
            returncode, raw_stdout, raw_stderr = run_tool(cmd, cwd, tool_env(sandbox_dir, cwd))
            if sync_back:
                for rel, staged_path in staged_before.items():
                    sb_file = sandbox_dir / rel
                    if sb_file.is_file() and not equal_files(sb_file, staged_path):
                        copy_atomic(sb_file, staged_path)
                        changes['synced'].append(rel)
                if changes['synced']:
                    session.refresh_index()
        finally:
            if not keep_sandbox:
                discard_sandbox(sandbox_dir)

    clean_stdout = rewrite_diagnostic_paths(raw_stdout, session, sandbox_dir=sandbox_dir)
    clean_stderr = rewrite_diagnostic_paths(raw_stderr, session, sandbox_dir=sandbox_dir)
    result = {
        'ok': returncode == 0,
        'returncode': returncode,
        'command': cmd,
        'stdout': clean_stdout,
        'stderr': clean_stderr,
        'sandbox': str(sandbox_dir) if keep_sandbox else None,
    }
    result.update(changes)

    if as_json:
        print(json.dumps(result))
    else:
        if clean_stdout:
            sys.stdout.write(clean_stdout)
            if not clean_stdout.endswith('\n'):
                sys.stdout.write('\n')
        if clean_stderr:
            sys.stderr.write(clean_stderr)
            if not clean_stderr.endswith('\n'):
                sys.stderr.write('\n')
        for key, label in (('reverted', 'Reverted proposal edits (pass --sync to keep)'),
                           ('discarded', 'Discarded files created in staging/')):
            if changes.get(key):
                sys.stderr.write('{}: {}\n'.format(label, ', '.join(changes[key])))

    return result


# ---------------------------------------------------------------------------
# 5. Persistent Sandbox Entries (`staged sandbox`)
# ---------------------------------------------------------------------------
# Entries live inside staging/ at the workspace-relative path they mirror, so tools that
# walk up from a staged file (editors, tsc, vite) find packages and configs where they
# expect them. The record keeps them out of proposals, diffs and apply.

SANDBOX_RECORD = '.sandbox-entries.json'


def save_sandbox_entries(session, entries):
    record = session.directory / SANDBOX_RECORD
    if entries:
        save_json(record, {'entries': dict(sorted(entries.items()))})
    elif record.exists():
        record.unlink()


def new_sandbox_path(session, rel):
    if rel in session.sandbox_entries():
        raise StagedError('{} is already a sandbox entry; remove it first.'.format(rel))
    path = safe_path(session.staging, rel, allow_link=True)
    if os.path.lexists(str(path)):
        raise StagedError('{} already exists in staging; sandbox entries never replace proposals.'.format(rel))
    return path


def add_sandbox_link(session, rel, target=None):
    path = new_sandbox_path(session, rel)
    source = Path(os.path.expanduser(target or rel))
    if not source.is_absolute():
        source = session.workspace / source
    if not source.exists():
        raise StagedError('Link target does not exist: {}'.format(source))
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.symlink(str(source), str(path), target_is_directory=source.is_dir())
    except OSError as exc:
        raise StagedError('Could not link {}: {}'.format(rel, exc))
    entries = session.sandbox_entries()
    entries[rel] = {'kind': 'link', 'target': str(source)}
    save_sandbox_entries(session, entries)


def register_sandbox_file(session, rel):
    # Record before the file appears: an unrecorded file in staging/ would read as a proposal.
    entries = session.sandbox_entries()
    if not any(p in entries for p in [rel] + [q.as_posix() for q in Path(rel).parents]):
        entries[rel] = {'kind': 'file'}
        save_sandbox_entries(session, entries)


def add_sandbox_copy(session, rel, source=None):
    """Clone a workspace file or directory into staging/ as an isolated, writable entry."""
    path = new_sandbox_path(session, rel)
    origin = Path(os.path.expanduser(source or rel))
    if not origin.is_absolute():
        origin = session.workspace / origin
    if not origin.exists():
        raise StagedError('Copy source does not exist: {}'.format(origin))
    entries = session.sandbox_entries()
    entries[rel] = {'kind': 'copy', 'source': str(origin)}
    save_sandbox_entries(session, entries)
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        if origin.is_dir():
            clone_tree(origin, path)
            anchor_escaping_links(path, origin)
        else:
            clone_file(origin, path)
    except (OSError, shutil.Error):
        remove_sandbox_entries(session, [rel])
        raise


def anchor_escaping_links(clone, origin):
    """Relative symlinks that leave the cloned tree (pnpm workspace packages, for example) would
    point into staging/ where their targets do not exist; repoint them at the real targets."""
    origin_root = os.path.realpath(str(origin))
    for directory, dirs, files in os.walk(str(clone)):
        source_dir = os.path.join(origin_root, os.path.relpath(directory, str(clone)))
        for name in dirs + files:
            link = os.path.join(directory, name)
            if not os.path.islink(link):
                continue
            target = os.readlink(link)
            if os.path.isabs(target):
                continue
            resolved = os.path.normpath(os.path.join(source_dir, target))
            if resolved != origin_root and not resolved.startswith(origin_root + os.sep):
                os.unlink(link)
                os.symlink(resolved, link)


def write_sandbox_file(session, rel, data):
    path = range_path(session, rel, writable=True, sandbox=True)
    register_sandbox_file(session, rel)
    write_bytes_atomic(path, data)


def sandbox_operation(session, args):
    rel = (getattr(args, 'to', None) or args.file) if args.command == 'copy' else args.file
    if args.command == 'delete':
        remove_sandbox_entries(session, [args.file])
        message = 'Removed sandbox entry: '
    elif args.command == 'link':
        add_sandbox_link(session, args.file, args.target)
        message = 'Linked sandbox entry: '
    elif args.command == 'copy':
        add_sandbox_copy(session, rel, args.file)
        message = 'Cloned sandbox entry: '
    else:
        if range_path(session, args.file, writable=True, sandbox=True).exists():
            raise StagedError('Sandbox file already exists; use write --sandbox to edit it: ' + args.file)
        if args.stdin and sys.stdin.isatty():
            raise StagedError('--stdin requires piped or redirected input; use --text for inline content.')
        write_sandbox_file(session, args.file, sys.stdin.buffer.read() if args.stdin else (args.text or '').encode('utf-8'))
        message = 'Created sandbox file: '
    if args.json:
        result = {'operation': args.command, 'path': rel, 'sandbox': True}
        entry = session.sandbox_entries().get(rel)
        if entry:
            result.update(entry)
        print(json.dumps(result))
    else:
        print(message + rel)


def remove_sandbox_entries(session, rels=None):
    entries = session.sandbox_entries()
    targets = sorted(entries) if rels is None else list(rels)
    unknown = [rel for rel in targets if rel not in entries]
    if unknown:
        raise StagedError('Not a sandbox entry: {}'.format(', '.join(unknown)))
    for rel in targets:
        path = session.staging / rel
        # Unlink links; never follow them into the workspace. Copies are removed in full.
        if path.is_symlink() or path.is_file():
            path.unlink()
        elif path.is_dir():
            rmtree_ignoring_races(path)
        parent = path.parent
        while parent != session.staging and parent.is_dir() and not any(parent.iterdir()):
            parent.rmdir()
            parent = parent.parent
        entries.pop(rel)
    save_sandbox_entries(session, entries)
    return targets


def sandbox_tsconfig(session, rel, source):
    depth = len(Path(rel).parts) - 1
    config = {
        'extends': str(source),
        'compilerOptions': {
            'noEmit': True,
            # Relative, so it matches however an editor reaches the session (e.g. /tmp vs /private/tmp).
            'rootDirs': ['/'.join(['..'] * depth) or '.', str(session.workspace)],
        },
        'include': ['**/*'],
        'exclude': ['**/node_modules'],
    }
    return (json.dumps(config, indent=2) + '\n').encode('utf-8')


def auto_sandbox(session, clone=False):
    """Link (or, with `clone`, copy-on-write clone) each workspace node_modules above a staged file,
    and wrap the nearest tsconfig.json or jsconfig.json so unstaged relative imports resolve."""
    directories = set()
    nearest_configs = set()
    for rel in session.files(fresh=True):
        parents = list(Path(rel).parents)
        directories.update(parents)
        for parent in parents:
            name = next((n for n in ('tsconfig.json', 'jsconfig.json') if (session.workspace / parent / n).is_file()), None)
            if name:
                nearest_configs.add((parent / name).as_posix())
                break
    created = []
    for parent in sorted(directories):
        rel = (parent / 'node_modules').as_posix()
        if (session.workspace / rel).is_dir() and not os.path.lexists(str(session.staging / rel)):
            (add_sandbox_copy if clone else add_sandbox_link)(session, rel)
            created.append(rel)
    for rel in sorted(nearest_configs):
        # A staged config is a proposal and already sits at the right place.
        if not os.path.lexists(str(session.staging / rel)):
            write_sandbox_file(session, rel, sandbox_tsconfig(session, rel, session.workspace / rel))
            created.append(rel)
    return created


def handle_sandbox(session, args):
    changed = []
    if args.clone and not args.auto:
        raise StagedError('--clone requires --auto; use staged copy --sandbox -f <path> for a single clone.')
    if args.auto:
        changed = auto_sandbox(session, clone=args.clone)
    elif args.clear:
        changed = remove_sandbox_entries(session)
    entries = session.sandbox_entries()
    if args.json:
        result = {'session': session.id, 'staging': str(session.staging),
                  'entries': [dict(path=rel, **entry) for rel, entry in sorted(entries.items())]}
        if args.auto or args.clear:
            result['removed' if args.clear else 'changed'] = changed
        print(json.dumps(result))
        return
    if args.clear:
        print('Removed: {}'.format(', '.join(changed)) if changed else 'No sandbox entries to remove.')
        return
    if args.auto and not changed:
        print('Nothing new to link for the staged files.')
    if not entries:
        print('No sandbox entries. Add them with staged sandbox --auto, link --sandbox, or write --sandbox.')
        return
    print('Sandbox entries in {} (not part of the diff):'.format(session.staging))
    for rel, entry in sorted(entries.items()):
        marker = '+' if rel in changed else ' '
        detail = {'link': ' -> ' + entry.get('target', ''), 'copy': ' (clone of {})'.format(entry.get('source', ''))}
        print(' {} {}'.format(marker, rel) + detail.get(entry['kind'], ''))


# ===========================================================================
# 2-Pane Interactive Diff TUI & Inline Code-Selection Feedback Engine
# ===========================================================================

FEEDBACK_FILENAME = 'feedback.json'
FEEDBACK_VERSION = 1
VALID_SIDES = ('staged', 'workspace')
VALID_STATUSES = ('open', 'resolved')


def feedback_path(session):
    """Return validated path to `<session>/feedback.json`."""
    return safe_path(session.directory, FEEDBACK_FILENAME)


def _validate_comment_item(item):
    if not isinstance(item, dict):
        raise StagedError('Each feedback comment must be a JSON object.')
    for req in ('id', 'file', 'side', 'start_line', 'end_line', 'selected_text', 'comment', 'status'):
        if req not in item:
            raise StagedError('Feedback comment missing required field: {}'.format(req))
    if not isinstance(item['id'], str) or not item['id']:
        raise StagedError('Feedback comment id must be a non-empty string.')
    if not isinstance(item['file'], str) or not item['file']:
        raise StagedError('Feedback comment file must be a non-empty string.')
    if item['side'] not in VALID_SIDES:
        raise StagedError('Feedback comment side must be one of {}.'.format(', '.join(VALID_SIDES)))
    if not isinstance(item['start_line'], int) or item['start_line'] < 1:
        raise StagedError('Feedback comment start_line must be a positive integer.')
    if not isinstance(item['end_line'], int) or item['end_line'] < item['start_line']:
        raise StagedError('Feedback comment end_line must be >= start_line.')
    if not isinstance(item['selected_text'], str):
        raise StagedError('Feedback comment selected_text must be a string.')
    if item.get('snippet_focus') is not None and not isinstance(item['snippet_focus'], str):
        raise StagedError('Feedback comment snippet_focus must be a string or null.')
    if not isinstance(item['comment'], str) or not item['comment'].strip():
        raise StagedError('Feedback comment text must be a non-empty string.')
    if item['status'] not in VALID_STATUSES:
        raise StagedError('Feedback comment status must be one of {}.'.format(', '.join(VALID_STATUSES)))
    return {
        'id': item['id'],
        'file': item['file'],
        'side': item['side'],
        'start_line': item['start_line'],
        'end_line': item['end_line'],
        'selected_text': item['selected_text'],
        'snippet_focus': item.get('snippet_focus') or '',
        'comment': item['comment'],
        'status': item['status'],
        'created_at': float(item.get('created_at', 0.0)),
    }


def load_feedback(session):
    """Load and validate `<session>/feedback.json`."""
    path = feedback_path(session)
    data = load_json(path)
    if not data:
        return {'version': FEEDBACK_VERSION, 'comments': []}
    version = data.get('version', FEEDBACK_VERSION)
    if version != FEEDBACK_VERSION:
        raise StagedError('Unsupported feedback.json version: {!r}'.format(version))
    comments_raw = data.get('comments', [])
    if not isinstance(comments_raw, list):
        raise StagedError('feedback.json "comments" must be a list.')
    comments = [_validate_comment_item(c) for c in comments_raw]
    return {'version': FEEDBACK_VERSION, 'comments': comments}


def save_feedback(session, data):
    """Validate and save `<session>/feedback.json` atomically."""
    if not isinstance(data, dict):
        raise StagedError('Feedback payload must be a JSON object.')
    comments = [_validate_comment_item(c) for c in data.get('comments', [])]
    payload = {'version': FEEDBACK_VERSION, 'comments': comments}
    save_json(feedback_path(session), payload)
    return payload


def _next_comment_id(comments):
    max_num = 0
    for item in comments:
        m = re.fullmatch(r'fb-(\d+)', str(item.get('id', '')))
        if m:
            max_num = max(max_num, int(m.group(1)))
    return 'fb-{}'.format(max_num + 1)


def read_side_lines(session, rel_path, side='staged'):
    """Read 1-indexed lines for `rel_path` from either `staged` or `workspace`."""
    if side not in VALID_SIDES:
        raise StagedError('Invalid side {!r}; expected staged or workspace.'.format(side))
    if side == 'staged':
        if rel_path in getattr(session, 'deletions', []):
            return []
        target = safe_path(session.staging, rel_path)
    else:
        target = session.original(rel_path) if hasattr(session, 'original') else safe_path(session.workspace, rel_path)
    if not target.is_file():
        return []
    try:
        text = target.read_text(encoding='utf-8', errors='replace')
    except OSError as exc:
        raise StagedError('Cannot read {}: {}'.format(target, exc))
    return text.splitlines()


def extract_lines_text(session, rel_path, start_line, end_line=None, side='staged'):
    """Extract exact lines [start_line..end_line] (1-based inclusive) from staged or workspace file."""
    end_line = start_line if end_line is None else end_line
    if start_line < 1 or end_line < start_line:
        raise StagedError('Invalid line range: {}-{}'.format(start_line, end_line))
    lines = read_side_lines(session, rel_path, side=side)
    if not lines:
        target_label = 'staged' if side == 'staged' else 'workspace'
        raise StagedError('No {} file content available for {}'.format(target_label, rel_path))
    if start_line > len(lines) or end_line > len(lines):
        raise StagedError(
            'Line range L{}-L{} is out of bounds for {} ({} lines on {} side).'.format(
                start_line, end_line, rel_path, len(lines), side
            )
        )
    return '\n'.join(lines[start_line - 1:end_line])


def add_feedback_comment(
    session,
    file_path,
    comment,
    start_line=1,
    end_line=None,
    side='staged',
    snippet_focus=None,
    selected_text=None,
    created_at=None,
):
    """Create and persist a new inline code-selection feedback comment."""
    safe_path(session.staging, file_path)
    if side not in VALID_SIDES:
        raise StagedError('Invalid side {!r}; choose staged or workspace.'.format(side))
    if not isinstance(comment, str) or not comment.strip():
        raise StagedError('Feedback comment cannot be empty.')
    start_line = int(start_line)
    end_line = int(start_line if end_line is None else end_line)
    if start_line < 1 or end_line < start_line:
        raise StagedError('Invalid line range: L{}-L{}.'.format(start_line, end_line))

    if selected_text is None:
        selected_text = extract_lines_text(session, file_path, start_line, end_line, side=side)

    focus = (snippet_focus or '').strip()
    if focus and focus not in selected_text:
        raise StagedError(
            'Selected substring {!r} was not found in {} L{}-L{}.'.format(
                focus, file_path, start_line, end_line
            )
        )

    data = load_feedback(session)
    new_item = _validate_comment_item({
        'id': _next_comment_id(data['comments']),
        'file': file_path,
        'side': side,
        'start_line': start_line,
        'end_line': end_line,
        'selected_text': selected_text,
        'snippet_focus': focus,
        'comment': comment.strip(),
        'status': 'open',
        'created_at': float(time.time() if created_at is None else created_at),
    })
    data['comments'].append(new_item)
    save_feedback(session, data)
    return new_item


def resolve_feedback(session, comment_id=None, resolve_all=False, toggle=False):
    """Mark one or all feedback comments as resolved (or toggle status when toggle=True)."""
    data = load_feedback(session)
    updated = []
    if resolve_all:
        for item in data['comments']:
            if item['status'] != 'resolved':
                item['status'] = 'resolved'
                updated.append(item)
    elif comment_id:
        for item in data['comments']:
            if item['id'] == comment_id:
                if toggle:
                    item['status'] = 'open' if item['status'] == 'resolved' else 'resolved'
                else:
                    item['status'] = 'resolved'
                updated.append(item)
                break
        if not updated:
            raise StagedError('Unknown feedback comment ID: {}'.format(comment_id))
    else:
        raise StagedError('Specify a comment ID or --resolve-all.')
    save_feedback(session, data)
    return updated


def delete_feedback(session, comment_id=None, clear_all=False):
    """Delete a single feedback comment by ID or clear all comments in the session."""
    data = load_feedback(session)
    if clear_all:
        removed = list(data['comments'])
        data['comments'] = []
        save_feedback(session, data)
        return removed
    if not comment_id:
        raise StagedError('Specify a comment ID to delete or --clear.')
    kept = []
    removed = []
    for item in data['comments']:
        if item['id'] == comment_id:
            removed.append(item)
        else:
            kept.append(item)
    if not removed:
        raise StagedError('Unknown feedback comment ID: {}'.format(comment_id))
    data['comments'] = kept
    save_feedback(session, data)
    return removed


def format_line_range(start_line, end_line):
    return 'L{}'.format(start_line) if start_line == end_line else 'L{}-L{}'.format(start_line, end_line)


def format_feedback_human(session, file_filter=None, only_open=False):
    """Render human- and agent-readable review feedback grouped by file."""
    data = load_feedback(session)
    comments = data['comments']
    if file_filter is not None:
        comments = [c for c in comments if c['file'] == file_filter]
    if only_open:
        comments = [c for c in comments if c['status'] == 'open']
    if not comments:
        return 'No review feedback comments{}.'.format(
            ' for {}'.format(file_filter) if file_filter else ' in session {}'.format(session.id)
        )

    open_count = sum(1 for c in comments if c['status'] == 'open')
    resolved_count = sum(1 for c in comments if c['status'] == 'resolved')
    lines = [
        'Session {} Feedback ({} open, {} resolved)'.format(session.id, open_count, resolved_count),
    ]
    by_file = {}
    for c in comments:
        by_file.setdefault(c['file'], []).append(c)

    for rel in sorted(by_file):
        lines.append('')
        lines.append('File: {}'.format(rel))
        for item in sorted(by_file[rel], key=lambda x: (x['start_line'], x['end_line'], x['id'])):
            badge = '[OPEN]' if item['status'] == 'open' else '[RESOLVED]'
            rng = format_line_range(item['start_line'], item['end_line'])
            header = '  {} {} ({} {})'.format(item['id'], badge, item['side'], rng)
            if item.get('snippet_focus'):
                header += ' focus: `{}`'.format(item['snippet_focus'])
            lines.append(header)
            for code_line in item['selected_text'].splitlines():
                lines.append('    | {}'.format(code_line))
            lines.append('    -> {}'.format(item['comment']))
    return '\n'.join(lines)


def format_feedback_prompt(session, only_open=True, file_filter=None):
    """Generate a copy-pasteable Markdown prompt tailored for AI coding agents."""
    data = load_feedback(session)
    comments = data['comments']
    if file_filter is not None:
        comments = [c for c in comments if c['file'] == file_filter]
    if only_open:
        comments = [c for c in comments if c['status'] == 'open']

    lines = [
        '# Code Review Feedback for staged session `{}`'.format(session.id),
        '',
        'Workspace: `{}`'.format(session.workspace),
    ]
    if not comments:
        lines.append('')
        lines.append('No open review feedback comments.')
        return '\n'.join(lines)

    lines.extend([
        'Open comments: {}'.format(len(comments)),
        '',
        'Please address the following inline code review comments in the staged session `{}`:'.format(session.id),
    ])

    by_file = {}
    for c in comments:
        by_file.setdefault(c['file'], []).append(c)

    for rel in sorted(by_file):
        lines.append('')
        lines.append('## `{}`'.format(rel))
        for item in sorted(by_file[rel], key=lambda x: (x['start_line'], x['end_line'], x['id'])):
            rng = format_line_range(item['start_line'], item['end_line'])
            lines.append('')
            lines.append('### `{}` — `{}` ({} side, status: `{}`)'.format(
                item['id'], rng, item['side'], item['status']
            ))
            if item.get('snippet_focus'):
                lines.append('- **Focused expression**: `{}`'.format(item['snippet_focus']))
            lines.append('```')
            lines.append(item['selected_text'])
            lines.append('```')
            lines.append('**Reviewer Comment**: {}'.format(item['comment']))

    lines.extend([
        '',
        '---',
        'After updating the staged files (`staged write -s {} -f <file> ...`), '
        'mark addressed comments resolved with `staged feedback -s {} --resolve <id>`.'.format(
            session.id, session.id
        ),
    ])
    return '\n'.join(lines)


def copy_to_clipboard(text, runner=None):
    """Copy `text` to the system clipboard using available platform tools."""
    run_fn = runner or subprocess.run
    candidates = [
        (['pbcopy'], 'pbcopy'),
        (['wl-copy'], 'wl-copy'),
        (['xclip', '-selection', 'clipboard'], 'xclip'),
        (['xsel', '--clipboard', '--input'], 'xsel'),
        (['clip'], 'clip'),
    ]
    for cmd, label in candidates:
        if runner is not None or shutil.which(cmd[0]):
            try:
                res = run_fn(cmd, input=text, text=True, capture_output=True)
                if getattr(res, 'returncode', 1) == 0:
                    return True, label
            except OSError:
                continue
    return False, None


def configure_feedback_parser(parser):
    """Configure argparse options on the `staged feedback` subparser."""
    parser.add_argument('-f', '--file', help='filter feedback or target file for --add')
    parser.add_argument('--json', action='store_true', help='output structured JSON feedback')
    parser.add_argument('--prompt', action='store_true', help='format open feedback as a Markdown prompt for AI agents')
    parser.add_argument('--copy', action='store_true', help='copy the formatted agent prompt to system clipboard')
    parser.add_argument('--all-comments', action='store_true', help='include resolved comments in --prompt output')

    parser.add_argument('--add', action='store_true', help='add a new inline code review comment')
    parser.add_argument('--start-line', type=positive, help='one-based first line for --add')
    parser.add_argument('--end-line', type=positive, help='one-based inclusive last line for --add (default: --start-line)')
    parser.add_argument('--side', choices=list(VALID_SIDES), default='staged',
                        help='target side for --add (default: staged)')
    parser.add_argument('--select', dest='snippet_focus', help='specific substring/token within the line range to highlight')
    parser.add_argument('-m', '--message', help='review comment text for --add')
    parser.add_argument('--stdin', action='store_true', help='read review comment text from standard input')

    parser.add_argument('--resolve', metavar='ID', help='mark a feedback comment ID as resolved')
    parser.add_argument('--resolve-all', action='store_true', help='mark all feedback comments in this session as resolved')
    parser.add_argument('--delete', metavar='ID', help='delete a feedback comment ID')
    parser.add_argument('--clear', action='store_true', help='remove all feedback comments in this session')
    return parser


def configure_tui_parser(parser):
    """Configure argparse options on the `staged tui` subparser."""
    parser.add_argument('-f', '--file', help='initial proposed file to focus in the TUI')
    return parser


def handle_feedback(ctx, session, args, clipboard_runner=None):
    """Execute the `staged feedback` command."""
    add_requested = bool(
        getattr(args, 'add', False)
        or getattr(args, 'message', None) is not None
        or getattr(args, 'stdin', False)
    )
    resolve_id = getattr(args, 'resolve', None)
    resolve_all = bool(getattr(args, 'resolve_all', False))
    delete_id = getattr(args, 'delete', None)
    clear_all = bool(getattr(args, 'clear', False))

    actions = sum([
        1 if add_requested else 0,
        1 if (resolve_id or resolve_all) else 0,
        1 if (delete_id or clear_all) else 0,
    ])
    if actions > 1:
        raise StagedError('Choose only one feedback action (--add, --resolve/--resolve-all, or --delete/--clear).')

    if add_requested:
        if not getattr(args, 'file', None):
            raise StagedError('--add requires -f/--file <file>.')
        if getattr(args, 'start_line', None) is None:
            raise StagedError('--add requires --start-line <line>.')
        comment_text = getattr(args, 'message', None)
        if getattr(args, 'stdin', False):
            if sys.stdin.isatty():
                raise StagedError('--stdin requires piped or redirected input; use -m/--message for inline text.')
            comment_text = sys.stdin.read()
        if not comment_text or not comment_text.strip():
            raise StagedError('Provide a non-empty comment with -m/--message or --stdin.')
        target_file = args.file
        available = session.paths(fresh=True)
        if target_file not in available and available:
            target_file = match_file(target_file, available)
        item = add_feedback_comment(
            session,
            file_path=target_file,
            comment=comment_text,
            start_line=args.start_line,
            end_line=getattr(args, 'end_line', None),
            side=getattr(args, 'side', 'staged') or 'staged',
            snippet_focus=getattr(args, 'snippet_focus', None),
        )
        if getattr(args, 'json', False):
            print(json.dumps(item))
        else:
            rng = format_line_range(item['start_line'], item['end_line'])
            print('Added feedback {} on {} ({} {}): {}'.format(
                item['id'], item['file'], item['side'], rng, item['comment']
            ))
        return item

    if resolve_id or resolve_all:
        updated = resolve_feedback(session, comment_id=resolve_id, resolve_all=resolve_all)
        if getattr(args, 'json', False):
            print(json.dumps({'operation': 'resolve', 'resolved': [c['id'] for c in updated], 'count': len(updated)}))
        else:
            print('Resolved {} feedback comment(s).'.format(len(updated)))
        return updated

    if delete_id or clear_all:
        removed = delete_feedback(session, comment_id=delete_id, clear_all=clear_all)
        if getattr(args, 'json', False):
            print(json.dumps({'operation': 'delete', 'deleted': [c['id'] for c in removed], 'count': len(removed)}))
        else:
            print('Deleted {} feedback comment(s).'.format(len(removed)))
        return removed

    file_filter = getattr(args, 'file', None)
    if file_filter is not None:
        data_all = load_feedback(session)
        known_paths = sorted(set(session.paths(fresh=True)) | {c['file'] for c in data_all['comments']})
        if file_filter not in known_paths and known_paths:
            file_filter = match_file(file_filter, known_paths)

    if getattr(args, 'json', False):
        data = load_feedback(session)
        comments = data['comments']
        if file_filter is not None:
            comments = [c for c in comments if c['file'] == file_filter]
        payload = {
            'session': session.id,
            'workspace': str(session.workspace),
            'version': data['version'],
            'comments': comments,
        }
        print(json.dumps(payload))
        return payload

    only_open = not getattr(args, 'all_comments', False)
    if getattr(args, 'copy', False):
        prompt_text = format_feedback_prompt(session, only_open=only_open, file_filter=file_filter)
        ok, tool_name = copy_to_clipboard(prompt_text, runner=clipboard_runner)
        if getattr(args, 'prompt', False):
