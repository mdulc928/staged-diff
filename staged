class StyledLine:
    """A frame line plus (start, length, style) spans; later spans draw over earlier ones."""

    def __init__(self, text='', style=None):
        self.text = ''
        self.spans = []
        if text:
            self.add(text, style)

    def add(self, text, style=None):
        text = str(text)
        if style and text:
            self.spans.append((len(self.text), len(text), style))
        self.text += text
        return self

    def mark(self, start, length, style):
        if length > 0 and style:
            self.spans.append((start, length, style))
        return self

    def extend(self, other):
        offset = len(self.text)
        self.text += other.text
        self.spans.extend((offset + start, length, style) for start, length, style in other.spans)
        return self

    def fit(self, width, style=None):
        out = StyledLine()
        out.text = self.text[:width].ljust(width)
        if style:
            out.spans.append((0, width, style))
        out.spans.extend((start, min(length, width - start), s) for start, length, s in self.spans if start < width)
        return out


TUI_CONTEXT_LINES = 3


def fold_unchanged_rows(rows, hunks, keep=lambda row: False, context=TUI_CONTEXT_LINES):
    """Collapse long unchanged runs into one fold row, keeping `context` lines around each hunk."""
    out = []
    i = 0
    while i < len(rows):
        if rows[i]['kind'] != 'equal':
            out.append(rows[i])
            i += 1
            continue
        j = i
        while j < len(rows) and rows[j]['kind'] == 'equal':
            j += 1
        run = rows[i:j]
        lead = 0 if i == 0 else context
        trail = 0 if j == len(rows) else context
        hidden = run[lead:len(run) - trail]
        if len(hidden) > 1 and not any(keep(row) for row in hidden):
            out.extend(run[:lead])
            out.append({'kind': 'fold', 'count': len(hidden), 'hunk_index': None, 'prefix': ' ', 'text': '',
                        'left_lineno': None, 'right_lineno': None, 'left_text': None, 'right_text': None,
                        'left_spans': [], 'right_spans': [], 'first_left': hidden[0]['left_lineno']})
            out.extend(run[len(run) - trail:])
        else:
            out.extend(run)
        i = j
    seen = set()
    for index, row in enumerate(out):
        if row.get('hunk_index') is not None and row['hunk_index'] not in seen:
            seen.add(row['hunk_index'])
            hunks[row['hunk_index']]['first_row'] = index
    return out, hunks


def _clip_path(path, width):
    return path if len(path) <= width else '…' + path[-max(1, width - 1):]


class TuiState:
    """Pure state machine and frame renderer for the 2-pane interactive diff TUI."""

    def __init__(self, session, target_file=None, ctx=None, clipboard_runner=None):
        self.session = session
        self.ctx = ctx
        self.clipboard_runner = clipboard_runner
        self.branch = get_git_branch(session.workspace) or '(detached)'
        self.has_pygments = self._pygments_available()

        self.show_sidebar = True
        self.focus_pane = 'diff'
        self.diff_mode = 'side-by-side'
        self.fold_context = True
        self.wrap_lines = True
        self.syntax_highlight = self.has_pygments
        self.panel = None  # None, 'help' or 'info'
        self.active_side = 'staged'

        self.file_index = 0
        self.cursor_row = 0
        self.scroll_offset = 0
        self.sidebar_offset = 0
        self.page_rows = 10
        self.visual_anchor_row = None
        self.token_candidates = []
        self.token_index = None

        self.input_mode = False
        self.input_buffer = ''
        self.pending_comment_meta = None
        self.pending_confirm = None

        self.status_message = 'Ready. Press ? for keys.'
        self.status_is_error = False
        self.comments_added_count = 0
        self.should_quit = False

        self.file_entries = []
        self.rows = []
        self.hunks = []
        self.feedback_data = {'version': FEEDBACK_VERSION, 'comments': []}
        self.summaries_data = {'session': '', 'files': {}}
        self.intent_data = {'text': '', 'refs': []}
        self.frame_styles = []

        self.refresh_inventory(select_file=target_file)

    @staticmethod
    def _pygments_available():
        try:
            import pygments  # noqa: F401
        except ImportError:
            return False
        return True

    @property
    def show_help(self):
        return self.panel == 'help'

    @show_help.setter
    def show_help(self, value):
        self.panel = 'help' if value else None

    # ----- data ---------------------------------------------------------

    def refresh_inventory(self, select_file=None):
        current_path = select_file or self.current_file
        self.feedback_data = load_feedback(self.session)
        try:
            self.summaries_data = self.session.summaries()
        except StagedError:
            self.summaries_data = {'session': '', 'files': {}}
        try:
            self.intent_data = self.session.intent()
        except StagedError:
            self.intent_data = {'text': '', 'refs': []}

        paths = self.session.paths(fresh=True)
        comment_counts = {}
        for c in self.feedback_data['comments']:
            if c['status'] == 'open':
                comment_counts[c['file']] = comment_counts.get(c['file'], 0) + 1

        entries = []
        for status, rel in grouped_by_status(self.session, paths, paths):
            added, removed = file_line_delta(self.session, rel)
            entries.append({
                'path': rel,
                'status': status,
                'added': added,
                'removed': removed,
                'open_comments': comment_counts.get(rel, 0),
                'summary': self.summaries_data.get('files', {}).get(rel, ''),
            })
        self.file_entries = entries

        if current_path and entries:
            for idx, entry in enumerate(entries):
                if entry['path'] == current_path:
                    self.file_index = idx
                    break
            else:
                try:
                    matched = match_file(current_path, [e['path'] for e in entries])
                    self.file_index = next(i for i, e in enumerate(entries) if e['path'] == matched)
                except StagedError:
                    self.file_index = min(self.file_index, len(entries) - 1)
        elif entries:
            self.file_index = min(self.file_index, len(entries) - 1)
        else:
            self.file_index = 0
        self.rebuild_diff_rows()

    @property
    def current_file_entry(self):
        if 0 <= self.file_index < len(self.file_entries):
            return self.file_entries[self.file_index]
        return None

    @property
    def current_file(self):
        entry = self.current_file_entry
        return entry['path'] if entry else None

    def open_comments_count(self):
        return sum(1 for c in self.feedback_data['comments'] if c['status'] == 'open')

    def file_comments(self, rel_path=None):
        rel = rel_path or self.current_file
        if not rel:
            return []
        return [c for c in self.feedback_data['comments'] if c['file'] == rel]

    def rebuild_diff_rows(self, preserve=False):
        rel = self.current_file
        anchor = None
        if preserve and self.rows and 0 <= self.cursor_row < len(self.rows):
            row = self.rows[self.cursor_row]
            anchor = (row.get('left_lineno'), row.get('right_lineno'), row.get('first_left'))
        if not rel:
            self.rows, self.hunks, self.cursor_row = [], [], 0
            return
        # Expand tabs so terminal columns match character offsets.
        orig_lines = [line.expandtabs(4) for line in read_side_lines(self.session, rel, side='workspace')]
        staged_lines = [line.expandtabs(4) for line in read_side_lines(self.session, rel, side='staged')]
        build = build_side_by_side_rows if self.diff_mode == 'side-by-side' else build_unified_rows
        self.rows, self.hunks = build(orig_lines, staged_lines)
        if self.fold_context:
            commented = {(c['side'], line) for c in self.file_comments(rel)
                         for line in range(c['start_line'], c['end_line'] + 1)}
            self.rows, self.hunks = fold_unchanged_rows(
                self.rows, self.hunks,
                keep=lambda row: ('workspace', row['left_lineno']) in commented
                or ('staged', row['right_lineno']) in commented)
        if anchor is not None:
            left, right, first_left = anchor
            for index, row in enumerate(self.rows):
                if ((left is not None and row.get('left_lineno') == left)
                        or (right is not None and row.get('right_lineno') == right)
                        or (first_left is not None and row.get('left_lineno') == first_left)):
                    self.cursor_row = index
                    break
        self.cursor_row = max(0, min(self.cursor_row, len(self.rows) - 1)) if self.rows else 0
        self._clear_token_selection()

    def _select_file(self, index):
        if not self.file_entries:
            return False
        index = max(0, min(len(self.file_entries) - 1, index))
        if index == self.file_index:
            return False
        self.file_index = index
        self.cursor_row = 0
        self.scroll_offset = 0
        self.visual_anchor_row = None
        self.rebuild_diff_rows()
        return True

    # ----- selection ----------------------------------------------------

    def _clear_token_selection(self):
        self.token_candidates = []
        self.token_index = None

    def _row_line_for_side(self, row, side=None):
        side = side or self.active_side
        order = (('right', 'staged'), ('left', 'workspace'))
        if side != 'staged':
            order = order[::-1]
        for prefix, name in order:
            if row.get(prefix + '_lineno') is not None:
                return name, row[prefix + '_lineno'], row.get(prefix + '_text') or ''
        return side, 1, ''

    def current_selection_range(self):
        if not self.rows or not self.current_file:
            return (self.active_side, 1, 1, '', '')
        lo_row, hi_row = self._selected_row_bounds()
        side, _, _ = self._row_line_for_side(self.rows[lo_row], self.active_side)
        key = 'right_lineno' if side == 'staged' else 'left_lineno'
        line_numbers = [self.rows[i][key] for i in range(lo_row, hi_row + 1) if self.rows[i].get(key) is not None]
        if not line_numbers:
            _, fallback_line, _ = self._row_line_for_side(self.rows[self.cursor_row], self.active_side)
            line_numbers = [fallback_line]
        start_line, end_line = min(line_numbers), max(line_numbers)
        try:
            selected_text = extract_lines_text(self.session, self.current_file, start_line, end_line, side=side)
        except StagedError:
            _, _, selected_text = self._row_line_for_side(self.rows[self.cursor_row], side)
        snippet_focus = ''
        if self.token_index is not None and 0 <= self.token_index < len(self.token_candidates):
            candidate = self.token_candidates[self.token_index]['text']
            if candidate in selected_text:
                snippet_focus = candidate
        return (side, start_line, end_line, selected_text, snippet_focus)

    def _selected_row_bounds(self):
        if self.visual_anchor_row is None:
            return (self.cursor_row, self.cursor_row)
        return (min(self.visual_anchor_row, self.cursor_row), max(self.visual_anchor_row, self.cursor_row))

    def comments_at_row(self, row_idx):
        if not (0 <= row_idx < len(self.rows)) or not self.current_file:
            return []
        row = self.rows[row_idx]
        return [c for c in self.file_comments()
                if row.get('right_lineno' if c['side'] == 'staged' else 'left_lineno') == c['end_line']]

    def comments_covering_row(self, row_idx):
        if not (0 <= row_idx < len(self.rows)) or not self.current_file:
            return []
        row = self.rows[row_idx]
        matched = []
        for c in self.file_comments():
            lineno = row.get('right_lineno') if c['side'] == 'staged' else row.get('left_lineno')
            if lineno is not None and c['start_line'] <= lineno <= c['end_line']:
                matched.append(c)
        return matched

    def current_hunk_index(self):
        if not self.rows or not self.hunks:
            return None
        row = self.rows[self.cursor_row]
        if row.get('hunk_index') is not None:
            return row['hunk_index']
        for hunk in self.hunks:
            if hunk['first_row'] >= self.cursor_row:
                return hunk['index']
        return self.hunks[-1]['index']

    # ----- input --------------------------------------------------------

    @staticmethod
    def normalize_key(key):
        if isinstance(key, int):
            named = {}
            if curses is not None:
                for attr, name in (('KEY_DOWN', 'DOWN'), ('KEY_UP', 'UP'), ('KEY_LEFT', 'LEFT'), ('KEY_RIGHT', 'RIGHT'),
                                   ('KEY_NPAGE', 'PGDN'), ('KEY_PPAGE', 'PGUP'), ('KEY_HOME', 'HOME'),
                                   ('KEY_END', 'END'), ('KEY_BACKSPACE', 'BACKSPACE'), ('KEY_ENTER', 'ENTER'),
                                   ('KEY_RESIZE', 'RESIZE')):
                    if hasattr(curses, attr):
                        named[getattr(curses, attr)] = name
            if key in named:
                return named[key]
            if key in (127, 8):
                return 'BACKSPACE'
            if key in (10, 13):
                return 'ENTER'
            if 0 <= key < 0x110000:
                key = chr(key)
            else:
                return 'UNKNOWN'
        return {'\t': 'TAB', '\n': 'ENTER', '\r': 'ENTER', '\x1b': 'ESC', 'Escape': 'ESC', '\x7f': 'BACKSPACE',
                '\x08': 'BACKSPACE', '\x04': 'CTRL_D', '\x15': 'CTRL_U'}.get(key, key)

    def set_status(self, message, error=False):
        self.status_message = message
        self.status_is_error = error

    def handle_key(self, key):
        key = self.normalize_key(key)
        try:
            return self._dispatch_key(key)
        except (StagedError, OSError, ValueError) as exc:
            self.pending_confirm = None
            self.set_status('Error: {}'.format(exc), error=True)
            return 'error'

    def _dispatch_key(self, key):
        self.status_is_error = False
        if self.input_mode:
            return self._handle_input_key(key)
        if self.pending_confirm is not None:
            return self._handle_confirm_key(key)
        if self.panel is not None:
            if key in ('?', 'h', 'i', 'q', 'ESC'):
                if key == 'i' and self.panel == 'help':
                    self.panel = 'info'
                    return 'open_info'
                self.panel = None
                self.set_status('Closed panel.')
                return 'close_help'
            return 'help_open'

        handler = self.KEY_HANDLERS.get(key)
        if handler is None and key == 'ENTER':
            handler = TuiState._key_enter
        return handler(self, key) if handler else 'noop'

    def _key_help(self, key):
        self.panel = 'help'
        self.set_status('Key reference. Press ? or Esc to close.')
        return 'open_help'

    def _key_info(self, key):
        self.panel = 'info'
        self.set_status('Session info. Press i or Esc to close.')
        return 'open_info'

    def _key_quit(self, key):
        if key == 'ESC':
            if self.visual_anchor_row is not None or self.token_index is not None:
                self.visual_anchor_row = None
                self._clear_token_selection()
                self.set_status('Selection cleared.')
                return 'escape'
            return 'noop'
        self.should_quit = True
        return 'quit'

    def _key_sidebar(self, key):
        self.show_sidebar = not self.show_sidebar
        if not self.show_sidebar and self.focus_pane == 'files':
            self.focus_pane = 'diff'
        self.set_status('File list {}.'.format('shown' if self.show_sidebar else 'hidden'))
        return 'toggle_sidebar'

    def _key_tab(self, key):
        if not self.show_sidebar:
            self.show_sidebar = True
            self.focus_pane = 'files'
        else:
            self.focus_pane = 'files' if self.focus_pane == 'diff' else 'diff'
        self.set_status('Focused {} pane.'.format('file list' if self.focus_pane == 'files' else 'diff'))
        return 'switch_focus'

    def _key_mode(self, key):
        self.diff_mode = 'unified' if self.diff_mode == 'side-by-side' else 'side-by-side'
        self.rebuild_diff_rows(preserve=True)
        self.set_status('Switched to {} diff.'.format(self.diff_mode))
        return 'toggle_diff_mode'

    def _key_syntax(self, key):
        if not self.has_pygments:
            self.syntax_highlight = False
            self.set_status("Syntax highlighting needs pygments: pip install pygments")
            return 'syntax_unavailable'
        self.syntax_highlight = not self.syntax_highlight
        self.set_status('Syntax highlighting {}.'.format('on' if self.syntax_highlight else 'off'))
        return 'toggle_syntax'

    def _key_fold(self, key):
        self.fold_context = not self.fold_context
        self.rebuild_diff_rows(preserve=True)
        self.set_status('Unchanged lines {}.'.format('folded' if self.fold_context else 'expanded'))
        return 'toggle_fold'

    def _on_fold_row(self):
        return bool(self.rows) and self.rows[self.cursor_row]['kind'] == 'fold'

    def _key_wrap(self, key):
        self.wrap_lines = not self.wrap_lines
        self.set_status('Long lines {}.'.format('wrapped' if self.wrap_lines else 'truncated'))
        return 'toggle_wrap'

    def _key_reload(self, key):
        self.refresh_inventory()
        self.set_status('Reloaded {} file(s) from disk.'.format(len(self.file_entries)))
        return 'reload'

    def _move_cursor(self, delta):
        if self.rows:
            self.cursor_row = max(0, min(len(self.rows) - 1, self.cursor_row + delta))
            self._clear_token_selection()

    def _key_down(self, key):
        if self.focus_pane == 'files':
            self._select_file(self.file_index + 1)
        else:
            self._move_cursor(1)
        return 'down'

    def _key_up(self, key):
        if self.focus_pane == 'files':
            self._select_file(self.file_index - 1)
        else:
            self._move_cursor(-1)
        return 'up'

    def _key_page(self, key):
        step = max(1, self.page_rows // 2)
        self._move_cursor(step if key in ('CTRL_D', 'PGDN') else -step)
        return 'page'

    def _key_edge(self, key):
        if self.rows:
            self.cursor_row = 0 if key in ('g', 'HOME') else len(self.rows) - 1
            self._clear_token_selection()
        return 'top' if key in ('g', 'HOME') else 'bottom'

    def _key_file(self, key):
        step = 1 if key == 'J' else -1
        if self._select_file(self.file_index + step):
            self.set_status('File {}/{}: {}'.format(self.file_index + 1, len(self.file_entries), self.current_file))
        else:
            self.set_status('No {} file.'.format('next' if step > 0 else 'previous'))
        return 'next_file' if step > 0 else 'prev_file'

    def _key_hunk(self, key):
        if not self.hunks:
            self.set_status('No hunks in this file.')
            return 'next_hunk' if key == 'n' else 'prev_hunk'
        total = len(self.hunks)
        if key == 'n':
            target = next((h for h in self.hunks if h['first_row'] > self.cursor_row), None)
            wrapped = target is None
            target = target or self.hunks[0]
        else:
            target = next((h for h in reversed(self.hunks) if h['first_row'] < self.cursor_row), None)
            wrapped = target is None
            target = target or self.hunks[-1]
        self.cursor_row = target['first_row']
        self.focus_pane = 'diff'
        self._clear_token_selection()
        self.set_status('{}hunk {}/{}.'.format('Wrapped to ' if wrapped else '', target['index'] + 1, total).capitalize())
        return 'next_hunk' if key == 'n' else 'prev_hunk'

    def _cycle_token(self, step):
        self.token_index = (self.token_index + step) % len(self.token_candidates)
        self.set_status('Token {}/{}: `{}`  (c to comment on it)'.format(
            self.token_index + 1, len(self.token_candidates), self.token_candidates[self.token_index]['text']))

    def _key_side(self, key):
        left = key in ('[', 'LEFT')
        if self.token_candidates and self.token_index is not None:
            self._cycle_token(-1 if left else 1)
            return 'prev_token' if left else 'next_token'
        self.active_side = 'workspace' if left else 'staged'
        self._clear_token_selection()
        self.set_status('Comments target the {} side.'.format(
            'workspace (original)' if left else 'staged (proposal)'))
        return 'side_workspace' if left else 'side_staged'

    def _key_visual(self, key):
        if self.visual_anchor_row is None:
            self.visual_anchor_row = self.cursor_row
            side, s_line, e_line, _, _ = self.current_selection_range()
            self.set_status('Selecting from {} {}. Move with j/k, then c to comment.'.format(
                side, format_line_range(s_line, e_line)))
        else:
            self.visual_anchor_row = None
            self.set_status('Selection cleared.')
        return 'toggle_visual'

    def _key_token(self, key):
        if not self.rows:
            return 'noop'
        if not self.token_candidates:
            _, _, line_text = self._row_line_for_side(self.rows[self.cursor_row], self.active_side)
            self.token_candidates = extract_selectable_tokens(line_text)
            if not self.token_candidates:
                self.set_status('No selectable tokens on this line.')
                return 'no_tokens'
            self.token_index = -1
        self._cycle_token(1)
        return 'cycle_token'

    def _key_comment(self, key):
        if not self.current_file or not self.rows:
            return 'noop'
        if self._on_fold_row() and self.visual_anchor_row is None:
            return self._key_fold(key)
        side, s_line, e_line, sel_text, focus = self.current_selection_range()
        self.input_mode = True
        self.input_buffer = ''
        self.pending_comment_meta = {'file': self.current_file, 'side': side, 'start_line': s_line,
                                     'end_line': e_line, 'selected_text': sel_text, 'snippet_focus': focus}
        self.set_status('Comment on {} {} {}'.format(self.current_file, side, format_line_range(s_line, e_line)))
        return 'start_comment'

    def _key_enter(self, key):
        if self.visual_anchor_row is not None or self.token_index is not None:
            return self._key_comment(key)
        if self.focus_pane == 'files':
            self.focus_pane = 'diff'
            self.set_status('Viewing {}.'.format(self.current_file or ''))
            return 'enter_diff'
        if self._on_fold_row():
            return self._key_fold(key)
        return 'noop'

    def _comment_at_cursor(self):
        comments = self.comments_covering_row(self.cursor_row) or self.comments_at_row(self.cursor_row)
        return comments[-1] if comments else None

    def _key_resolve(self, key):
        target = self._comment_at_cursor()
        if target is None:
            self.set_status('No comment on this line.')
            return 'noop'
        updated = resolve_feedback(self.session, comment_id=target['id'], toggle=True)
        self.refresh_inventory()
        self.set_status('Marked {} as {}.'.format(target['id'], updated[0]['status'] if updated else target['status']))
        return 'toggle_resolve'

    def _key_delete_comment(self, key):
        target = self._comment_at_cursor()
        if target is None:
            self.set_status('No comment on this line to delete.')
            return 'noop'
        return self._ask('delete_comment', 'Delete comment {}?'.format(target['id']), comment_id=target['id'])

    def _key_apply(self, key):
        rel = self.current_file
        if not rel:
            return 'noop'
        drift = branch_drift_note(self.session)
        if key == 'A' or self.focus_pane == 'files' or rel in self.session.deletions:
            verb = 'Delete' if rel in self.session.deletions else 'Apply'
            return self._ask('apply_file', '{} {} in the workspace?{}'.format(verb, rel, drift), rel=rel)
        hunk_idx = self.current_hunk_index()
        if hunk_idx is None:
            self.set_status('No hunk to apply in {}.'.format(rel))
            return 'noop'
        return self._ask('apply_hunk', 'Apply hunk {}/{} of {} to the workspace?{}'.format(
            hunk_idx + 1, len(self.hunks), rel, drift), rel=rel, hunk=hunk_idx)

    def _key_yank(self, key):
        ok, tool_name = copy_to_clipboard(format_feedback_prompt(self.session, only_open=True),
                                          runner=self.clipboard_runner)
        if ok:
            self.set_status('Copied open comments as an agent prompt ({}).'.format(tool_name))
        else:
            self.set_status('No clipboard tool found; run staged feedback --prompt.', error=True)
        return 'yank_prompt'

    def _ask(self, action, question, **details):
        self.pending_confirm = dict(details, action=action, question=question)
        self.set_status(question)
        return 'confirm_' + action

    def _handle_confirm_key(self, key):
        pending, self.pending_confirm = self.pending_confirm, None
        if key not in ('y', 'Y'):
            self.set_status('Cancelled.')
            return 'cancel_confirm'
        action = pending['action']
        if action == 'delete_comment':
            delete_feedback(self.session, comment_id=pending['comment_id'])
            self.refresh_inventory()
            self.set_status('Deleted comment {}.'.format(pending['comment_id']))
        elif action == 'apply_hunk':
            apply_hunk(self.session, pending['rel'], pending['hunk'], ctx=self.ctx)
            self.refresh_inventory()
            self.set_status('Applied hunk {} of {}. Undo with staged undo.'.format(pending['hunk'] + 1, pending['rel']))
        elif action == 'apply_file':
            status = apply_file_from_tui(self.session, pending['rel'], ctx=self.ctx)
            self.refresh_inventory()
            self.set_status('{} {}. Undo with staged undo.'.format(status.capitalize(), pending['rel']))
        return action

    def _handle_input_key(self, key):
        if key == 'ESC':
            self.input_mode = False
            self.input_buffer = ''
            self.pending_comment_meta = None
            self.set_status('Comment cancelled.')
            return 'cancel_comment'
        if key == 'BACKSPACE':
            self.input_buffer = self.input_buffer[:-1]
            return 'input_backspace'
        if key == 'ENTER':
            text = self.input_buffer.strip()
            meta = self.pending_comment_meta
            self.input_mode = False
            self.input_buffer = ''
            self.pending_comment_meta = None
            if not text or not meta:
                self.set_status('Empty comment discarded.')
                return 'discard_comment'
            created = add_feedback_comment(
                self.session, file_path=meta['file'], comment=text, start_line=meta['start_line'],
                end_line=meta['end_line'], side=meta['side'], snippet_focus=meta['snippet_focus'],
                selected_text=meta['selected_text'])
            self.visual_anchor_row = None
            self._clear_token_selection()
            self.comments_added_count += 1
            self.refresh_inventory()
            self.set_status('Saved {} on {} ({}).'.format(
                created['id'], created['file'], format_line_range(created['start_line'], created['end_line'])))
            return 'save_comment'
        if isinstance(key, str) and len(key) == 1 and key.isprintable():
            self.input_buffer += key
            return 'input_char'
        return 'noop'

    KEY_HANDLERS = {
        '?': _key_help, 'h': _key_help, 'i': _key_info, 'q': _key_quit, 'ESC': _key_quit,
        'b': _key_sidebar, 'TAB': _key_tab, 'u': _key_mode, 'z': _key_fold, 'W': _key_wrap, 'H': _key_syntax, 'R': _key_reload,
        'j': _key_down, 'DOWN': _key_down, 'k': _key_up, 'UP': _key_up,
        'CTRL_D': _key_page, 'PGDN': _key_page, 'CTRL_U': _key_page, 'PGUP': _key_page,
        'g': _key_edge, 'HOME': _key_edge, 'G': _key_edge, 'END': _key_edge,
        'J': _key_file, 'K': _key_file, 'n': _key_hunk, 'p': _key_hunk,
        '[': _key_side, 'LEFT': _key_side, ']': _key_side, 'RIGHT': _key_side,
        'v': _key_visual, ' ': _key_visual, 'w': _key_token, 'c': _key_comment,
        'r': _key_resolve, 'x': _key_delete_comment, 'a': _key_apply, 'A': _key_apply, 'y': _key_yank,
    }

    # ----- rendering ----------------------------------------------------

    def _code_chunks(self, text, width, base_style, change_spans=()):
        """Split code into cells of `width`, layering syntax colors and intraline change emphasis."""
        width = max(1, width)
        syntax = []
        if self.syntax_highlight and base_style is None and text:
            syntax = [(start, end, 'syn_' + kind) for start, end, kind in _cached_syntax_spans(text, self.current_file)]
        emphasis = [(start, end, base_style + '_em') for start, end in change_spans] if base_style else []
        limit = len(text) if self.wrap_lines else min(len(text), width)
        starts = wrap_points(text, width, limit)
        cells = []
        for index, offset in enumerate(starts):
            stop = starts[index + 1] if index + 1 < len(starts) else limit
            cell = StyledLine(text[offset:stop], base_style)
            for start, end, style in syntax + emphasis:
                lo, hi = max(start, offset), min(end, stop)
                if hi > lo:
                    cell.mark(lo - offset, hi - lo, style)
            cells.append(cell.fit(width, base_style))
        return cells

    def _diff_row(self, row, width, flag):
        """Display lines for one diff row; long lines wrap onto continuation lines when wrapping is on."""
        if row['kind'] == 'fold':
            label = '{} ⋯ {} unchanged lines'.format(flag, row['count'])
            return [StyledLine(label, 'fold').add('   (Enter or z to expand)', 'fold_hint').fit(width, 'fold')]
        if self.diff_mode == 'side-by-side':
            half_w = max(10, (width - 3) // 2)
            columns = []
            for side, cell_w in (('left', half_w), ('right', width - half_w - 3)):
                lineno = row[side + '_lineno']
                if lineno is None:
                    columns.append(([StyledLine(flag).add(' ' * (cell_w - 1), 'filler')], 'filler', cell_w))
                    continue
                changed = row['kind'] != 'equal'
                style = ('del' if side == 'left' else 'add') if changed else None
                gutter_style = style + '_gutter' if changed else 'gutter'
                gutter = '{}{:4d} {} '.format(flag, lineno, ('-' if side == 'left' else '+') if changed else ' ')
                spans = row.get(side + '_spans', []) if row['kind'] == 'replace' else ()
                cells = self._code_chunks(row[side + '_text'] or '', cell_w - len(gutter), style, spans)
                lines = [StyledLine(gutter if i == 0 else ' ' * len(gutter), gutter_style).extend(cell).fit(cell_w)
                         for i, cell in enumerate(cells)]
                columns.append((lines, style or None, cell_w))
            height = max(len(lines) for lines, _, _ in columns)
            out = []
            for i in range(height):
                line = StyledLine()
                for index, (lines, style, cell_w) in enumerate(columns):
                    if i < len(lines):
                        line.extend(lines[i])
                    else:
                        line.extend(StyledLine().fit(cell_w, style))  # keep the band tinted beside wrapped text
                    if index == 0:
                        line.add(' │ ', 'border')
                out.append(line)
            return out
        style = {'delete': 'del', 'insert': 'add'}.get(row['kind'])
        l_no = '{:4d}'.format(row['left_lineno']) if row['left_lineno'] is not None else '    '
        r_no = '{:4d}'.format(row['right_lineno']) if row['right_lineno'] is not None else '    '
        gutter = '{} {} {} {} '.format(flag, l_no, r_no, row['prefix'])
        gutter_style = style + '_gutter' if style else 'gutter'
        cells = self._code_chunks(row['text'], width - len(gutter), style)
        return [StyledLine(gutter if i == 0 else ' ' * len(gutter), gutter_style).extend(cell)
                for i, cell in enumerate(cells)]

    def _sidebar_lines(self, width, height):
        marker = '▸' if self.focus_pane == 'files' else ' '
        lines = [StyledLine(' {}FILES ({})'.format(marker, len(self.file_entries)),
                            'title_focus' if self.focus_pane == 'files' else 'title').fit(width),
                 StyledLine(' ' + '─' * (width - 2), 'border').fit(width)]
        items = []
        last_status = None
        for idx, entry in enumerate(self.file_entries):
            if entry['status'] != last_status:
                items.append((None, StyledLine(' ' + (entry['status'] or 'UNKNOWN'),
                                               'status_' + (entry['status'] or 'MISSING').replace(' ', '_'))))
                last_status = entry['status']
            delta = ' +{} -{}'.format(entry['added'], entry['removed'])
            badge = ' ●{}'.format(entry['open_comments']) if entry['open_comments'] else ''
            selected = idx == self.file_index
            path_w = max(4, width - 3 - len(delta) - len(badge))
            line = StyledLine(' {} '.format('>' if selected else ' '))
            line.add(_clip_path(entry['path'], path_w).ljust(path_w), 'cursor' if selected else None)
            line.add(' +{}'.format(entry['added']), 'add' if entry['added'] else 'dim')
            line.add(' -{}'.format(entry['removed']), 'del' if entry['removed'] else 'dim')
            line.add(badge, 'comment')
            items.append((idx, line))
        avail = max(1, height - len(lines))
        selected_pos = next((i for i, (idx, _) in enumerate(items) if idx == self.file_index), 0)
        if selected_pos < self.sidebar_offset:
            self.sidebar_offset = max(0, selected_pos - 1)
        elif selected_pos >= self.sidebar_offset + avail:
            self.sidebar_offset = selected_pos - avail + 1
        self.sidebar_offset = max(0, min(self.sidebar_offset, max(0, len(items) - avail)))
        for _, line in items[self.sidebar_offset:self.sidebar_offset + avail]:
            lines.append(line.fit(width))
        return lines

    def _panel_lines(self, width, height):
        lines = []

        def heading(text):
            lines.append(StyledLine(' ' + text, 'title').fit(width))

        def wrapped(text, style=None, indent='   '):
            for paragraph in (text or '').splitlines() or ['']:
                for chunk in textwrap.wrap(paragraph, max(10, width - len(indent) - 1)) or ['']:
                    lines.append(StyledLine(indent + chunk, style).fit(width))

        if self.panel == 'help':
            heading('staged TUI Command Reference')
            lines.append(StyledLine(' ' + '─' * max(10, width - 4), 'border').fit(width))
            key_w = min(32, max(16, width // 3))
            for section_title, items in TUI_KEYS:
                heading(section_title + ':')
                for combo, desc in items:
                    lines.append(StyledLine('   ').add(combo.ljust(key_w), 'key').add(' ' + desc).fit(width))
                lines.append(StyledLine().fit(width))
            lines.append(StyledLine(' Press ? or Esc to return to the diff.', 'dim').fit(width))
            return lines[:height]

        heading('Intent')
        if self.intent_data.get('text'):
            wrapped(self.intent_data['text'], 'intent')
        else:
            wrapped('(none recorded; staged intent -m "<original request>" --ref <PR/MR URL>)', 'dim')
        for ref in self.intent_data.get('refs', []):
            lines.append(StyledLine('   ' + ref, 'ref').fit(width))
        lines.append(StyledLine().fit(width))
        heading('Session summary')
        wrapped(self.summaries_data.get('session') or '(no summary yet)',
                'summary' if self.summaries_data.get('session') else 'dim')
        lines.append(StyledLine().fit(width))
        entry = self.current_file_entry
        if entry:
            heading('File: ' + entry['path'])
            wrapped(entry['summary'] or '(no file summary)', 'summary' if entry['summary'] else 'dim')
            wrapped('Workspace: {}'.format(self.session.original(entry['path'])), 'dim')
            wrapped('Staged:    {}'.format(safe_path(self.session.staging, entry['path'])), 'dim')
            comments = self.file_comments()
            wrapped('{} hunk(s), {} comment(s), {} open'.format(
                len(self.hunks), len(comments), sum(1 for c in comments if c['status'] == 'open')), 'dim')
        lines.append(StyledLine().fit(width))
        lines.append(StyledLine(' Press i or Esc to return to the diff.', 'dim').fit(width))
        return lines[:height]

    def _diff_lines(self, width, height):
        entry = self.current_file_entry
        if not entry:
            return [StyledLine(' No staged files in session {}.'.format(self.session.id), 'dim').fit(width)]
        focus = '▸' if self.focus_pane == 'diff' else ' '
        title = StyledLine(' {}'.format(focus), 'title_focus' if self.focus_pane == 'diff' else 'title')
        title.add(entry['status'] or 'UNKNOWN', 'status_' + (entry['status'] or 'MISSING').replace(' ', '_'))
        title.add(' {} '.format(entry['path']), 'title')
        title.add('+{}'.format(entry['added']), 'add').add(' -{}'.format(entry['removed']), 'del')
        if self.hunks:
            hunk = self.current_hunk_index()
            title.add('  hunk {}/{}'.format((hunk or 0) + 1, len(self.hunks)), 'dim')
        lines = [title.fit(width)]
        summary = entry['summary'] or self.summaries_data.get('session') or ''
        lines.append(StyledLine(' ' + (summary_text(summary) if summary else '(no summary yet)'),
                                'summary' if summary else 'dim').fit(width))
        if self.diff_mode == 'side-by-side':
            half_w = max(10, (width - 3) // 2)
            header = StyledLine()
            for label, side, cell_w in (('Workspace Original', 'workspace', half_w),
                                        ('Staged Proposal', 'staged', width - half_w - 3)):
                active = self.active_side == side
                header.extend(StyledLine(' {}{}'.format(label, ' ◂ comments' if active else ''),
                                         'col_active' if active else 'col').fit(cell_w))
                if side == 'workspace':
                    header.add(' │ ', 'border')
            lines.append(header.fit(width))
        else:
            lines.append(StyledLine(' Unified Diff (comments target the {} side)'.format(self.active_side), 'col').fit(width))

        viewport = []
        lo_sel, hi_sel = self._selected_row_bounds()
        cursor_pos = cursor_end = 0
        for r_idx, row in enumerate(self.rows):
            is_cursor = r_idx == self.cursor_row
            is_selected = self.visual_anchor_row is not None and lo_sel <= r_idx <= hi_sel
            row_lines = self._diff_row(row, width, '>' if is_cursor else ('*' if is_selected else ' '))
            if is_cursor:
                cursor_pos, cursor_end = len(viewport), len(viewport) + len(row_lines) - 1
                if self.token_index is not None and 0 <= self.token_index < len(self.token_candidates):
                    tok = self.token_candidates[self.token_index]['text']
                    row_lines[0] = row_lines[0].fit(max(1, width - len(tok) - 8)).add(' [tok:{}]'.format(tok), 'key')
            for line in row_lines:
                line = line.fit(width)
                if is_selected:
                    line.mark(0, width, 'selected')
                if is_cursor:
                    line.mark(0, 1, 'cursor')
                viewport.append(line)
            for c in self.comments_at_row(r_idx):
                badge = 'OPEN' if c['status'] == 'open' else 'RESOLVED'
                focus_part = ' (focus: `{}`)'.format(c['snippet_focus']) if c.get('snippet_focus') else ''
                viewport.append(StyledLine('   💬 [{} {} {} {}]{}: {}'.format(
                    c['id'], badge, c['side'], format_line_range(c['start_line'], c['end_line']), focus_part,
                    c['comment']), 'comment' if c['status'] == 'open' else 'dim').fit(width, 'comment_bg'))

        avail = max(1, height - len(lines))
        self.page_rows = avail
        if cursor_pos < self.scroll_offset:
            self.scroll_offset = cursor_pos
        elif cursor_end >= self.scroll_offset + avail:
            self.scroll_offset = min(cursor_pos, cursor_end - avail + 1)
        self.scroll_offset = max(0, min(self.scroll_offset, max(0, len(viewport) - avail)))
        return lines + viewport[self.scroll_offset:self.scroll_offset + avail]

    def _header_line(self, width):
        line = StyledLine(' staged TUI ', 'header_title')
        mode = 'side-by-side' if self.diff_mode == 'side-by-side' else 'unified'
        line.add(' session {} · branch {} · {} file(s) · {} open comment(s) · {} '.format(
            self.session.id, self.branch, len(self.file_entries), self.open_comments_count(), mode), 'header')
        intent = summary_text(self.intent_data.get('text', '')) if self.intent_data.get('text') else ''
        if intent:
            line.add('· intent: ' + intent, 'header_dim')
        return line.fit(width, 'header')

    def _footer_line(self, width):
        if self.input_mode:
            meta = self.pending_comment_meta or {}
            label = ' Comment ({} {}{}): '.format(
                meta.get('side', 'staged'), format_line_range(meta.get('start_line', 1), meta.get('end_line', 1)),
                ' [{}]'.format(meta['snippet_focus']) if meta.get('snippet_focus') else '')
            line = StyledLine(label, 'prompt').add(self.input_buffer + '█', 'input')
            return line.add('   Enter save · Esc cancel', 'footer_dim').fit(width, 'footer')
        if self.pending_confirm is not None:
            return StyledLine(' ' + self.pending_confirm['question'] + ' [y/N]', 'prompt').fit(width, 'footer')
        line = StyledLine(' ' + self.status_message, 'error' if self.status_is_error else 'footer')
        if self.panel is None:
            hints = '  '.join('{} {}'.format(k, d) for k, d in TUI_HINTS[self.focus_pane])
            room = width - len(line.text) - 2
            if room > 20:
                hints = hints if len(hints) <= room else hints[:room - 1] + '…'
                line.add(' ' * (width - len(line.text) - len(hints) - 1)).add(hints, 'footer_dim')
        return line.fit(width, 'footer')

    def render_frame(self, width=120, height=32):
        """Return `height` lines of exactly `width` characters; styles land in `frame_styles`."""
        width = max(60, int(width))
        height = max(12, int(height))
        body_height = height - 2
        sidebar_w = min(40, max(24, width // 4)) if self.show_sidebar else 0
        main_w = width - sidebar_w - (1 if sidebar_w else 0)

        left = self._sidebar_lines(sidebar_w, body_height) if sidebar_w else []
        right = self._panel_lines(main_w, body_height) if self.panel else self._diff_lines(main_w, body_height)
        blank_left = StyledLine().fit(sidebar_w)
        blank_right = StyledLine().fit(main_w)

        styled = [self._header_line(width)]
        for i in range(body_height):
            row = StyledLine()
            if sidebar_w:
                row.extend(left[i] if i < len(left) else blank_left).add('│', 'border')
            row.extend(right[i] if i < len(right) else blank_right)
            styled.append(row.fit(width))
        styled.append(self._footer_line(width))
        self.frame_styles = [line.spans for line in styled]
        return [line.text for line in styled]


def _cached_syntax_spans(text, filename, _cache={}):
    key = (text, Path(filename or '').suffix)
    if key not in _cache:
        if len(_cache) > 4096:
            _cache.clear()
        _cache[key] = highlight_syntax(text, filename)
    return _cache[key]


class TuiApp:
