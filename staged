def is_reserved_windows_name(name):
    """Check for Windows reserved device names without triggering Python 3.13+ DeprecationWarning."""
    if hasattr(os.path, 'isreserved'):
        return os.path.isreserved(name)
    if hasattr(ntpath, 'isreserved'):
        return ntpath.isreserved(name)
    return PureWindowsPath(name).is_reserved()
COMPLETION_MARKER_START = '# >>> staged completions >>>'
