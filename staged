def _manual_width():
    return max(60, min(88, shutil.get_terminal_size((80, 24)).columns))


def _arg_name(action):
    if action.choices and not action.metavar:
        return '|'.join(str(choice) for choice in action.choices)
    plain = {'start_line': 'line', 'end_line': 'line', 'snippet_focus': 'text', 'message': 'text',
             'session_message': 'text', 'compare_session': 'id', 'offset': 'n', 'length': 'n',
             'delete_count': 'n', 'expect_sha256': 'hash', 'default_session': 'id', 'source': 'id',
             'protected_branch': 'pattern', 'session_root': 'dir', 'target_dir': 'dir', 'cmd': 'template',
             'diff_cmd': 'template', 'open_cmd': 'template', 'resolve': 'id', 'delete': 'id', 'to': 'path',
             'file': 'file', 'target': 'path', 'cwd': 'dir', 'clean_session': 'id', 'id': 'id', 'name': 'name'}
    name = action.metavar or plain.get(action.dest, action.dest)
    if isinstance(name, tuple):
        return ' '.join(part.lower() for part in name)
    return name.lower().replace('_', '-')


def _action_token(action, short=True):
    """The synopsis spelling of one option or operand, e.g. `-m text` or `[id]`."""
    if not action.option_strings:
        if action.nargs == argparse.REMAINDER:
            return _arg_name(action) + ' ...'
        return '[{}]'.format(_arg_name(action)) if action.nargs == '?' else _arg_name(action)
    flags = sorted(action.option_strings, key=len)
    flag = flags[0] if short else flags[-1]
    if action.nargs == 0:
        return flag
    value = _arg_name(action)
    if action.nargs == '?':
        value = '[' + value + ']'
    return '{} {}{}'.format(flag, value, ' ...' if isinstance(action, argparse._AppendAction) else '')


def _visible_actions(parser, common=None):
    """Public actions of a parser; common=True/False selects only/omits the common options."""
    result = []
    for action in parser._actions:
        if isinstance(action, (argparse._HelpAction, argparse._SubParsersAction)) or action.help == argparse.SUPPRESS:
            continue
        is_common = action.dest in COMMON_DESTS and parser.prog != 'staged'
        if common is None or common == is_common:
            result.append(action)
    return result


def synopsis_lines(parser):
    if parser.prog == 'staged':
        return ['staged [-v] [--json] [-s id] [-t tool] [--root dir]',
                'staged --sessions | -R | --list [--json]',
                'staged --summary [-f file] [--json]',
                'staged --intent [--json]',
                'staged command [options]',
                'staged help [command]']
    actions = _visible_actions(parser, common=False)
    groups = {}
    for group in parser._mutually_exclusive_groups:
        members = [a for a in group._group_actions if a in actions]
        if members:
            for action in members:
                groups[action] = (group, members)
    tokens, seen = [], set()
    for action in actions:
        if action in groups:
            group, members = groups[action]
            if id(group) in seen:
                continue
            seen.add(id(group))
            text = ' | '.join(_action_token(a) for a in members)
            tokens.append(('({})' if group.required and len(members) > 1 else '{}' if group.required else '[{}]').format(text))
        elif action.option_strings:
            token = _action_token(action)
            tokens.append(token if action.required else '[' + token + ']')
        else:
            tokens.append(_action_token(action))
    if _visible_actions(parser, common=True):
        tokens.append('[common options]')
    width = _manual_width() - 12
    lines, current = [], parser.prog
    indent = ' ' * (len(parser.prog) + 1)
    for token in tokens:
        if len(current) + 1 + len(token) > width and current.strip() != parser.prog:
            lines.append(current)
            current = indent + token
        else:
            current += ' ' + token
    lines.append(current)
    return lines


def _paint(text, code):
    return color(text, code) if code else text


def _option_heading(action):
    """`-m text, --message text` with flags bold and arguments underlined, plus its plain length."""
    parts_plain, parts_color = [], []
    if not action.option_strings:
        name = _action_token(action)
        return name, _paint(name, '4;33')
    for flag in sorted(action.option_strings, key=len):
        if action.nargs == 0:
            plain, painted = flag, _paint(flag, '1;36')
        else:
            value = _arg_name(action)
            if action.nargs == '?':
                value = '[' + value + ']'
            plain = flag + ' ' + value
            painted = _paint(flag, '1;36') + ' ' + _paint(value, '4;33')
        parts_plain.append(plain)
        parts_color.append(painted)
    return ', '.join(parts_plain), ', '.join(parts_color)


def _wrap(text, indent, width):
    return textwrap.fill(' '.join(text.split()), width, initial_indent=indent, subsequent_indent=indent)


def _option_entries(actions, width):
    out = []
    for action in actions:
        plain, painted = _option_heading(action)
        help_text = (action.help or '').replace('%(default)s', str(action.default))
        body = _wrap(help_text[:1].upper() + help_text[1:] + ('' if help_text.endswith('.') else '.'),
                     ' ' * 13, width)
        if len(plain) <= 6:
            out.append('     ' + painted + ' ' * (8 - len(plain)) + body.lstrip())
        else:
            out.append('     ' + painted)
            out.append(body)
        out.append('')
    return out


def render_manual(parser):
    """Render a parser as a BSD-style manual page."""
    width = _manual_width()
    command = None if parser.prog == 'staged' else parser.prog.split(' ', 1)[1]
    info = MANUAL.get(command, {})
    title = ('STAGED' if command is None else 'STAGED-' + command.upper()) + '(1)'
    middle = 'staged manual'
    gap = max(1, (width - 2 * len(title) - len(middle)) // 2)
    lines = [title + ' ' * gap + middle + ' ' * max(1, width - 2 * len(title) - len(middle) - gap) + title, '']

    def heading(text):
        lines.append(_paint(text, '1'))

    heading('NAME')
    name_line = _wrap('{} – {}'.format(parser.prog, info.get('name', parser.description or '')), '     ', width)
    lines.append(name_line.replace(parser.prog, _paint(parser.prog, '1'), 1))
    lines.append('')
    heading('SYNOPSIS')
    for line in synopsis_lines(parser):
        lines.append('     ' + line)
    lines.append('')
    heading('DESCRIPTION')
    paragraphs = list(info.get('more', [])) or ([parser.description] if command else [])
    for paragraph in paragraphs:
        if paragraph:
            lines.append(_wrap(paragraph, '     ', width))
            lines.append('')
    if command is None:
        heading('COMMANDS')
        names = {a.dest: a for a in parser._actions if isinstance(a, argparse._SubParsersAction)}
        choices = next(iter(names.values())).choices if names else {}
        for title_text, members in COMMAND_GROUPS:
            lines.append('     ' + _paint(title_text, '1'))
            for name in members:
                summary = MANUAL.get(name, {}).get('name', choices[name].description if name in choices else '')
                body = _wrap(summary, ' ' * 26, width)
                lines.append('       ' + _paint(name, '1;36') + ' ' * (19 - len(name)) + body.lstrip())
            lines.append('')
        lines.append(_wrap('Run staged help <command> or staged <command> --help for a command\'s manual, '
                           'and staged --help-all for every manual.', '     ', width))
        lines.append('')
    options = _visible_actions(parser, common=False)
    if options:
        lines.append('     The options are as follows:' if command else '')
        lines.append('')
        if command is None:
            lines.pop()
            lines.pop()
            heading('OPTIONS')
        lines.extend(_option_entries(options, width))
    common = _visible_actions(parser, common=True)
    if common:
        heading('COMMON OPTIONS')
        lines.extend(_option_entries(common, width))
    if command is None:
        heading('ENVIRONMENT')
        for name, text in MANUAL_ENVIRONMENT:
            lines.append('     ' + _paint(name, '1'))
            lines.append(_wrap(text, ' ' * 13, width))
            lines.append('')
        heading('EXIT STATUS')
        lines.append(_wrap('staged exits 0 on success, 1 when a command fails, 2 for invalid usage and 130 when '
                           'interrupted. check, fmt --check and exec pass through failure codes.', '     ', width))
        lines.append('')
    if info.get('examples'):
        heading('EXAMPLES')
        for example, note in info['examples']:
            if note:
                lines.append('     ' + _paint('# ' + note, '2'))
            lines.append('     ' + _paint('$ ' + example, '32'))
            lines.append('')
    see_also = ['staged(1)'] if command else []
    see_also += ['staged-{}(1)'.format(name) for name in info.get('see_also', [])]
    if command is None:
        see_also += ['staged-diff(1)', 'staged-tui(1)', 'staged-intent(1)', 'staged-apply(1)']
    if see_also:
        heading('SEE ALSO')
        lines.append(_wrap(', '.join(see_also), '     ', width))
        lines.append('')
    return '\n'.join(lines).rstrip() + '\n'


def emit_manual(text, file=None):
    """Print help, through a pager when it is longer than an interactive terminal."""
    stream = file or sys.stdout
    if file is None and sys.stdout.isatty() and sys.stdin.isatty():
        rows = shutil.get_terminal_size((80, 24)).lines
        if text.count('\n') >= rows:
            pager = os.environ.get('PAGER') or 'less -R'
            env = dict(os.environ)
            env.setdefault('LESS', 'FRX')
            try:
                process = subprocess.Popen(shlex.split(pager), stdin=subprocess.PIPE, env=env)
                process.communicate(text.encode('utf-8'))
                return
            except (OSError, ValueError):
                pass
    stream.write(text)
    stream.flush()


