class StagedArgumentParser(argparse.ArgumentParser):
    """argparse with BSD-style usage lines and manual-page help (see render_manual)."""

    def format_usage(self):
        return 'usage: ' + '\n       '.join(synopsis_lines(self)) + '\n'

    def print_help(self, file=None):
        emit_manual(render_manual(self), file)

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(2, '{}: {}\nRun {} --help for details.\n'.format(self.prog, message, self.prog))


