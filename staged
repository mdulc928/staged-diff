})
JS_TS_CHECK_EXTENSIONS = frozenset({
    '.js', '.jsx', '.mjs', '.cjs', '.ts', '.tsx',
})
TS_EXTENSIONS = frozenset({'.ts', '.tsx', '.mts', '.cts'})
PYTHON_EXTENSIONS = frozenset({'.py', '.pyi'})
C_CPP_EXTENSIONS = frozenset({'.c', '.cc', '.cpp', '.h', '.hpp', '.m', '.mm'})
CPP_EXTENSIONS = frozenset({'.cc', '.cpp', '.hpp', '.mm'})

# Cloned wholesale into the exec sandbox instead of walked file by file.
HEAVY_CLONE_DIRS = frozenset({
    'node_modules', '.venv', 'venv', 'target', '.build', 'build', 'dist',
    'vendor', '.svelte-kit', '.next', '.nuxt', '.gradle', '.m2',
    '__pycache__', '.pytest_cache', '.mypy_cache', '.ruff_cache', '.tox',
})


def resolve_local_binary(workspace, binary_name):
    """Resolve `binary_name` preferring workspace-local `node_modules/.bin` and `.venv`/`venv`
    before falling back to global `PATH`.
    """
    workspace = Path(workspace).resolve()
    bin_dir = 'Scripts' if os.name == 'nt' else 'bin'
    suffixes = ('.cmd', '.exe', '.bat', '') if os.name == 'nt' else ('',)
    local_dirs = [
        workspace / 'node_modules' / '.bin',
        workspace / '.venv' / bin_dir,
        workspace / 'venv' / bin_dir,
    ]
    for directory in local_dirs:
        for suffix in suffixes:
            candidate = directory / (binary_name + suffix)
            if candidate.is_file() and os.access(str(candidate), os.X_OK):
                return str(candidate)
    return shutil.which(binary_name)


def rewrite_diagnostic_paths(text, session, sandbox_dir=None):
    """Rewrite occurrences of `<sandbox_dir>`, `<session.staging>`, and `<session.workspace>`
    in compiler/linter stdout or stderr back to clean workspace-relative paths.
    """
    if not text:
        return ''
    result = text
    roots = []
    if sandbox_dir is not None:
        roots.append(Path(sandbox_dir).resolve())
        roots.append(Path(sandbox_dir))
    roots.append(session.staging.resolve())
    roots.append(session.staging)
    roots.append(session.workspace.resolve())
    roots.append(session.workspace)

    seen = set()
    unique_roots = []
    for r in roots:
        key = str(r)
        if key not in seen:
            seen.add(key)
            unique_roots.append(r)

    for root in unique_roots:
        raw_root = str(root)
        posix_root = root.as_posix()
        for prefix in (raw_root + os.sep, raw_root + '/', posix_root + '/'):
            if prefix in result:
                result = result.replace(prefix, '')
        if raw_root in result:
            result = result.replace(raw_root, '.')
        if posix_root in result:
            result = result.replace(posix_root, '.')
    return result


def _expand_command_template(template, ws_path, staged_path, session=None, rel=None):
    tokens = shlex.split(template) if isinstance(template, str) else [str(t) for t in template]
    raw_joined = ' '.join(tokens)
    uses_stdin = '{staged_file}' not in raw_joined
    replacements = {
        '{workspace_file}': str(ws_path),
        '{staged_file}': str(staged_path),
        '{file}': str(rel or ws_path.name),
        '{rel}': str(rel or ws_path.name),
    }
    if session is not None:
        replacements['{workspace_root}'] = str(session.workspace)
        replacements['{staging_root}'] = str(session.staging)

    expanded = []
    for token in tokens:
        value = token
        for placeholder, target in replacements.items():
            value = value.replace(placeholder, target)
        expanded.append(value)
    return expanded, uses_stdin


