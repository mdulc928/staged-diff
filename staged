# ---------------------------------------------------------------------------
# 1. Diff Line Stats (`+X -Y`)
# ---------------------------------------------------------------------------

BINARY_SNIFF_BYTES = 8192


def is_binary_bytes(data):
    """Return True if raw byte buffer appears to be binary (contains NUL byte)."""
    if not data:
        return False
    return b'\x00' in data[:BINARY_SNIFF_BYTES]


def is_binary_file(path):
    """Return True if `path` is a file containing binary bytes in its header."""
    path = Path(path)
    if not path.is_file():
        return False
    with path.open('rb') as stream:
        return is_binary_bytes(stream.read(BINARY_SNIFF_BYTES))


class DiffStats(tuple):
    """A 2-tuple `(added, removed)` with `.added`, `.removed`, `.binary`, `.status` attributes
    and dict-style key lookup (`stats['added']`, `stats['binary']`) for universal compatibility.
    """

    def __new__(cls, added, removed, binary=False, status=None):
        obj = super().__new__(cls, (int(added), int(removed)))
        obj.added = int(added)
        obj.removed = int(removed)
        obj.binary = bool(binary)
        obj.status = status
        return obj

    def __getitem__(self, key):
        if isinstance(key, str):
            if hasattr(self, key):
                return getattr(self, key)
            raise KeyError(key)
        return super().__getitem__(key)

    def to_dict(self):
        return {
            'added': self.added,
            'removed': self.removed,
            'binary': self.binary,
            'status': self.status,
        }

    def format(self, show_zero=True):
        return format_diff_stats(self, show_zero=show_zero)


def _count_line_diff(old_bytes, new_bytes):
    old_lines = old_bytes.decode('utf-8', errors='replace').splitlines()
    new_lines = new_bytes.decode('utf-8', errors='replace').splitlines()
    added = 0
    removed = 0
    matcher = difflib.SequenceMatcher(None, old_lines, new_lines)
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'insert':
            added += j2 - j1
        elif tag == 'delete':
            removed += i2 - i1
        elif tag == 'replace':
            removed += i2 - i1
            added += j2 - j1
    return added, removed


def file_diff_stats(session, rel):
    """Compute `DiffStats(added, removed, binary=..., status=...)` between workspace original
    and staged proposal for `rel`.
    """
    status = session.status(rel)
    original = session.original(rel)

    if rel in session.deletions or status == 'DELETED':
        if not original.is_file():
            return DiffStats(0, 0, binary=False, status=status)
        raw_old = original.read_bytes()
        if is_binary_bytes(raw_old):
            return DiffStats(0, 0, binary=True, status=status)
        old_lines = raw_old.decode('utf-8', errors='replace').splitlines()
        return DiffStats(0, len(old_lines), binary=False, status=status)

    proposed = safe_path(session.staging, rel)
    if not proposed.is_file():
        return DiffStats(0, 0, binary=False, status=status)

    raw_new = proposed.read_bytes()
    if not original.is_file() or status == 'NEW FILE':
        if is_binary_bytes(raw_new):
            return DiffStats(0, 0, binary=True, status=status)
        new_lines = raw_new.decode('utf-8', errors='replace').splitlines()
        return DiffStats(len(new_lines), 0, binary=False, status=status)

    if status == 'APPLIED' or equal_files(original, proposed):
        return DiffStats(0, 0, binary=is_binary_bytes(raw_new), status=status)

    raw_old = original.read_bytes()
    if is_binary_bytes(raw_old) or is_binary_bytes(raw_new):
        return DiffStats(0, 0, binary=True, status=status)

    added, removed = _count_line_diff(raw_old, raw_new)
    return DiffStats(added, removed, binary=False, status=status)


def session_diff_stats(session):
    """Aggregate `DiffStats(total_added, total_removed, binary=...)` across all session paths."""
    total_added = 0
    total_removed = 0
    any_binary = False
    for rel in session.paths():
        stats = file_diff_stats(session, rel)
        total_added += stats.added
        total_removed += stats.removed
        if stats.binary:
            any_binary = True
    return DiffStats(total_added, total_removed, binary=any_binary, status='SESSION')


def format_diff_stats(stats_or_session, rel=None, show_zero=True):
    """Format a compact colored diff stats token such as `+14 -3` or `binary`."""
    if rel is not None:
        stats = file_diff_stats(stats_or_session, rel)
    elif isinstance(stats_or_session, DiffStats):
        stats = stats_or_session
    elif isinstance(stats_or_session, tuple) and len(stats_or_session) >= 2:
        stats = DiffStats(stats_or_session[0], stats_or_session[1])
    else:
        stats = session_diff_stats(stats_or_session)

    if stats.binary and stats.added == 0 and stats.removed == 0:
        return color('binary', '2')
    if stats.added == 0 and stats.removed == 0 and not show_zero:
        return ''
    plus = color('+{}'.format(stats.added), '32' if stats.added > 0 else '2')
    minus = color('-{}'.format(stats.removed), '31' if stats.removed > 0 else '2')
    return '{} {}'.format(plus, minus)


