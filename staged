class StagedError(Exception):
    pass


def load_json(path):
    path = Path(path)
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding='utf-8'))
    except (ValueError, OSError) as exc:
        raise StagedError('Cannot read {}: {}'.format(path, exc))
    if not isinstance(data, dict):
        raise StagedError('Expected a JSON object in {}'.format(path))
    return data


def write_text_file(path, content):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.staged-', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            stream.write(content)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def save_json(path, data):
    write_text_file(path, json.dumps(data, indent=2) + '\n')


def git_output(path, *args):
    try:
        result = subprocess.run(['git', '-C', str(path)] + list(args), capture_output=True, text=True)
        return result.stdout.strip() if result.returncode == 0 else None
    except OSError:
        return None


def get_git_root(path):
    value = git_output(path, 'rev-parse', '--show-toplevel')
    return Path(value).resolve() if value else None


def get_git_branch(path):
    return git_output(path, 'symbolic-ref', '--quiet', '--short', 'HEAD') or git_output(path, 'rev-parse', 'HEAD')


def is_branch_protected(branch, patterns=None):
    return bool(branch and any(fnmatch.fnmatchcase(branch, p) for p in
                              (DEFAULT_PROTECTED_BRANCHES if patterns is None else patterns)))


def safe_path(root, relative):
    """Reject traversal, metadata paths and symlinks before reading or mutating files."""
    if not isinstance(relative, str) or not relative or '\\' in relative:
        raise StagedError('Invalid relative path: {!r}'.format(relative))
    part = Path(relative)
    if part.is_absolute() or PureWindowsPath(relative).drive or '..' in part.parts or not part.parts:
        raise StagedError('Path must stay inside its root: {}'.format(relative))
    if part.as_posix() != relative:
        raise StagedError('Use a normalized relative path: {}'.format(relative))
    if os.name == 'nt' and any(PureWindowsPath(p).is_reserved() or ':' in p or p.endswith(('.', ' ')) for p in part.parts):
        raise StagedError('Unsupported Windows file path: ' + relative)
    if any(p.lower() == '.git' for p in part.parts):
        raise StagedError('Git metadata cannot be staged: {}'.format(relative))
    root = Path(root).resolve()
    dest = root
    for component in part.parts:
        dest = dest / component
        if dest.is_symlink():
            raise StagedError('Symlink paths are not supported: {}'.format(dest))
    try:
        dest.resolve().relative_to(root)
    except ValueError:
        raise StagedError('Path escapes root: {}'.format(relative))
    return dest


def equal_files(left, right):
    left, right = Path(left), Path(right)
    if not left.is_file() or not right.is_file() or left.stat().st_size != right.stat().st_size:
        return False
    if os.name != 'nt' and stat.S_IMODE(left.stat().st_mode) != stat.S_IMODE(right.stat().st_mode):
        return False
    with left.open('rb') as a, right.open('rb') as b:
        while True:
            x, y = a.read(65536), b.read(65536)
            if x != y:
                return False
            if not x:
                return True


def copy_atomic(source, dest):
    dest = Path(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.staged-', dir=str(dest.parent))
    os.close(fd)
    try:
        shutil.copy2(source, name)
        os.replace(name, dest)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def confirm(message, yes=False):
    if yes:
        return
    if not sys.stdin.isatty():
        raise StagedError(message + ' Re-run interactively or pass --yes.')
    if input(message + ' [y/N] ').strip().lower() not in ('y', 'yes'):
        raise StagedError('Aborted; no changes made.')


def session_id(value):
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', value) or value in ('.', '..'):
        raise StagedError('Session ID must contain only letters, digits, dots, underscores or hyphens.')
    return value


class Context:
    def __init__(self, args):
        self.args = args
        self.workspace = get_git_root(Path.cwd()) or Path.cwd().resolve()
        self.global_state = load_json(GLOBAL_STATE_FILE)
        self.local = load_json(self.workspace / '.staged.json')
        for data in (self.global_state, self.local):
            for key in ('session_roots', 'protected_branches'):
                if key in data and (not isinstance(data[key], list) or not all(isinstance(p, str) for p in data[key])):
                    raise StagedError(key + ' must be a list of strings.')
            if 'branch_protection' in data and not isinstance(data['branch_protection'], bool):
                raise StagedError('branch_protection must be true or false.')
        if not isinstance(self.global_state.get('tools', {}), dict):
            raise StagedError('tools must be a JSON object.')
        # STAGED_SHELL_ID can supply a stable ID across command-substitution subprocesses.
        shell_id = session_id(os.environ.get('STAGED_SHELL_ID', str(os.getppid())))
        self.shell_path = CONFIG_DIR / 'shell_sessions' / (shell_id + '.json')
        self.shell = load_json(self.shell_path)
        self.registry = dict(TOOL_REGISTRY)
        for key, value in self.global_state.get('tools', {}).items():
            if (not isinstance(value, dict) or not isinstance(value.get('name'), str)
                    or any(not isinstance(value.get(field), list) or not value[field]
                           or not all(isinstance(token, str) for token in value[field])
                           for field in ('diff_cmd', 'open_cmd'))):
                raise StagedError('Invalid custom tool configuration: ' + key)
            self.registry[key] = ToolAdapter(key, value['name'], value['diff_cmd'], value['open_cmd'], value.get('root'))

    def setting(self, key, default=None):
        return self.local.get(key, self.global_state.get(key, default))

    def tool(self):
        key = (getattr(self.args, 'tool', None) or os.environ.get('STAGED_TOOL') or self.shell.get('tool')
               or self.setting('default_tool'))
        if not key:
            key = next((k for k in ('cursor', 'antigravity', 'windsurf', 'vscode', 'pycharm', 'zed')
                        if self.registry[k].detect_binary()), 'cli')
        if key not in self.registry:
            raise StagedError('Unknown tool {!r}. Choose: {}'.format(key, ', '.join(sorted(self.registry))))
        return self.registry[key]

    def staging_root(self):
        value = (getattr(self.args, 'root', None) or os.environ.get('STAGED_ROOT')
                 or self.setting('staging_root') or self.tool().root or DATA_DIR)
        return Path(value).expanduser().resolve()

    def roots(self):
        values = [self.staging_root()] + [Path(r).expanduser().resolve() for r in self.setting('session_roots', [])]
        return list(dict.fromkeys(values))

    def sessions(self, all_repos=False):
        result = []
        for root in self.roots():
            if not root.is_dir():
                continue
            for directory in sorted(root.iterdir()):
                if directory.is_symlink() or not directory.is_dir() or not (directory / '.workspace').is_file():
                    continue
                session = Session(directory)
                if all_repos or session.workspace == self.workspace:
                    result.append(session)
        return sorted(result, key=lambda s: s.modified(), reverse=True)

    def find_session(self, key, all_repos=False):
        sessions = self.sessions(all_repos)
        exact = [s for s in sessions if s.id == key]
        matches = exact or [s for s in sessions if s.id.startswith(key)]
        if len(matches) != 1:
            raise StagedError(('Ambiguous' if matches else 'Unknown') + ' session: ' + key)
        return matches[0]

    def active(self):
        key = (getattr(self.args, 'session', None) or os.environ.get('STAGED_SESSION') or self.shell.get('session')
               or self.setting('default_session'))
        if key:
            return self.find_session(key)
        sessions = self.sessions()
        if not sessions:
            raise StagedError('No staging session for {}. Run staged init <session-id>.'.format(self.workspace))
        return sessions[0]


class Session:
    def __init__(self, directory):
        self.directory = Path(directory).resolve()
        self.id = self.directory.name
        self.staging = self.directory / 'staging'
        if self.staging.is_symlink():
            raise StagedError('Session staging directory cannot be a symlink: {}'.format(self.staging))
        marker = (self.directory / '.workspace').read_text(encoding='utf-8').strip()
        if not marker or not Path(marker).expanduser().is_absolute():
            raise StagedError('.workspace must contain an absolute workspace path: ' + str(self.directory))
        self.workspace = Path(marker).expanduser().resolve()
        if not self.workspace.is_dir():
            raise StagedError('Session workspace does not exist: {}'.format(self.workspace))
        self.metadata = load_json(self.directory / 'session.json')
        if self.metadata.get('branch') is not None and not isinstance(self.metadata['branch'], str):
            raise StagedError('Session branch must be a string or null.')
        provenance = self.metadata.get('migrated_from', [])
        if (not isinstance(provenance, list) or any(not isinstance(item, dict)
                or (item.get('branch') is not None and not isinstance(item['branch'], str)) for item in provenance)):
            raise StagedError('Invalid migration provenance in session.json.')
        self.manifest = load_json(self.directory / 'renames.json')
        self.deletions = self.manifest.get('_deletions', [])
        if not isinstance(self.deletions, list) or not all(isinstance(p, str) for p in self.deletions):
            raise StagedError('_deletions must be a list of relative file paths.')
        if set(self.deletions) & (set(self.manifest) - {'_deletions'}):
            raise StagedError('A rename destination cannot also be a deletion.')
        for dest, source in self.manifest.items():
            if dest != '_deletions':
                safe_path(self.staging, dest)
                safe_path(self.workspace, source)
        for rel in self.deletions:
            safe_path(self.workspace, rel)

    def modified(self):
        paths = [self.staging, self.directory / 'session.json', self.directory / 'renames.json'] + list(self.files().values())
        return max(p.stat().st_mtime for p in paths if not p.is_symlink() and p.exists())

    def files(self, fresh=False):
        if not fresh:
            try:
                cached = load_json(self.directory / '.index.json')
                directories = cached.get('directories', {})
                if cached.get('version') == 1 and isinstance(directories, dict) and '.' in directories:
                    valid = True
                    for rel, timestamp in directories.items():
                        path = self.staging if rel == '.' else safe_path(self.staging, rel)
                        if not path.is_dir() or path.stat().st_mtime_ns != timestamp:
                            valid = False
                            break
                    if valid:
                        result = {item['path']: safe_path(self.staging, item['path']) for item in cached['files']}
                        if all(path.is_file() for path in result.values()):
                            return dict(sorted(result.items()))
            except (StagedError, OSError, KeyError, TypeError):
                # The index is disposable; malformed or stale data triggers a scan.
                pass
        result = {}
        self._directory_mtimes = {}
        for root, dirs, files in os.walk(self.staging, followlinks=False):
            self._directory_mtimes[Path(root).relative_to(self.staging).as_posix()] = Path(root).stat().st_mtime_ns
            for name in dirs:
                safe_path(self.staging, (Path(root) / name).relative_to(self.staging).as_posix())
            for name in files:
                rel = (Path(root) / name).relative_to(self.staging).as_posix()
                path = safe_path(self.staging, rel)
                if not path.is_file():
                    raise StagedError('Only regular files can be staged: ' + rel)
                result[rel] = path
        return dict(sorted(result.items()))

    def paths(self, fresh=False):
        return sorted(set(self.files(fresh=fresh)) | set(self.deletions) | (set(self.manifest) - {'_deletions'}))

    def original(self, rel):
        return safe_path(self.workspace, self.manifest.get(rel, rel))

    def status(self, rel):
        if rel in self.deletions:
            return 'DELETED' if self.original(rel).exists() else 'APPLIED'
        source = safe_path(self.staging, rel)
        if not source.is_file():
            return 'MISSING'
        dest = safe_path(self.workspace, rel)
        old = self.original(rel)
        if equal_files(dest, source) and (old == dest or not old.exists()):
            return 'APPLIED'
        if old != dest and old.exists():
            return 'RENAMED' if old.name != dest.name else 'RELOCATED'
        return 'MODIFIED' if dest.exists() or old.exists() else 'NEW FILE'

    def save_manifest(self):
        save_json(self.directory / 'renames.json', self.manifest)

    def refresh_index(self):
        entries = []
        for rel, path in self.files(fresh=True).items():
            stat = path.stat()
            entries.append({'path': rel, 'basename': path.name, 'tokens': re.findall(r'\w+', rel.lower()),
                            'mtime_ns': stat.st_mtime_ns, 'size': stat.st_size})
        save_json(self.directory / '.index.json', {'version': 1, 'files': entries, 'deletions': self.deletions,
                                                 'directories': self._directory_mtimes})


def levenshtein(a, b):
    previous = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        current = [i]
        for j, cb in enumerate(b, 1):
            current.append(min(current[-1] + 1, previous[j] + 1, previous[j - 1] + (ca != cb)))
        previous = current
    return previous[-1]


def match_file(query, paths):
    paths = sorted(paths)
    if query in paths:
        return query
    q = query.lower()
    def subsequence(value):
        chars = iter(value.lower())
        return all(any(ch == c for ch in chars) for c in q)
    candidates = [p for p in paths if p.lower() == q]
    if not candidates:
        candidates = [p for p in paths if Path(p).name.lower() == q]
    if not candidates:
        candidates = [p for p in paths if subsequence(p)]
    if not candidates and len(q) >= 3:
        distances = [(levenshtein(q, Path(p).name.lower()), p) for p in paths]
        best = min((distance for distance, _ in distances), default=999)
        if best <= max(1, min(3, len(q) // 4)):
            candidates = [p for distance, p in distances if distance == best]
    if len(candidates) != 1:
        if candidates:
            raise StagedError('Ambiguous file {!r}; use an exact path:\n  {}'.format(query, '\n  '.join(candidates)))
        raise StagedError('No staged file matched {!r}.'.format(query))
    return candidates[0]


def selected(session, target):
    # Mutating operations and explicit review never trust a derived inventory.
    paths = session.paths(fresh=True)
    return paths if target == 'all' else [match_file(target, paths)]


class ToolAdapter:
    def __init__(self, tool_id, name, diff_cmd, open_cmd, root=None):
        self.id = tool_id
        self.name = name
        self.diff_cmd = diff_cmd
        self.open_cmd = open_cmd
        self.root = root

    def detect_binary(self, command=None):
        command = command or self.diff_cmd[0]
        if self.id == 'pycharm' and command == self.diff_cmd[0]:
            found = detect_jetbrains_binary()
            if found:
                return found
        found = shutil.which(command)
        if found:
            return found
        if sys.platform == 'darwin':
            bundles = {'cursor': ('Cursor', 'Resources/app/bin/cursor'),
                       'antigravity-ide': ('Antigravity IDE', 'Resources/app/bin/antigravity-ide'),
                       'windsurf': ('Windsurf', 'Resources/app/bin/windsurf'),
                       'code': ('Visual Studio Code', 'Resources/app/bin/code'),
                       'zed': ('Zed', 'MacOS/zed')}
            if command in bundles:
                app, suffix = bundles[command]
                for parent in (Path('/Applications'), Path(HOME) / 'Applications'):
                    path = parent / (app + '.app') / 'Contents' / suffix
                    if path.is_file():
                        return str(path)
        if os.name == 'nt':
            programs = Path(os.environ.get('LOCALAPPDATA', HOME)) / 'Programs'
            for folder in (command, {'code': 'Microsoft VS Code'}.get(command, command)):
                for ext in ('.cmd', '.exe'):
                    path = programs / folder / 'bin' / (command + ext)
                    if path.is_file():
                        return str(path)
        return None

    def build_command(self, template, orig=None, staged=None):
        # Replace inside tokens too, supporting custom editors' command arguments.
        executable = self.detect_binary(template[0])
        if not executable:
            raise StagedError('Executable not found: {}. Configure --tool cli or install the editor launcher.'.format(template[0]))
        values = {'orig': str(orig or ''), 'staged': str(staged or '')}
        args = [executable] + [token.replace('{orig}', values['orig']).replace('{staged}', values['staged'])
                               for token in template[1:]]
        if sys.platform.startswith('linux') and executable.lower().endswith(('.exe', '.cmd', '.bat')):
            for i in range(1, len(args)):
                for path in (orig, staged):
                    if path and str(path) in args[i]:
                        translated = subprocess.run(['wslpath', '-w', str(path)], capture_output=True, text=True, check=True)
                        args[i] = args[i].replace(str(path), translated.stdout.strip())
        return args

    def get_diff_command(self, orig, staged):
        if self.id in ('cli', 'codex', 'claudecode'):
            if shutil.which('difft'):
                return ['difft', str(orig), str(staged)]
            if shutil.which('git'):
                return ['git', '--no-pager', 'diff', '--no-index', '--', str(orig), str(staged)]
            if shutil.which('diff'):
                return ['diff', '-u', str(orig), str(staged)]
            raise StagedError('Install git, difftastic or diff for terminal review.')
        return self.build_command(self.diff_cmd, orig, staged)

    def get_open_command(self, staged):
        return self.build_command(self.open_cmd, staged=staged)

    def configure_sandbox(self, root):
        if self.id != 'cursor':
            return False
        sandbox = Path(HOME) / '.cursor/sandbox.json'
        data = load_json(sandbox)
        paths = data.setdefault('additionalReadwritePaths', [])
        if not isinstance(paths, list):
            raise StagedError('additionalReadwritePaths must be a list in ' + str(sandbox))
        if str(root) not in paths:
            paths.append(str(root))
        cli = Path(HOME) / '.cursor/cli-config.json'
        settings = load_json(cli)
        permissions = settings.setdefault('permissions', {})
        if not isinstance(permissions, dict):
            raise StagedError('permissions must be an object in ' + str(cli))
        allowed = permissions.setdefault('allow', [])
        if not isinstance(allowed, list):
            raise StagedError('permissions.allow must be a list in ' + str(cli))
        for token in ('Read({}/**)'.format(root), 'Write({}/**)'.format(root)):
            if token not in allowed:
                allowed.append(token)
        save_json(sandbox, data)
        save_json(cli, settings)
        return True

    def install_skill(self, target_dir=None):
        roots = {'cursor': Path(HOME) / '.cursor/skills',
                 'claudecode': Path(HOME) / '.claude/skills',
                 'codex': Path(HOME) / '.agents/skills',
                 'windsurf': Path(HOME) / '.codeium/windsurf/skills',
                 'antigravity': Path(HOME) / '.gemini/config/skills'}
        if target_dir:
            target = Path(target_dir).expanduser().resolve()
        elif self.id in roots:
            target = roots[self.id] / 'stage'
        else:
            raise StagedError('{} has no configured native skill registry. Pass --target-dir <skill-directory> for your agent harness.'.format(self.name))
        source = REPO_ROOT / 'SKILL.md'
        if not source.is_file():
            raise StagedError('Missing bundled skill: ' + str(source))
        copy_atomic(source, target / 'SKILL.md')
        return target / 'SKILL.md'


TOOL_REGISTRY = {}
for key, name, command, diff, opening in [
    ('cursor', 'Cursor', 'cursor', ['-r', '--diff'], ['-r']),
    ('antigravity', 'Antigravity IDE', 'antigravity-ide', ['-r', '-d'], ['-r']),
    ('windsurf', 'Windsurf', 'windsurf', ['-r', '--diff'], ['-r']),
    ('vscode', 'Visual Studio Code', 'code', ['-r', '-d'], ['-r']),
    ('pycharm', 'PyCharm / JetBrains', 'charm', ['diff'], []),
    ('zed', 'Zed', 'zed', ['--diff'], []),
]:
    TOOL_REGISTRY[key] = ToolAdapter(key, name, [command] + diff + ['{orig}', '{staged}'],
                                    [command] + opening + ['{staged}'])
for key, name in [('cli', 'Terminal'), ('codex', 'Codex'), ('claudecode', 'Claude Code')]:
    editor = shlex.split(os.environ.get('EDITOR', 'notepad' if os.name == 'nt' else 'vi'))
    TOOL_REGISTRY[key] = ToolAdapter(key, name, ['git', 'diff', '--no-index', '{orig}', '{staged}'], editor + ['{staged}'])


def run_editor(command, terminal=False):
    # Native .exe files need no shell. Batch launchers require cmd.exe on Windows.
    if os.name == 'nt' and command[0].lower().endswith(('.cmd', '.bat')):
        if any(any(ch in arg for ch in '\r\n%"&|<>^!') for arg in command):
            raise StagedError('Batch launcher cannot safely represent these arguments; use a native executable.')
        shell = subprocess.list2cmdline([os.environ.get('COMSPEC', 'cmd.exe')])
        quoted = ' '.join('"{}"'.format(arg) for arg in command)
        command = '{} /d /s /c "{}"'.format(shell, quoted)
    result = subprocess.run(command)
    if result.returncode not in ((0, 1) if terminal else (0,)):
        raise StagedError('Editor/diff command failed with exit code {}'.format(result.returncode))


def init_session(ctx, key, root=None):
    key = session_id(key)
    root = root or ctx.staging_root()
    try:
        root.relative_to(ctx.workspace)
    except ValueError:
        pass
    else:
        raise StagedError('Staging root must be outside the workspace: ' + str(root))
    directory = safe_path(root, key)
    if directory.exists():
        if not (directory / '.workspace').is_file():
            raise StagedError('Directory already exists without session metadata: ' + str(directory))
        session = Session(directory)
        if session.workspace != ctx.workspace:
            raise StagedError('Session belongs to a different workspace: ' + str(session.workspace))
        return session
    (directory / 'staging').mkdir(parents=True)
    write_text_file(directory / '.workspace', str(ctx.workspace) + '\n')
    save_json(directory / 'session.json', {'id': key, 'branch': get_git_branch(ctx.workspace), 'created_at': time.time()})
    save_json(directory / 'renames.json', {})
    return Session(directory)


def overview(ctx, session):
    print('Repository:     {}'.format(session.workspace))
    print('Active Session: {}'.format(session.id))
    print('Active Tool:    {}'.format(ctx.tool().name))
    print('Git Branch:     {}'.format(get_git_branch(session.workspace) or '(not a Git repository)'))
    print('Staging:        {}'.format(session.staging))
    paths = session.paths()
    if not paths:
        print('No staged changes yet.')
    for rel in paths:
        print('  [{:9}] {}'.format(session.status(rel), rel))
        if ctx.args.verbose:
            path = safe_path(session.staging, rel)
            print('    Staged:    {}'.format(path if path.exists() else '(deletion)'))
            print('    Workspace: {}'.format(session.original(rel)))
            if path.exists():
                print('    Size: {} bytes; modified: {}'.format(path.stat().st_size, time.ctime(path.stat().st_mtime)))
    session.refresh_index()


def review(ctx, session, target):
    tool = ctx.tool()
    terminal = tool.id in ('cli', 'codex', 'claudecode')
    for rel in selected(session, target):
        if target == 'all' and session.status(rel) == 'APPLIED':
            continue
        original = session.original(rel)
        proposed = safe_path(session.staging, rel)
        if rel not in session.deletions and not proposed.is_file():
            raise StagedError('Missing staged contents: ' + rel)
        # GUI launchers often return before opening tabs; keep the empty side on disk.
        empty = safe_path(session.directory, '.review/empty/' + rel)
        write_text_file(empty, '')
        left = original if original.is_file() else empty
        right = empty if rel in session.deletions else proposed
        print('Review [{}]: {}'.format(session.status(rel), rel), flush=True)
        run_editor(tool.get_diff_command(left, right), terminal)


def guard_apply(ctx, session):
    branch = get_git_branch(session.workspace)
    patterns = ctx.setting('protected_branches', DEFAULT_PROTECTED_BRANCHES)
    if ctx.setting('branch_protection', True) and is_branch_protected(branch, patterns):
        if not ctx.args.force:
            raise StagedError("Protected branch '{}'; switch branches or pass --force.".format(branch))
        print("Warning: applying to protected branch '{}' (--force).".format(branch), file=sys.stderr)
    origins = {session.metadata.get('branch')}
    origins.update(item.get('branch') for item in session.metadata.get('migrated_from', []))
    drifted = sorted(origin for origin in origins if origin and origin != branch)
    if drifted:
        confirm("Branch changed from '{}' to '{}'. Apply here?".format(', '.join(drifted), branch), ctx.args.yes)


def preflight(session, paths):
    files = session.files(fresh=True)
    destinations = set(paths) - set(session.deletions)
    all_destinations = set(files)
    if set(files) & set(session.deletions):
        raise StagedError('A path cannot be both a staged file and a deletion.')
    sources = []
    for rel in paths:
        dest = safe_path(session.workspace, rel)
        original = session.original(rel)
        if dest.exists() and not dest.is_file() or original.exists() and not original.is_file():
            raise StagedError('Apply requires regular file destinations: ' + rel)
        for parent in dest.parents:
            if parent == session.workspace:
                break
            if parent.exists() and not parent.is_dir():
                raise StagedError('Destination parent is a file: ' + str(parent))
        if rel not in session.deletions:
            if rel not in files:
                raise StagedError('Missing staged contents: ' + rel)
            old = session.manifest.get(rel, rel)
            if old != rel:
                if old in all_destinations or old in session.deletions:
                    raise StagedError('Overlapping rename/deletion sources require separate sessions: ' + old)
                sources.append(old)
    if len(sources) != len(set(sources)):
        raise StagedError('Multiple staged files cannot rename the same source.')
    for rel in destinations:
        if any(parent.as_posix() in destinations for parent in Path(rel).parents if str(parent) != '.'):
            raise StagedError('Conflicting staged file and directory: ' + rel)


def apply_changes(ctx, session, target):
    paths = selected(session, target)
    preflight(session, paths)
    guard_apply(ctx, session)
    for rel in paths:
        dest = safe_path(session.workspace, rel)
        old = session.original(rel)
        if rel in session.deletions:
            if dest.exists():
                dest.unlink()
            print('[DELETED] ' + rel)
        else:
            copy_atomic(safe_path(session.staging, rel), dest)
            if old != dest and old.is_file():
                old.unlink()
            print('[APPLIED] ' + rel)
    session.refresh_index()


def clean_session(ctx, session):
    paths = selected(session, ctx.args.file or 'all')
    if any(session.status(rel) != 'APPLIED' for rel in paths):
        confirm('Discard {} pending staged change(s) from {}?'.format(len(paths), session.id), ctx.args.yes)
    for rel in paths:
        path = safe_path(session.staging, rel)
        if path.is_file():
            path.unlink()
        session.manifest.pop(rel, None)
        session.deletions[:] = [p for p in session.deletions if p != rel]
    if ctx.args.file is None:
        session.manifest = {}
        session.deletions = []
    elif '_deletions' in session.manifest:
        session.manifest['_deletions'] = session.deletions
    session.save_manifest()
    session.refresh_index()
    print('Cleaned {} staged change(s); workspace untouched.'.format(len(paths)))


def cross_diff(ctx):
    if ctx.args.apply:
        raise StagedError('Cross-session comparison cannot be combined with --apply.')
    if ctx.args.between:
        left, right = (ctx.find_session(key) for key in ctx.args.between)
    else:
        left, right = ctx.active(), ctx.find_session(ctx.args.compare_session)
    common = sorted(set(left.files(fresh=True)) & set(right.files(fresh=True)))
    paths = common if ctx.args.target in (None, 'all') else [match_file(ctx.args.target, common)]
    if not paths:
        raise StagedError('No common staged files in the two sessions.')
    tool = ctx.tool()
    for rel in paths:
        run_editor(tool.get_diff_command(safe_path(left.staging, rel), safe_path(right.staging, rel)),
                   tool.id in ('cli', 'codex', 'claudecode'))


def migrate(ctx):
    source = ctx.find_session(ctx.args.source)
    if ctx.args.to:
        try:
            dest = ctx.find_session(ctx.args.to)
        except StagedError as exc:
            if not str(exc).startswith('Unknown session:'):
                raise
            dest = init_session(ctx, ctx.args.to)
    else:
        dest = ctx.active()
    if source.directory == dest.directory:
        raise StagedError('Migration needs two different sessions.')
    if ctx.args.file and any(ch in ctx.args.file for ch in '*?['):
        paths = [p for p in source.paths(fresh=True) if fnmatch.fnmatchcase(p, ctx.args.file)]
        if not paths:
            raise StagedError('No staged files matched migration pattern: ' + ctx.args.file)
    else:
        paths = selected(source, ctx.args.file or 'all')
    preflight(source, paths)
    # Validate the entire transfer before changing any destination files or manifest.
    conflicts = []
    manifest = dict(dest.manifest)
    deletions = set(dest.deletions)
    for rel in paths:
        incoming = safe_path(source.staging, rel)
        existing = safe_path(dest.staging, rel)
        old = source.original(rel)
        if existing.exists() and not existing.is_file():
            raise StagedError('Migration destination is not a regular file: ' + rel)
        for parent in existing.parents:
            if parent == dest.staging:
                break
            if parent.exists() and not parent.is_dir():
                raise StagedError('Migration destination parent is a file: ' + str(parent))
        if existing.exists() or rel in dest.deletions:
            conflicts.append('target already contains ' + rel)
        if rel not in source.deletions and old.exists() and old.stat().st_mtime_ns > incoming.stat().st_mtime_ns and not equal_files(old, incoming):
            conflicts.append('workspace is newer than ' + rel)
        if rel in source.deletions:
            deletions.add(rel)
            manifest.pop(rel, None)
        else:
            deletions.discard(rel)
            if rel in source.manifest:
                manifest[rel] = source.manifest[rel]
            else:
                manifest.pop(rel, None)
    resulting_files = (set(dest.files()) | (set(paths) - set(source.deletions))) - deletions
    for rel in resulting_files:
        if any(parent.as_posix() in resulting_files for parent in Path(rel).parents if str(parent) != '.'):
            raise StagedError('Migration creates conflicting file and directory: ' + rel)
    rename_sources = [old for rel, old in manifest.items() if rel != '_deletions' and rel in resulting_files and old != rel]
    if len(rename_sources) != len(set(rename_sources)) or set(rename_sources) & (resulting_files | deletions):
        raise StagedError('Migration creates overlapping rename or deletion operations.')
    if conflicts and not ctx.args.force:
        raise StagedError('Migration requires review; use --force to replace:\n  ' + '\n  '.join(conflicts))
    if conflicts:
        print('Warning: ' + '; '.join(conflicts), file=sys.stderr)
    for rel in paths:
        target = safe_path(dest.staging, rel)
        if rel in source.deletions:
            if target.is_file():
                target.unlink()
        else:
            copy_atomic(safe_path(source.staging, rel), target)
    if deletions:
        manifest['_deletions'] = sorted(deletions)
    else:
        manifest.pop('_deletions', None)
    dest.manifest, dest.deletions = manifest, sorted(deletions)
    dest.save_manifest()
    if not dest.metadata.get('migrated_from'):
        dest.metadata['migrated_from'] = []
    dest.metadata['migrated_from'].append({'session': source.id, 'branch': source.metadata.get('branch'), 'paths': paths})
    save_json(dest.directory / 'session.json', dest.metadata)
    dest.refresh_index()
    print('Migrated {} change(s) from {} to {}.'.format(len(paths), source.id, dest.id))
JETBRAINS_CLI_NAMES = ("charm", "pycharm", "idea")

def detect_jetbrains_binary():
    """Resolve JetBrains IDE CLI (charm / pycharm / idea) when Toolbox scripts are not on PATH."""
    for name in JETBRAINS_CLI_NAMES:
        found = shutil.which(name)
        if found:
            return found
    toolbox_dirs = [
        os.path.join(HOME, "Library", "Application Support", "JetBrains", "Toolbox", "scripts"),
        os.path.join(HOME, ".local", "share", "JetBrains", "Toolbox", "scripts"),
    ]
    for toolbox in toolbox_dirs:
        if not os.path.isdir(toolbox):
            continue
        for name in JETBRAINS_CLI_NAMES:
            script = os.path.join(toolbox, name)
            if os.path.isfile(script):
                return script
    if sys.platform == "darwin":
        for pattern in (
            "/Applications/PyCharm*.app/Contents/MacOS/pycharm",
            "/Applications/IntelliJ IDEA*.app/Contents/MacOS/idea",
            "/Applications/WebStorm*.app/Contents/MacOS/webstorm",
        ):
            matches = sorted(glob.glob(pattern))
            if matches:
                return matches[0]
    return None

def upsert_shell_block(path, block, insert_before_compinit=False):
    block = block.strip() + "\n"
    if os.path.isfile(path):
        with open(path, "r", encoding="utf-8") as f:
            content = f.read()
        pattern = re.compile(
            re.escape(COMPLETION_MARKER_START) + r".*?" + re.escape(COMPLETION_MARKER_END),
            re.DOTALL,
        )
        if pattern.search(content):
            content = pattern.sub(lambda match: block.strip(), content)
        elif insert_before_compinit:
            lines = content.splitlines(keepends=True)
            insert_at = None
            for idx, line in enumerate(lines):
                if re.search(r"\bcompinit\b", line) and not line.lstrip().startswith("#"):
                    insert_at = idx
                    break
            if insert_at is not None:
                lines.insert(insert_at, block)
                content = "".join(lines)
            else:
                content = block + ("\n" if content and not content.startswith("\n") else "") + content
        else:
            if content and not content.endswith("\n"):
                content += "\n"
            content += "\n" + block
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
    else:
        with open(path, "w", encoding="utf-8") as f:
            f.write(block)



def make_parser():
    def globals_on(parser, path_command=False):
        parser.add_argument('-t', '--tool', default=argparse.SUPPRESS, help='editor adapter ID')
        flags = ['--session'] if path_command else ['-s', '--session']
        parser.add_argument(*flags, default=argparse.SUPPRESS, help='session ID or unique prefix')
        parser.add_argument('--root', default=argparse.SUPPRESS, help='staging root (outside the workspace)')
        parser.add_argument('-v', '--verbose', action='store_true', default=argparse.SUPPRESS)
    parser = argparse.ArgumentParser(prog='staged', description=__doc__)
    parser.set_defaults(tool=None, session=None, root=None, verbose=False)
    globals_on(parser)
    parser.add_argument('-R', '--all-repos', action='store_true', help='list sessions across repositories')
    parser.add_argument('--sessions', action='store_true', help='list sessions for this repository')
    parser.add_argument('--install-completion', action='store_true', help='install shell integration')
    parser.add_argument('--shell', choices=['bash', 'zsh', 'powershell', 'cmd'], help='shell for completion installation')
    for helper in ('--complete', '--complete-sessions', '--complete-tools', '--list'):
        parser.add_argument(helper, action='store_true', help=argparse.SUPPRESS)
    subs = parser.add_subparsers(dest='command')
    command_parsers = {}
    descriptions = {
        'init': 'Create an isolated session and record its workspace and branch.',
        'diff': 'Review proposed files, or explicitly apply them with -a.',
        'apply': 'Apply proposed files, renames and deletions to the workspace.',
        'clean': 'Discard staged proposals without changing the workspace.',
        'path': 'Print a raw absolute staged or workspace path.',
        'use': 'Bind a session or tool to the current shell.',
        'set': 'Set persistent preferences.',
        'set-tool': 'Register a custom editor using argument templates.',
        'migrate': 'Copy proposals between sessions, checking for stale conflicts.',
        'install-skill': 'Install /stage for an agent harness.',
    }
    for name in COMMANDS:
        command = subs.add_parser(name, description=descriptions[name], help=descriptions[name])
        globals_on(command, name == 'path')
        command_parsers[name] = command
    p = command_parsers['init']
    p.add_argument('id', nargs='?', help='conversation ID; generates a UUID when omitted')
    p.add_argument('--json', action='store_true', help='print machine-readable session paths')
    p = command_parsers['diff']
    p.add_argument('target', nargs='?')
    p.add_argument('-a', '--apply', action='store_true')
    comparison = p.add_mutually_exclusive_group()
    comparison.add_argument('--between', nargs=2, metavar=('SESSION1', 'SESSION2'))
    comparison.add_argument('--compare-session')
    for name in ('diff', 'apply'):
        command_parsers[name].add_argument('--force', action='store_true', help='allow protected-branch apply')
        command_parsers[name].add_argument('-y', '--yes', action='store_true', help='confirm branch drift')
    p = command_parsers['apply']
    p.add_argument('target', nargs='?')
    p.add_argument('-f', '--file')
    p = command_parsers['clean']
    p.add_argument('-f', '--file')
    p.add_argument('-y', '--yes', action='store_true')
    p = command_parsers['path']
    p.add_argument('target')
    group = p.add_mutually_exclusive_group()
    group.add_argument('-s', '--staged', action='store_true', help='print proposed-file path (default)')
    group.add_argument('-w', '--workspace', action='store_true')
    p = command_parsers['use']
    p.add_argument('id', nargs='?')
    p.add_argument('--clear', action='store_true')
    p = command_parsers['set']
    p.add_argument('--default', action='store_true', help='global preferences (the default)')
    p.add_argument('--repo', action='store_true', help='save in this workspace .staged.json')
    p.add_argument('--default-session')
    p.add_argument('--branch-protection', choices=['true', 'false'])
    p.add_argument('--protected-branch', action='append', help='replace protected patterns; repeat for each pattern')
    p.add_argument('--session-root', action='append', help='additional discovery root; repeat for each root')
    p = command_parsers['set-tool']
    p.add_argument('id')
    p.add_argument('--name', required=True)
    p.add_argument('--diff-cmd', required=True)
    p.add_argument('--open-cmd', required=True)
    p = command_parsers['migrate']
    p.add_argument('--from', dest='source', required=True)
    p.add_argument('--to', help='existing session or new session ID')
    p.add_argument('-f', '--file')
    p.add_argument('--force', action='store_true', help='replace target proposals despite conflicts')
    p = command_parsers['install-skill']
    p.add_argument('--default', action='store_true')
    p.add_argument('--target-dir', help='explicit directory containing the installed SKILL.md')
    p.add_argument('--configure-sandbox', action='store_true', help='merge staging-root permissions where supported')
    return parser, command_parsers


def install_completion(shell=None):
    shell = shell or ('powershell' if os.name == 'nt' else Path(os.environ.get('SHELL', 'bash')).name)
    directory = CONFIG_DIR / 'completions'
    if shell == 'bash':
        target = directory / 'staged.bash'
        body = r'''_staged() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" item
  local -a choices=()
  case "$prev" in
    --tool|-t) mapfile -t choices < <(command staged --complete-tools 2>/dev/null) ;;
    --session|-s|--from|--to|--between|--compare-session|use)
      mapfile -t choices < <(command staged --complete-sessions 2>/dev/null) ;;
    *)
      choices=(init diff apply clean path use set set-tool migrate install-skill all --help --session --tool --root --force --yes --file --apply --between --compare-session)
      while IFS= read -r item; do choices+=("$item"); done < <(command staged --list 2>/dev/null)
      ;;
  esac
  COMPREPLY=()
  for item in "${choices[@]}"; do
    [[ "$item" == "$cur"* ]] && COMPREPLY+=("$item")
  done
}
complete -F _staged staged
'''
        # macOS ships Bash 3.2, which has no mapfile.
        body = body.replace('mapfile -t choices < <(', 'while IFS= read -r item; do choices+=("$item"); done < <(')
        write_text_file(target, body)
        hook = '{}\nsource {}\n{}\n'.format(COMPLETION_MARKER_START, shlex.quote(str(target)), COMPLETION_MARKER_END)
        upsert_shell_block(str(Path(HOME) / '.bashrc'), hook)
        upsert_shell_block(str(Path(HOME) / '.bash_profile'), hook)
    elif shell == 'zsh':
        target = directory / '_staged'
        body = '''#compdef staged
_staged() {
  local -a candidates
  case "${words[CURRENT-1]}" in
    --tool|-t) candidates=("${(@f)$(command staged --complete-tools 2>/dev/null)}") ;;
    --session|-s|--from|--to|--between|--compare-session|use)
      candidates=("${(@f)$(command staged --complete-sessions 2>/dev/null)}") ;;
    *) candidates=(init diff apply clean path use set set-tool migrate install-skill all --help --session --tool --root --force --yes --file --apply --between --compare-session "${(@f)$(command staged --list 2>/dev/null)}") ;;
  esac
  compadd -- "${candidates[@]}"
}
_staged "$@"
'''
        write_text_file(target, body)
        hook = '{}\nfpath=({} $fpath)\nautoload -Uz compinit\ncompinit\n{}\n'.format(
            COMPLETION_MARKER_START, shlex.quote(str(directory)), COMPLETION_MARKER_END)
        upsert_shell_block(str(Path(HOME) / '.zshrc'), hook, insert_before_compinit=True)
    elif shell == 'powershell':
        target = directory / 'staged.ps1'
        body = '''Register-ArgumentCompleter -Native -CommandName staged -ScriptBlock {
  param($wordToComplete, $commandAst, $cursorPosition)
  $words = @($commandAst.CommandElements | ForEach-Object { $_.Extent.Text })
  $previous = if ($wordToComplete) { $words[-2] } else { $words[-1] }
  $choices = switch ($previous) {
    { $_ -in '--tool','-t' } { & staged --complete-tools; break }
    { $_ -in '--session','-s','--from','--to','--between','--compare-session','use' } { & staged --complete-sessions; break }
    default { 'init','diff','apply','clean','path','use','set','set-tool','migrate','install-skill','all'; & staged --list }
  }
  $choices | Where-Object { $_.StartsWith($wordToComplete) } | ForEach-Object {
    $quoted = "'" + $_.Replace("'", "''") + "'"
    [System.Management.Automation.CompletionResult]::new($quoted, $_, 'ParameterValue', $_)
  }
}
'''
        write_text_file(target, body)
        print("Load in PowerShell (add to $PROFILE to persist): . '{}'".format(str(target).replace("'", "''")))
    elif shell == 'cmd':
        target = CONFIG_DIR / 'bin/staged.cmd'
        write_text_file(target, '@echo off\r\n"{}" "{}" %*\r\n'.format(sys.executable, REPO_ROOT / 'staged'))
        print('Add {} to PATH. CMD provides filesystem completion, not dynamic argument completion.'.format(target.parent))
    else:
        raise StagedError('Choose --shell bash, zsh, powershell or cmd.')
    print('Installed: {}'.format(target))


def set_preferences(ctx):
    args = ctx.args
    data = dict(ctx.local if args.repo else ctx.global_state)
    if args.repo and args.default:
        raise StagedError('--repo and --default are mutually exclusive.')
    if args.tool:
        data['default_tool'] = ctx.tool().id
    if args.default_session:
        data['default_session'] = ctx.find_session(args.default_session).id
    if args.root:
        data['staging_root'] = str(Path(args.root).expanduser().resolve())
    if args.branch_protection:
        data['branch_protection'] = args.branch_protection == 'true'
    if args.protected_branch is not None:
        data['protected_branches'] = args.protected_branch
    if args.session_root is not None:
        data['session_roots'] = [str(Path(r).expanduser().resolve()) for r in args.session_root]
    path = ctx.workspace / '.staged.json' if args.repo else GLOBAL_STATE_FILE
    save_json(path, data)
    print('Updated ' + str(path))


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    parser, commands = make_parser()
    # Handle help before parsing required values or reading any configuration.
    if '--help' in argv or '-h' in argv or argv[:1] == ['help']:
        command = next((arg for arg in argv if arg in commands), None)
        (commands.get(command) or parser).print_help()
        return
    args = parser.parse_args(argv)
    ctx = Context(args)
    if args.install_completion:
        install_completion(args.shell)
        return
    if args.complete_tools:
        print('\n'.join(sorted(ctx.registry)))
        return
    if args.all_repos or args.sessions or args.complete_sessions:
        for session in ctx.sessions(args.all_repos):
            if args.complete_sessions:
                print(session.id)
            else:
                print('{}  {} changes  {}\n  {}'.format(session.id, len(session.paths()), session.workspace, session.staging))
        return
    if args.complete or args.list:
        try:
            print('\n'.join(ctx.active().paths()))
        except StagedError as exc:
            if not str(exc).startswith('No staging session'):
                raise
        return
    if args.command == 'init':
        session = init_session(ctx, args.id or args.session or str(uuid.uuid4()))
        ctx.shell['session'] = session.id
        save_json(ctx.shell_path, ctx.shell)
        result = {'session': session.id, 'workspace': str(session.workspace), 'staging': str(session.staging),
                  'branch': session.metadata.get('branch'), 'directory': str(session.directory)}
        if args.json:
            print(json.dumps(result))
        else:
            print('Session: {}\nStaging: {}\nReview: staged --session {}'.format(session.id, session.staging, session.id))
        return
    if args.command == 'use':
        if args.id and args.session:
            raise StagedError('Choose either --session <id> or a positional session ID.')
        binding = args.session or args.id
        if args.clear:
            if binding or args.tool:
                raise StagedError('--clear cannot be combined with a session or tool.')
            if ctx.shell_path.exists():
                ctx.shell_path.unlink()
            print('Cleared shell binding.')
            return
        if not binding and not args.tool:
            raise StagedError('Provide --session <id>, --tool or --clear.')
        if binding:
            ctx.shell['session'] = ctx.find_session(binding).id
        if args.tool:
            ctx.shell['tool'] = ctx.tool().id
        save_json(ctx.shell_path, ctx.shell)
        print('Shell binding: ' + json.dumps(ctx.shell))
        return
    if args.command == 'set':
        set_preferences(ctx)
        return
    if args.command == 'set-tool':
        key = session_id(args.id)
        if key in TOOL_REGISTRY:
            raise StagedError('Choose a custom ID; built-in adapters cannot be replaced.')
        diff, opening = shlex.split(args.diff_cmd), shlex.split(args.open_cmd)
        if not diff or not opening or '{orig}' not in args.diff_cmd or '{staged}' not in args.diff_cmd or '{staged}' not in args.open_cmd:
            raise StagedError('Diff requires {orig} and {staged}; open requires {staged}.')
        ctx.global_state.setdefault('tools', {})[key] = {'name': args.name, 'diff_cmd': diff, 'open_cmd': opening, 'root': args.root}
        save_json(GLOBAL_STATE_FILE, ctx.global_state)
        print('Registered tool: ' + key)
        return
    if args.command == 'install-skill':
        tool = ctx.tool()
        path = tool.install_skill(args.target_dir)
        root = ctx.staging_root()
        root.mkdir(parents=True, exist_ok=True)
        if args.configure_sandbox:
            if tool.configure_sandbox(root):
                print('Configured staging-root permissions for ' + tool.name)
            else:
                print('Automatic sandbox configuration is unavailable for {}. Add {} to your harness writable roots.'.format(tool.name, root))
        if args.default:
            ctx.global_state['default_tool'] = tool.id
        ctx.global_state['staging_root'] = str(root)
        save_json(GLOBAL_STATE_FILE, ctx.global_state)
        print('Installed /stage: {}'.format(path))
        print('Staging root: {}. Skill installation alone does not grant filesystem permissions.'.format(root))
        return
    if args.command == 'migrate':
        migrate(ctx)
        return
    if args.command == 'diff' and (args.between or args.compare_session):
        cross_diff(ctx)
        return
    session = ctx.active()
    if args.command == 'path':
        rel = match_file(args.target, session.paths())
        if args.workspace:
            print(session.original(rel))
        elif rel in session.deletions:
            raise StagedError('Deletion has no staged file; use --workspace.')
        else:
            print(safe_path(session.staging, rel))
    elif args.command == 'clean':
        clean_session(ctx, session)
    elif args.command == 'apply' or (args.command == 'diff' and args.apply):
        if args.command == 'apply' and args.file and args.target:
            raise StagedError('Choose either a positional target or --file.')
        apply_changes(ctx, session, getattr(args, 'file', None) or args.target or 'all')
    elif args.command == 'diff' and args.target:
        review(ctx, session, args.target)
    else:
        overview(ctx, session)


if __name__ == '__main__':
    try:
        main()
    except (StagedError, OSError, ValueError, subprocess.SubprocessError) as exc:
        print('Error: {}'.format(exc), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print('\nAborted.', file=sys.stderr)
        sys.exit(130)
