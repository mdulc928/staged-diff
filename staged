def highlight_syntax(code_line, filename=None):
    """Optional syntax highlighting via Pygments.
    Returns a list of (start, end, token_kind) spans if Pygments is installed.
    Falls back gracefully to an empty list (clean standard diff highlighting) with zero dependencies.
    """
    if not code_line:
        return []
    try:
        import pygments
        from pygments.lexers import get_lexer_for_filename, TextLexer
        from pygments.token import Token
    except ImportError:
        return []

    try:
        lexer = get_lexer_for_filename(filename, ensure_nl=False) if filename else TextLexer()
    except Exception:
        lexer = TextLexer()

    spans = []
    offset = 0
    for token_type, value in pygments.lex(code_line, lexer):
        length = len(value)
        if token_type in Token.Keyword:
            spans.append((offset, offset + length, 'keyword'))
        elif token_type in Token.String:
            spans.append((offset, offset + length, 'string'))
        elif token_type in Token.Comment:
            spans.append((offset, offset + length, 'comment'))
        elif token_type in Token.Number:
            spans.append((offset, offset + length, 'number'))
        elif token_type in Token.Name:
            spans.append((offset, offset + length, 'name'))
        offset += length
    return spans


tokenize_syntax = highlight_syntax


def extract_selectable_tokens(line):
    if not line or not line.strip():
        return []
    tokens = []
    pattern = re.compile(
        r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\''
        r'|\b[A-Za-z_][A-Za-z0-9_.]*\([^()]*\)'
        r'|\b[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)+'
        r'|\b[A-Za-z_][A-Za-z0-9_]*\b'
        r'|\b\d+(?:\.\d+)?\b'
    )
    seen = set()
    for match in pattern.finditer(line):
        text = match.group(0)
        start, end = match.span()
        if (start, end, text) not in seen:
            seen.add((start, end, text))
            tokens.append({'start': start, 'end': end, 'text': text})
    return tokens


def compute_intraline_spans(left_line, right_line):
    """Character spans of the words that differ between two versions of a line.

    Compares whole words, spaces and punctuation rather than characters so emphasis lands on
    readable units; a line that is mostly rewritten gets no emphasis because its tint says enough.
    """
    if not left_line or not right_line:
        return ([(0, len(left_line))] if left_line else []), ([(0, len(right_line))] if right_line else [])
    pattern = re.compile(r'\w+|\s+|[^\w\s]')
    left_tokens = [m.span() for m in pattern.finditer(left_line)]
    right_tokens = [m.span() for m in pattern.finditer(right_line)]
    matcher = difflib.SequenceMatcher(None, [left_line[a:b] for a, b in left_tokens],
                                      [right_line[a:b] for a, b in right_tokens], autojunk=False)
    if matcher.ratio() < 0.4:
        return [], []
    left_spans = []
    right_spans = []
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag != 'equal':
            if i2 > i1:
                left_spans.append((left_tokens[i1][0], left_tokens[i2 - 1][1]))
            if j2 > j1:
                right_spans.append((right_tokens[j1][0], right_tokens[j2 - 1][1]))
    return left_spans, right_spans


def wrap_points(text, width, limit):
    """Chunk start offsets for soft-wrapping `text[:limit]`, preferring breaks after spaces."""
    starts = [0]
    while limit - starts[-1] > width:
        start = starts[-1]
        cut = text.rfind(' ', start + width // 2, start + width)
        starts.append(cut + 1 if cut != -1 else start + width)
    return starts


def compute_diff_hunks(orig_lines, staged_lines):
    matcher = difflib.SequenceMatcher(None, orig_lines, staged_lines)
    hunks = []
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag != 'equal':
            hunks.append({
                'index': len(hunks),
                'tag': tag,
                'orig_start': i1,
                'orig_end': i2,
                'staged_start': j1,
                'staged_end': j2,
            })
    return hunks


def build_side_by_side_rows(orig_lines, staged_lines):
    matcher = difflib.SequenceMatcher(None, orig_lines, staged_lines)
    rows = []
    hunks = []
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            for offset in range(i2 - i1):
                li = i1 + offset
                ri = j1 + offset
                rows.append({
                    'kind': 'equal',
                    'hunk_index': None,
                    'left_lineno': li + 1,
                    'left_text': orig_lines[li],
                    'right_lineno': ri + 1,
                    'right_text': staged_lines[ri],
                    'left_spans': [],
                    'right_spans': [],
                })
        else:
            hunk_idx = len(hunks)
            hunks.append({
                'index': hunk_idx,
                'tag': tag,
                'orig_start': i1,
                'orig_end': i2,
                'staged_start': j1,
                'staged_end': j2,
                'first_row': len(rows),
            })
            left_chunk = orig_lines[i1:i2]
            right_chunk = staged_lines[j1:j2]
            count = max(len(left_chunk), len(right_chunk))
            for k in range(count):
                has_l = k < len(left_chunk)
                has_r = k < len(right_chunk)
                l_text = left_chunk[k] if has_l else ''
                r_text = right_chunk[k] if has_r else ''
                l_spans, r_spans = ([], [])
                if has_l and has_r:
                    l_spans, r_spans = compute_intraline_spans(l_text, r_text)
                rows.append({
                    'kind': tag,
                    'hunk_index': hunk_idx,
                    'left_lineno': (i1 + k + 1) if has_l else None,
                    'left_text': l_text if has_l else None,
                    'right_lineno': (j1 + k + 1) if has_r else None,
                    'right_text': r_text if has_r else None,
                    'left_spans': l_spans,
                    'right_spans': r_spans,
                })
    return rows, hunks


def build_unified_rows(orig_lines, staged_lines):
    matcher = difflib.SequenceMatcher(None, orig_lines, staged_lines)
    rows = []
    hunks = []
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            for offset in range(i2 - i1):
                li = i1 + offset
                ri = j1 + offset
                rows.append({
                    'kind': 'equal',
                    'prefix': ' ',
                    'hunk_index': None,
                    'left_lineno': li + 1,
                    'right_lineno': ri + 1,
                    'text': orig_lines[li],
                    'left_text': orig_lines[li],
                    'right_text': staged_lines[ri],
                })
        else:
            hunk_idx = len(hunks)
            hunks.append({
                'index': hunk_idx,
                'tag': tag,
                'orig_start': i1,
                'orig_end': i2,
                'staged_start': j1,
                'staged_end': j2,
                'first_row': len(rows),
            })
            for li in range(i1, i2):
                rows.append({
                    'kind': 'delete',
                    'prefix': '-',
                    'hunk_index': hunk_idx,
                    'left_lineno': li + 1,
                    'right_lineno': None,
                    'text': orig_lines[li],
                    'left_text': orig_lines[li],
                    'right_text': None,
                })
            for ri in range(j1, j2):
                rows.append({
                    'kind': 'insert',
                    'prefix': '+',
                    'hunk_index': hunk_idx,
                    'left_lineno': None,
                    'right_lineno': ri + 1,
                    'text': staged_lines[ri],
                    'left_text': None,
                    'right_text': staged_lines[ri],
                })
    return rows, hunks


def file_line_delta(session, rel_path):
    orig = read_side_lines(session, rel_path, side='workspace')
    staged = read_side_lines(session, rel_path, side='staged')
    matcher = difflib.SequenceMatcher(None, orig, staged)
    added = 0
    removed = 0
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag in ('replace', 'delete'):
            removed += (i2 - i1)
        if tag in ('replace', 'insert'):
            added += (j2 - j1)
    return added, removed


class _TuiApplyContext:
    """Apply settings for TUI actions: the in-TUI prompt is the confirmation, and --force is never implied."""

    def __init__(self, ctx=None):
        self.args = argparse.Namespace(force=False, yes=True, no_merge=False, verbose=False, file=None, all=False)
        self._ctx = ctx

    def setting(self, key, default=None):
        return self._ctx.setting(key, default) if self._ctx is not None else default


def _join_line_pieces(pieces):
    """Join keepends lines, adding a newline where a final unterminated line is no longer last."""
    out = []
    for index, piece in enumerate(pieces):
        if index < len(pieces) - 1 and not piece.endswith(('\n', '\r')):
            piece += '\r\n' if any(p.endswith('\r\n') for p in pieces) else '\n'
        out.append(piece)
    return ''.join(out)


def apply_hunk(session, rel_path, hunk_index=0, ctx=None):
    """Apply one diff hunk of a staged file to the workspace, recording a backup for `staged undo`."""
    safe_path(session.staging, rel_path)
    if rel_path in session.deletions:
        raise StagedError('Cannot apply a single hunk of a full-file deletion; apply the file instead.')
    staged_file = safe_path(session.staging, rel_path)
    if not staged_file.is_file():
        raise StagedError('Missing staged file: {}'.format(rel_path))
    dest_file = safe_path(session.workspace, rel_path)
    if session.original(rel_path) != dest_file:
        raise StagedError('Hunks apply in place only; apply the whole file for a rename: ' + rel_path)
    guard_apply(_TuiApplyContext(ctx), session)
    try:
        orig_raw = dest_file.read_bytes().decode('utf-8') if dest_file.is_file() else ''
        staged_raw = staged_file.read_bytes().decode('utf-8')
    except UnicodeDecodeError:
        raise StagedError('Hunk apply needs UTF-8 text; apply the whole file instead: ' + rel_path) from None

    hunks = compute_diff_hunks(orig_raw.splitlines(), staged_raw.splitlines())
    if not hunks:
        return False
    if hunk_index < 0 or hunk_index >= len(hunks):
        raise StagedError('Hunk index {} out of range (0..{}).'.format(hunk_index, len(hunks) - 1))
    hunk = hunks[hunk_index]
    # Keep each line's own terminator so CRLF files and a missing final newline survive the splice.
    orig_keep = orig_raw.splitlines(keepends=True)
    staged_keep = staged_raw.splitlines(keepends=True)
    content = _join_line_pieces(orig_keep[:hunk['orig_start']]
                                + staged_keep[hunk['staged_start']:hunk['staged_end']]
                                + orig_keep[hunk['orig_end']:])
    backup_id, bdir, entries = begin_backup(session, [rel_path])
    mode = file_mode(dest_file) if dest_file.is_file() else file_mode(staged_file)
    write_bytes_atomic(dest_file, content.encode('utf-8'), mode=mode)
    finish_backup(session, backup_id, bdir, entries)
    session.refresh_index()
    return True


def apply_file_from_tui(session, rel_path, ctx=None):
    """Apply one proposed file with the same checks, merge and undo backup as `staged apply -f`."""
    output = io.StringIO()
    stdout = sys.stdout
    sys.stdout = output  # apply_changes reports on stdout; curses owns the screen.
    try:
        apply_changes(_TuiApplyContext(ctx), session, rel_path)
    finally:
        sys.stdout = stdout
    lines = [line for line in output.getvalue().splitlines() if line.strip()]
    status = re.sub(r'\x1b\[[0-9;]*m', '', lines[-1]).split(']')[0].lstrip('[').strip() if lines else ''
    return status or session.status(rel_path)


