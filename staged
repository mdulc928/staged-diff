        'error': ('RED', None, ('A_REVERSE', 'A_BOLD')),
        'title': (None, None, ('A_BOLD',)), 'title_focus': ('CYAN', None, ('A_BOLD',)),
        'col': (None, None, ('A_DIM',)), 'col_active': ('CYAN', None, ('A_BOLD',)),
        'border': (None, None, ('A_DIM',)), 'gutter': (None, None, ('A_DIM',)), 'filler': (None, None, ('A_DIM',)),
        'dim': (None, None, ('A_DIM',)), 'key': ('YELLOW', None, ('A_BOLD',)),
        'add': ('GREEN', None, ()), 'add_em': ('GREEN', None, ('A_BOLD', 'A_REVERSE')),
        'add_gutter': ('GREEN', None, ('A_DIM',)), 'del_gutter': ('RED', None, ('A_DIM',)),
        'del': ('RED', None, ()), 'del_em': ('RED', None, ('A_BOLD', 'A_REVERSE')),
