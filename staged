    ('vscode', 'Visual Studio Code', 'code', ['-r', '-d'], ['-r']),
    ('pycharm', 'PyCharm', 'pycharm', ['diff'], []),
    ('zed', 'Zed', 'zed', ['--diff'], []),
]:
    TOOL_REGISTRY[key] = ToolAdapter(key, name, [command] + diff + ['{orig}', '{staged}'],
                                    [command] + opening + ['{staged}'])
for key, name in [('cli', 'Terminal'), ('codex', 'Codex'), ('claudecode', 'Claude Code')]:
    editor = shlex.split(os.environ.get('EDITOR', 'notepad' if os.name == 'nt' else 'vi'))
    TOOL_REGISTRY[key] = ToolAdapter(key, name, ['git', 'diff', '--no-index', '{orig}', '{staged}'], editor + ['{staged}'])


def run_editor(command, terminal=False):
    # Native .exe files need no shell. Batch launchers require cmd.exe on Windows.
    if os.name == 'nt' and command[0].lower().endswith(('.cmd', '.bat')):
        if any(any(ch in arg for ch in '\r\n%"&|<>^!') for arg in command):
            raise StagedError('Batch launcher cannot safely represent these arguments; use a native executable.')
        shell = subprocess.list2cmdline([os.environ.get('COMSPEC', 'cmd.exe')])
        quoted = ' '.join('"{}"'.format(arg) for arg in command)
        command = '{} /d /s /c "{}"'.format(shell, quoted)
    result = subprocess.run(command)
    if result.returncode not in ((0, 1) if terminal else (0,)):
        raise StagedError('Editor/diff command failed with exit code {}'.format(result.returncode))


def init_session(ctx, key, root=None):
    key = session_id(key)
    root = root or ctx.staging_root()
    try:
        root.relative_to(ctx.workspace)
    except ValueError:
        pass
    else:
        raise StagedError('Staging root must be outside the workspace: ' + str(root))
    directory = safe_path(root, key)
    if directory.exists():
        if not (directory / '.workspace').is_file():
            raise StagedError('Directory already exists without session metadata: ' + str(directory))
        session = Session(directory)
        if session.workspace != ctx.workspace:
            raise StagedError('Session belongs to a different workspace: ' + str(session.workspace))
        record_install('roots', str(root))
        return session
    (directory / 'staging').mkdir(parents=True)
    write_text_file(directory / '.workspace', str(ctx.workspace) + '\n')
    save_json(directory / 'session.json', {'id': key, 'branch': get_git_branch(ctx.workspace), 'created_at': time.time()})
    save_json(directory / 'renames.json', {})
    record_install('roots', str(root))
    return Session(directory)


def summary_text(value):
    # Keep multiline author input readable in terminal lists.
    return ' '.join(value.split()) or '(no summary yet)'


def show_session_summary(session, summaries):
    print('Session summary ({}): {}'.format(session.id, summary_text(summaries['session'])), flush=True)


def update_summary(session, args):
    summaries = session.summaries()
    if args.file is not None:
        safe_path(session.staging, args.file)
        if args.file not in session.paths(fresh=True):
            raise StagedError('No staged change at exact path: ' + args.file)
    if args.summary is not None and (args.file is None or not (args.message is not None or args.stdin or args.clear)):
        raise StagedError('--summary requires a file summary update with --file and --message, --stdin or --clear.')
    value = args.message
    if args.stdin:
        if sys.stdin.isatty():
            raise StagedError('--stdin requires piped or redirected input; use --message for inline content.')
        value = sys.stdin.read()
    changed = value is not None or args.clear
    if changed:
        value = '' if args.clear else value.strip()
        if args.file is None:
            summaries['session'] = value
        elif value:
            summaries['files'][args.file] = value
        else:
            summaries['files'].pop(args.file, None)
        if args.summary is not None:
            summaries['session'] = args.summary.strip()
        session.save_summaries(summaries)
    if args.json:
        print(json.dumps(summaries))
    elif changed:
        print('Updated summary: ' + (args.file or session.id))
    else:
        show_session_summary(session, summaries)
        paths = [args.file] if args.file is not None else session.paths()
        for rel in paths:
            print('  {}: {}'.format(rel, summary_text(summaries['files'].get(rel, ''))))


def overview(ctx, session):
    branch = get_git_branch(session.workspace)
    protected = ctx.setting('branch_protection', True) and is_branch_protected(branch, ctx.setting('protected_branches', DEFAULT_PROTECTED_BRANCHES))
    for label, value in [('Repository:', session.workspace), ('Active Session:', color(session.id, '36')),
                         ('Active Tool:', color(ctx.tool().name, '36')),
                         ('Git Branch:', color(branch or '(not a Git repository)', '31' if protected else '32')),
                         ('Staging:', session.staging)]:
        print('{} {}'.format(color('{:15}'.format(label), '1'), value))
    summaries = session.summaries() if ctx.args.verbose else None
    if summaries is not None:
        show_session_summary(session, summaries)
    paths = session.paths()
    if not paths:
        print('No staged changes yet.')
    for rel in paths:
        status = session.status(rel)
        print('  {} {}'.format(status_token(status, width=9), rel))
        if ctx.args.verbose:
            print('    Summary: {}'.format(summary_text(summaries['files'].get(rel, ''))))
            path = safe_path(session.staging, rel)
            print('    Staged:    {}'.format(path if path.exists() else '(deletion)'))
            print('    Workspace: {}'.format(session.original(rel)))
            if path.exists():
                print('    Size: {} bytes; modified: {}'.format(path.stat().st_size, time.ctime(path.stat().st_mtime)))
    session.refresh_index()


def review(ctx, session, target):
    tool = ctx.tool()
    terminal = tool.id in ('cli', 'codex', 'claudecode')
    summaries = session.summaries() if ctx.args.verbose else None
    if summaries is not None:
        show_session_summary(session, summaries)
    for rel in selected(session, target):
        if target is None and session.status(rel) == 'APPLIED':
            continue
        original = session.original(rel)
        proposed = safe_path(session.staging, rel)
        if rel not in session.deletions and not proposed.is_file():
            raise StagedError('Missing staged contents: ' + rel)
        # GUI launchers often return before opening tabs; keep the empty side on disk.
        empty = safe_path(session.directory, '.review/empty/' + rel)
        write_text_file(empty, '')
        left = original if original.is_file() else empty
        right = empty if rel in session.deletions else proposed
        print('Review {}: {}'.format(status_token(session.status(rel)), rel), flush=True)
        if summaries is not None:
            print('  Summary: {}'.format(summary_text(summaries['files'].get(rel, ''))), flush=True)
        run_editor(tool.get_diff_command(left, right), terminal)


def open_file(ctx, session, target):
    meta = ctx.args.meta
    paths = session.openable_paths(fresh=True, meta=meta)
    if not paths:
        raise StagedError('No {} files to open.'.format('metadata' if meta else 'staged'))
    aliases = {
        'staging': 'staged_changes.md',
        'staging.md': 'staged_changes.md',
        'staged': 'staged_changes.md',
        'staged.md': 'staged_changes.md',
        'diff': 'diff_viewer.md',
        'diff.md': 'diff_viewer.md',
    }
    resolved_query = target
    if meta and target not in paths and target.lower() in aliases and aliases[target.lower()] in paths:
        resolved_query = aliases[target.lower()]
    rel = match_file(resolved_query, paths)
    path = safe_path(session.directory if meta else session.staging, rel)
    if not path.is_file():
        raise StagedError('File does not exist: ' + str(path))
    tool = ctx.tool()
    print('Open: {}'.format(rel), flush=True)
    run_editor(tool.get_open_command(path))


def guard_apply(ctx, session):
    branch = get_git_branch(session.workspace)
    patterns = ctx.setting('protected_branches', DEFAULT_PROTECTED_BRANCHES)
    if ctx.setting('branch_protection', True) and is_branch_protected(branch, patterns):
        if not ctx.args.force:
            raise StagedError("Protected branch '{}'; switch branches or pass --force.".format(branch))
        print("Warning: applying to protected branch '{}' (--force).".format(branch), file=sys.stderr)
    origins = {session.metadata.get('branch')}
    origins.update(item.get('branch') for item in session.metadata.get('migrated_from', []))
    drifted = sorted(origin for origin in origins if origin and origin != branch)
    if drifted:
        confirm("Branch changed from '{}' to '{}'. Apply here?".format(', '.join(drifted), branch), ctx.args.yes)


def preflight(session, paths):
    files = session.files(fresh=True)
    destinations = set(paths) - set(session.deletions)
    all_destinations = set(files)
    if set(files) & set(session.deletions):
        raise StagedError('A path cannot be both a staged file and a deletion.')
    sources = []
    for rel in paths:
        dest = safe_path(session.workspace, rel)
        original = session.original(rel)
        if dest.exists() and not dest.is_file() or original.exists() and not original.is_file():
            raise StagedError('Apply requires regular file destinations: ' + rel)
        for parent in dest.parents:
            if parent == session.workspace:
                break
            if parent.exists() and not parent.is_dir():
                raise StagedError('Destination parent is a file: ' + str(parent))
        if rel not in session.deletions:
            if rel not in files:
                raise StagedError('Missing staged contents: ' + rel)
            old = session.manifest.get(rel, rel)
            if old != rel:
                if old in all_destinations or old in session.deletions:
                    raise StagedError('Overlapping rename/deletion sources require separate sessions: ' + old)
                sources.append(old)
    if len(sources) != len(set(sources)):
        raise StagedError('Multiple staged files cannot rename the same source.')
    for rel in destinations:
        if any(parent.as_posix() in destinations for parent in Path(rel).parents if str(parent) != '.'):
            raise StagedError('Conflicting staged file and directory: ' + rel)


def apply_changes(ctx, session, target):
    paths = selected(session, target)
    preflight(session, paths)
    guard_apply(ctx, session)
    for rel in paths:
        dest = safe_path(session.workspace, rel)
        old = session.original(rel)
        if rel in session.deletions:
            if dest.exists():
                dest.unlink()
            print(status_token('DELETED') + ' ' + rel)
        else:
            copy_atomic(safe_path(session.staging, rel), dest)
            if old != dest and old.is_file():
                old.unlink()
            print(status_token('APPLIED') + ' ' + rel)
    session.refresh_index()


def clean_session(ctx, session):
    if getattr(ctx.args, 'clean_session', None) is not None:
        target_session = session
        paths = target_session.paths(fresh=True)
        if any(target_session.status(rel) != 'APPLIED' for rel in paths):
            confirm("Discard session '{}' with {} pending change(s)?".format(target_session.id, len(paths)), ctx.args.yes)
        else:
            confirm("Discard session '{}'?".format(target_session.id), ctx.args.yes)
        for shell_path in sorted(ctx.shell_path.parent.glob('*.json')):
            if shell_path.is_symlink() or not shell_path.is_file():
                continue
            shell = load_json(shell_path)
            if shell.get('session') == target_session.id:
                shell.pop('session')
                if shell_path != ctx.shell_path:
                    shell['deleted_session'] = target_session.id
                if shell:
                    save_json(shell_path, shell)
                else:
                    shell_path.unlink()
        if ctx.local.get('default_session') == target_session.id:
            ctx.local.pop('default_session', None)
            local_path = ctx.workspace / '.staged.json'
            if ctx.local:
                save_json(local_path, ctx.local)
            elif local_path.exists():
                local_path.unlink()
        if ctx.global_state.get('default_session') == target_session.id:
            ctx.global_state.pop('default_session', None)
            if ctx.global_state:
                save_json(GLOBAL_STATE_FILE, ctx.global_state)
            elif GLOBAL_STATE_FILE.exists():
                GLOBAL_STATE_FILE.unlink()
        shutil.rmtree(target_session.directory)
        print('Cleaned session {}.'.format(target_session.id))
        return

    target = ctx.args.file
    paths = selected(session, target)
    summaries = session.summaries()
    if any(session.status(rel) != 'APPLIED' for rel in paths):
        confirm('Discard {} pending staged change(s) from {}?'.format(len(paths), session.id), ctx.args.yes)
    for rel in paths:
        path = safe_path(session.staging, rel)
        if path.is_file():
            path.unlink()
        session.manifest.pop(rel, None)
        session.deletions[:] = [p for p in session.deletions if p != rel]
    if target is None:
        session.manifest = {}
        session.deletions = []
    elif '_deletions' in session.manifest:
        session.manifest['_deletions'] = session.deletions
    session.save_manifest()
    for rel in paths:
        summaries['files'].pop(rel, None)
    if target is None or not session.paths(fresh=True):
        summaries['session'] = ''
    if (session.directory / 'summaries.json').exists():
        session.save_summaries(summaries)
    session.refresh_index()
    print('Cleaned {} staged change(s);'.format(len(paths)))


def cross_diff(ctx):
    if ctx.args.apply or getattr(ctx.args, 'clean', False):
        raise StagedError('Cross-session comparison cannot be combined with --apply or --clean.')
    if ctx.args.between:
        left, right = (ctx.find_session(key) for key in ctx.args.between)
    else:
        left, right = ctx.active(), ctx.find_session(ctx.args.compare_session)
    common = sorted(set(left.files(fresh=True)) & set(right.files(fresh=True)))
    paths = common if ctx.args.file is None else [match_file(ctx.args.file, common)]
    if not paths:
        raise StagedError('No common staged files in the two sessions.')
    tool = ctx.tool()
    summaries = [(s, s.summaries()) for s in (left, right)] if ctx.args.verbose else []
    for session, data in summaries:
        show_session_summary(session, data)
    for rel in paths:
        for session, data in summaries:
            print('  {} [{}]: {}'.format(rel, session.id, summary_text(data['files'].get(rel, ''))), flush=True)
        run_editor(tool.get_diff_command(safe_path(left.staging, rel), safe_path(right.staging, rel)),
                   tool.id in ('cli', 'codex', 'claudecode'))


def migrate(ctx):
    source = ctx.find_session(ctx.args.source)
    if ctx.args.to:
        try:
            dest = ctx.find_session(ctx.args.to)
        except StagedError as exc:
            if not str(exc).startswith('Unknown session:'):
                raise
            dest = init_session(ctx, ctx.args.to)
    else:
        dest = ctx.active()
    if source.directory == dest.directory:
        raise StagedError('Migration needs two different sessions.')
    if ctx.args.file and any(ch in ctx.args.file for ch in '*?['):
        paths = [p for p in source.paths(fresh=True) if fnmatch.fnmatchcase(p, ctx.args.file)]
        if not paths:
            raise StagedError('No staged files matched migration pattern: ' + ctx.args.file)
    else:
        paths = selected(source, ctx.args.file)
    preflight(source, paths)
    source_summaries, dest_summaries = source.summaries(), dest.summaries()
    copy_session_summary = not dest.paths() and set(paths) == set(source.paths()) and not dest_summaries['session']
    # Validate the entire transfer before changing any destination files or manifest.
    conflicts = []
    manifest = dict(dest.manifest)
    deletions = set(dest.deletions)
    for rel in paths:
        incoming = safe_path(source.staging, rel)
        existing = safe_path(dest.staging, rel)
        old = source.original(rel)
        if existing.exists() and not existing.is_file():
            raise StagedError('Migration destination is not a regular file: ' + rel)
        for parent in existing.parents:
            if parent == dest.staging:
                break
            if parent.exists() and not parent.is_dir():
                raise StagedError('Migration destination parent is a file: ' + str(parent))
        if existing.exists() or rel in dest.deletions:
            conflicts.append('target already contains ' + rel)
        if rel not in source.deletions and old.exists() and old.stat().st_mtime_ns > incoming.stat().st_mtime_ns and not equal_files(old, incoming):
            conflicts.append('workspace is newer than ' + rel)
        if rel in source.deletions:
            deletions.add(rel)
            manifest.pop(rel, None)
        else:
            deletions.discard(rel)
            if rel in source.manifest:
                manifest[rel] = source.manifest[rel]
            else:
                manifest.pop(rel, None)
    resulting_files = (set(dest.files()) | (set(paths) - set(source.deletions))) - deletions
    for rel in resulting_files:
        if any(parent.as_posix() in resulting_files for parent in Path(rel).parents if str(parent) != '.'):
            raise StagedError('Migration creates conflicting file and directory: ' + rel)
    rename_sources = [old for rel, old in manifest.items() if rel != '_deletions' and rel in resulting_files and old != rel]
    if len(rename_sources) != len(set(rename_sources)) or set(rename_sources) & (resulting_files | deletions):
        raise StagedError('Migration creates overlapping rename or deletion operations.')
    if conflicts and not ctx.args.force:
        raise StagedError('Migration requires review; use --force to replace:\n  ' + '\n  '.join(conflicts))
    if conflicts:
        print('Warning: ' + '; '.join(conflicts), file=sys.stderr)
    for rel in paths:
        target = safe_path(dest.staging, rel)
        if rel in source.deletions:
            if target.is_file():
                target.unlink()
        else:
            copy_atomic(safe_path(source.staging, rel), target)
    if deletions:
        manifest['_deletions'] = sorted(deletions)
    else:
        manifest.pop('_deletions', None)
    dest.manifest, dest.deletions = manifest, sorted(deletions)
    dest.save_manifest()
    for rel in paths:
        if rel in source_summaries['files']:
            dest_summaries['files'][rel] = source_summaries['files'][rel]
        else:
            dest_summaries['files'].pop(rel, None)
    if copy_session_summary:
        dest_summaries['session'] = source_summaries['session']
    if any((s.directory / 'summaries.json').exists() for s in (source, dest)):
        dest.save_summaries(dest_summaries)
    if not dest.metadata.get('migrated_from'):
        dest.metadata['migrated_from'] = []
    dest.metadata['migrated_from'].append({'session': source.id, 'branch': source.metadata.get('branch'), 'paths': paths})
    save_json(dest.directory / 'session.json', dest.metadata)
    dest.refresh_index()
    print('Migrated {} change(s) from {} to {}.'.format(len(paths), source.id, dest.id))
def detect_jetbrains_binary():
    """Resolve PyCharm's documented launchers, without selecting another IDE."""
    names = ['pycharm']
    if sys.platform == 'win32':
        names += ['pycharm64.exe', 'pycharm.bat']
    elif sys.platform.startswith('linux'):
        names += ['pycharm.sh', 'pycharm-professional', 'pycharm-community']
    for name in names:
        found = shutil.which(name)
        if found:
            return found
    if sys.platform == 'win32':
        toolbox_dirs = [Path(os.environ.get('LOCALAPPDATA', str(Path(HOME) / 'AppData/Local'))) / 'JetBrains/Toolbox/scripts']
    elif sys.platform == 'darwin':
        toolbox_dirs = [Path(HOME) / 'Library/Application Support/JetBrains/Toolbox/scripts']
    else:
        toolbox_dirs = [Path(HOME) / '.local/share/JetBrains/Toolbox/scripts']
    for toolbox in toolbox_dirs:
        for name in names:
            script = toolbox / name
            if script.is_file():
                return str(script)
    if sys.platform == 'darwin':
        for parent in (Path('/Applications'), Path(HOME) / 'Applications'):
            matches = sorted(parent.glob('PyCharm*.app/Contents/MacOS/pycharm'))
            if matches:
                return str(matches[0])
    return None

def upsert_shell_block(path, block, insert_before_compinit=False, move_to_end=False):
    block = block.strip() + "\n"
    if os.path.isfile(path):
        with open(path, "r", encoding="utf-8") as f:
            content = f.read()
        pattern = re.compile(
            re.escape(COMPLETION_MARKER_START) + r".*?" + re.escape(COMPLETION_MARKER_END),
            re.DOTALL,
        )
        if pattern.search(content):
            if move_to_end:
                content = pattern.sub('', content).rstrip() + '\n\n' + block
            else:
                content = pattern.sub(lambda match: block.strip(), content)
        elif insert_before_compinit:
            lines = content.splitlines(keepends=True)
            insert_at = None
            for idx, line in enumerate(lines):
                if re.search(r"\bcompinit\b", line) and not line.lstrip().startswith("#"):
                    insert_at = idx
                    break
            if insert_at is not None:
                lines.insert(insert_at, block)
                content = "".join(lines)
            else:
                content = block + ("\n" if content and not content.startswith("\n") else "") + content
        else:
            if content and not content.endswith("\n"):
                content += "\n"
            content += "\n" + block
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
    else:
        with open(path, "w", encoding="utf-8") as f:
            f.write(block)



def nonnegative(value):
    try:
        number = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError('expected a non-negative integer')
    if number < 0:
        raise argparse.ArgumentTypeError('expected a non-negative integer')
    return number


def positive(value):
    number = nonnegative(value)
    if number == 0:
        raise argparse.ArgumentTypeError('line numbers start at 1')
    return number


def content_hash(stream):
    stream.seek(0)
    digest = hashlib.sha256()
    for block in iter(lambda: stream.read(1024 * 1024), b''):
        digest.update(block)
    stream.seek(0)
    return digest.hexdigest()


def file_version(path):
    if not path.exists():
        return None
    info = path.stat()
    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)


def range_path(session, relative, workspace=False):
    # File APIs deliberately use exact paths rather than interactive fuzzy matching.
    root = session.workspace if workspace else session.staging
    if not workspace:
        try:
            root.resolve().relative_to(session.workspace.resolve())
        except ValueError:
            pass
        else:
            raise StagedError('Staging must reside outside the workspace.')
    path = safe_path(root, relative)
    for candidate in [path] + list(path.parents):
        attributes = getattr(candidate.lstat(), 'st_file_attributes', 0) if candidate.exists() else 0
        if attributes & getattr(stat, 'FILE_ATTRIBUTE_REPARSE_POINT', 0):
            raise StagedError('Reparse points are not supported: ' + str(candidate))
        if candidate == root:
            break
    if path.exists() and not path.is_file():
        raise StagedError('Expected a regular file: ' + relative)
    return path


def unused_staged_path(session, relative, moving=None):
    target = range_path(session, relative)
    if target.exists() or relative in session.paths(fresh=True):
        raise StagedError('Staged destination already exists or has a pending operation: ' + relative)
    if relative in [old for rel, old in session.manifest.items() if rel not in ('_deletions', moving)]:
        raise StagedError('Destination is the source of a pending rename: ' + relative)
    for parent in target.parents:
        if parent == session.staging:
            break
        if parent.exists() and not parent.is_dir():
            raise StagedError('Destination parent is not a directory: ' + str(parent))
    return target


def delete_file(session, args):
    target = range_path(session, args.file)
    safe_path(session.directory, 'renames.json')
    summaries = session.summaries()
    if args.workspace:
        original = range_path(session, args.file, workspace=True)
        if not original.is_file():
            raise StagedError('Workspace file does not exist: ' + args.file)
        rename_sources = [old for rel, old in session.manifest.items() if rel != '_deletions']
        if args.file in session.manifest or args.file in rename_sources:
            raise StagedError('Discard the overlapping rename proposal before proposing deletion: ' + args.file)
    elif args.file not in session.paths(fresh=True):
        raise StagedError('No staged proposal at exact path: ' + args.file)
    if target.exists():
        target.unlink()
    session.manifest.pop(args.file, None)
    deletions = set(session.deletions)
    if args.workspace:
        deletions.add(args.file)
    else:
        deletions.discard(args.file)
    session.deletions = sorted(deletions)
    if deletions:
        session.manifest['_deletions'] = session.deletions
    else:
        session.manifest.pop('_deletions', None)
    session.save_manifest()
    summaries['files'].pop(args.file, None)
    if not session.paths(fresh=True):
        summaries['session'] = ''
    if (session.directory / 'summaries.json').exists():
        session.save_summaries(summaries)
    if args.json:
        print(json.dumps({'operation': 'delete', 'path': args.file,
                          'mode': 'propose' if args.workspace else 'discard'}))
    else:
        print(('Proposed workspace deletion: ' if args.workspace else 'Discarded staged proposal: ') + args.file)


def file_operation(session, args):
    # All paths are exact, all destinations are staged, and metadata is checked
    # before any proposal is changed. These APIs never imply permission to apply.
    safe_path(session.directory, 'renames.json')
    summaries = session.summaries()
    command = args.command
    source = None
    if command == 'create':
        destination = args.file
    else:
        source = range_path(session, args.file, command == 'copy' and args.workspace)
        if not source.is_file():
            raise StagedError('Source file does not exist: ' + args.file)
        if not (command == 'copy' and args.workspace) and args.file in session.deletions:
            raise StagedError('Source file is marked for deletion: ' + args.file)
        destination = args.to or args.file
    target = unused_staged_path(session, destination, args.file if command == 'rename' else None)
    if source is not None and source == target:
        raise StagedError('Source and destination must differ.')
    manifest = dict(session.manifest)
    if command == 'rename':
        original = manifest.pop(args.file, args.file)
        # A newly created proposal has no workspace source to rename. Existing
        # proposals retain their original source, including across repeated moves.
        original_path = range_path(session, original, workspace=True)
        if original != destination and (original_path.is_file() or args.file in session.manifest):
            manifest[destination] = original
        resulting = (set(session.files(fresh=True)) - {args.file}) | {destination}
        sources = [old for rel, old in manifest.items() if rel != '_deletions' and rel != old]
        if len(sources) != len(set(sources)) or set(sources) & (resulting | set(session.deletions)):
            raise StagedError('Rename would overlap another staged operation.')
        # Do not silently replace an unrelated workspace file on later apply.
        workspace_destination = range_path(session, destination, workspace=True)
        if workspace_destination.exists() and destination != original:
            raise StagedError('Rename destination already exists in the workspace: ' + destination)
    if command == 'create' and args.stdin and sys.stdin.isatty():
        raise StagedError('--stdin requires piped or redirected input; use --text for inline content.')
    before = file_version(source) if source is not None else None
    target.parent.mkdir(parents=True, exist_ok=True)
    if command == 'rename':
        unused_staged_path(session, destination, args.file)
        range_path(session, args.file)
        if file_version(source) != before:
            raise StagedError('Source changed; retry the operation.')
        os.link(source, target)
        try:
            source.unlink()
        except OSError:
            target.unlink()
            raise
        session.manifest = manifest
        session.save_manifest()
        previous = summaries['files'].pop(args.file, None)
        summaries['files'].pop(destination, None)
        if previous is not None:
            summaries['files'][destination] = previous
    else:
        descriptor, temporary = tempfile.mkstemp(prefix='.staged-file-', dir=str(target.parent))
        try:
            with os.fdopen(descriptor, 'wb') as output:
                if source is not None:
                    with source.open('rb') as stream:
                        shutil.copyfileobj(stream, output, 1024 * 1024)
                elif args.stdin:
                    shutil.copyfileobj(sys.stdin.buffer, output, 1024 * 1024)
                else:
                    output.write((args.text or '').encode('utf-8'))
            if source is not None:
                os.chmod(temporary, stat.S_IMODE(source.stat().st_mode))
                range_path(session, args.file, args.workspace)
                if file_version(source) != before:
                    raise StagedError('Source changed while copying; retry the operation.')
            unused_staged_path(session, destination)
            # Publish without replacing a concurrently created destination.
            os.link(temporary, target)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        summaries['files'].pop(destination, None)
    if (session.directory / 'summaries.json').exists():
        session.save_summaries(summaries)
    if args.json:
        with target.open('rb') as stream:
            digest = content_hash(stream)
        result = {'operation': command, 'path': destination, 'size': target.stat().st_size, 'sha256': digest}
        if source is not None:
            result.update(source=args.file, source_root='workspace' if command == 'copy' and args.workspace else 'staged')
        print(json.dumps(result))
    else:
        print('{} staged file: {}'.format({'create': 'Created', 'copy': 'Copied', 'rename': 'Renamed'}[command], destination))


def selected_range(stream, args, writing=False):
    stream.seek(0, os.SEEK_END)
    size = stream.tell()
    if args.start_line is not None:
        # Lines are LF-delimited bytes; preserve CRLF and unterminated final lines.
        stream.seek(0)
        line = 1
        while line < args.start_line:
            if not stream.readline():
                raise StagedError('Start line is past the end of the file.')
            line += 1
        start = stream.tell()
        if writing and args.end_line is None:
            return start, start, size  # Insert before the requested line (EOF allowed).
        if args.end_line is None:
            return start, size, size
        for _ in range(args.end_line - args.start_line + 1):
            if not stream.readline():
                raise StagedError('End line is past the end of the file.')
        return start, stream.tell(), size
    if writing and args.append:
        return size, size, size
    start = args.offset if args.offset is not None else 0
    count = args.delete_count if writing else args.length
    if writing and args.offset is None:
        return 0, size, size  # No range means replace the complete file.
    if writing:
        end = start + (count or 0)
    else:
        end = min(size, start + count) if count is not None else size
    if start > size or end > size:
        raise StagedError('Byte range is past the end of the file.')
    return start, end, size


def copy_bytes(source, target, count):
    while count:
        block = source.read(min(count, 1024 * 1024))
        if not block:
            raise StagedError('File changed while reading; retry the operation.')
        target.write(block)
        count -= len(block)


def read_file_range(session, args):
    path = range_path(session, args.file, args.workspace)
    before = file_version(path)
    if before is None:
        raise StagedError('File does not exist: ' + args.file)
    with path.open('rb') as stream:
        start, end, size = selected_range(stream, args)
        if args.json:
            digest = content_hash(stream)
            stream.seek(start)
            data = stream.read(end - start)
            try:
                content, encoding = data.decode('utf-8'), 'utf-8'
            except UnicodeDecodeError:
                content, encoding = base64.b64encode(data).decode('ascii'), 'base64'
            if file_version(path) != before or len(data) != end - start:
                raise StagedError('File changed while reading; retry the operation.')
            print(json.dumps({'path': args.file, 'source': 'workspace' if args.workspace else 'staged',
                              'offset': start, 'length': len(data), 'size': size, 'sha256': digest,
                              'encoding': encoding, 'content': content, 'next_offset': end, 'eof': end == size}))
        else:
            stream.seek(start)
            copy_bytes(stream, sys.stdout.buffer, end - start)


def write_file_range(session, args):
    target = range_path(session, args.file)
    if args.file in session.deletions:
        raise StagedError('File is marked for deletion; remove its deletion entry before writing.')
    before = file_version(target)
    source = target
    if args.from_workspace:
        if before is not None:
            raise StagedError('A staged file already exists; omit --from-workspace to edit it.')
        source = range_path(session, args.file, workspace=True)
        if not source.is_file():
            raise StagedError('Workspace source does not exist: ' + args.file)
    source_version = file_version(source)
    # Keep the source open while streaming the replacement into a temporary file.
    original = source.open('rb') if source_version is not None else io.BytesIO()
    with original:
        if args.expect_sha256 and content_hash(original) != args.expect_sha256.lower():
            raise StagedError('File content changed: SHA-256 does not match; read again before writing.')
        start, end, size = selected_range(original, args, writing=True)
        if args.stdin and sys.stdin.isatty():
            raise StagedError('--stdin requires piped or redirected input; use --text for inline content.')
        mode = stat.S_IMODE(source.stat().st_mode) if source_version is not None else None
        target.parent.mkdir(parents=True, exist_ok=True)
        descriptor, temporary = tempfile.mkstemp(prefix='.staged-write-', dir=str(target.parent))
        try:
            with os.fdopen(descriptor, 'wb') as output:
                original.seek(0)
                copy_bytes(original, output, start)
                if args.stdin:
                    shutil.copyfileobj(sys.stdin.buffer, output, 1024 * 1024)
                else:
                    output.write(args.text.encode('utf-8'))
                original.seek(end)
                copy_bytes(original, output, size - end)
            if mode is not None:
                os.chmod(temporary, mode)
            # Catch changes during input collection as well as stale caller hashes.
            range_path(session, args.file)
            if file_version(target) != before or file_version(source) != source_version:
                raise StagedError('File changed while writing; read again before retrying.')
            # Close the source before replacing it, including on Windows.
            original.close()
            os.replace(temporary, target)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    if args.json:
        with target.open('rb') as result:
            digest = content_hash(result)
        print(json.dumps({'path': args.file, 'size': target.stat().st_size, 'sha256': digest,
                          'created': before is None, 'from_workspace': args.from_workspace}))
    else:
        print('Wrote staged file: ' + args.file)


def validate_file_range_args(parser, args):
    if args.start_line is not None and (args.offset is not None or getattr(args, 'length', None) is not None
                                       or getattr(args, 'delete_count', None) is not None or getattr(args, 'append', False)):
        parser.error('line ranges cannot be combined with byte ranges or --append')
    if args.end_line is not None and (args.start_line is None or args.end_line < args.start_line):
        parser.error('--end-line requires --start-line and must not precede it')
    if args.command == 'write':
        if args.delete_count is not None and args.offset is None:
            parser.error('--delete-count requires --offset')
        if args.append and args.offset is not None:
            parser.error('--append cannot be combined with --offset')
        if args.expect_sha256 and not re.fullmatch('[0-9a-fA-F]{64}', args.expect_sha256):
            parser.error('--expect-sha256 requires a 64-character hexadecimal digest')


def make_parser():
    def globals_on(parser, path_command=False, clean_command=False):
        parser.add_argument('-t', '--tool', default=argparse.SUPPRESS, help='editor adapter ID')
        if not clean_command:
            flags = ['--session'] if path_command else ['-s', '--session']
            parser.add_argument(*flags, default=argparse.SUPPRESS, help='session ID or unique prefix')
        parser.add_argument('--root', default=argparse.SUPPRESS, help='staging root (outside the workspace)')
        parser.add_argument('--shell', choices=['bash', 'zsh', 'powershell'], default=argparse.SUPPRESS,
                            help='shell for setup; powershell offers an optional Windows launcher')
        parser.add_argument('-v', '--verbose', action='store_true', default=argparse.SUPPRESS, help='include session/file summaries in diff and overview, plus overview paths, sizes and timestamps')
    parser = argparse.ArgumentParser(
        prog='staged', description=__doc__,
        epilog='Run staged <command> --help for command options, or staged --help-all for the full reference. '
               'Use --sessions to list sessions; --session <id> selects one.')
    parser.set_defaults(tool=None, session=None, root=None, verbose=False, clean_session=None, shell=None)
    globals_on(parser)
    parser.add_argument('-R', '--all-repos', action='store_true', help='list sessions across repositories')
    parser.add_argument('--help-all', action='store_true', help='show help for every command')
    parser.add_argument('--sessions', action='store_true', help='list sessions for this repository')
    parser.add_argument('--list', action='store_true', help='print proposed file paths, one per line')
    for helper in ('--complete', '--complete-sessions', '--complete-tools', '--complete-open', '--complete-meta', '--complete-options'):
        parser.add_argument(helper, action='store_true', help=argparse.SUPPRESS)
    subs = parser.add_subparsers(dest='command')
    command_parsers = {}
    descriptions = {
        'read': 'Read exact file ranges from staging or the workspace.',
        'write': 'Write or splice file contents inside staging only.',
        'create': 'Create a new staged file without replacing an existing proposal.',
        'copy': 'Copy a staged or workspace file to a new staged destination.',
        'rename': 'Rename a staged file and maintain its proposal metadata.',
        'delete': 'Discard a staged proposal, or record a workspace deletion for later apply.',
        'summarize': 'Read or update concise session and file change summaries.',
        'init': 'Create an isolated session and record its workspace and branch.',
        'diff': 'Review proposed files, apply with -a, clean with -c, or apply then clean with -ac.',
        'apply': 'Apply proposed files, renames and deletions to the workspace.',
        'clean': 'Discard staged proposals without changing the workspace.',
        'path': 'Print a raw absolute staged or workspace path.',
        'open': 'Open a staged proposed file or session file in your editor.',
        'use': 'Bind a session or tool to the current shell.',
        'set': 'Set persistent preferences.',
        'set-tool': 'Register a custom editor using argument templates.',
        'migrate': 'Copy proposals between sessions, checking for stale conflicts.',
        'install-skill': 'Install /stage for an agent harness.',
        'install-completion': 'Install shell completions for bash, zsh, or powershell.',
        'install-launcher': 'Install the standalone Windows command launcher (PATH unchanged).',
        'uninstall': 'Remove installed integrations and CLI; optionally delete all known sessions.',
    }
    for name in COMMANDS:
        command = subs.add_parser(name, description=descriptions[name], help=descriptions[name])
        globals_on(command, name == 'path', name == 'clean')
        command_parsers[name] = command
    for name in ('diff', 'apply', 'clean', 'migrate', 'path', 'open'):
        selection = command_parsers[name].add_mutually_exclusive_group(required=name != 'diff')
        selection.add_argument('-f', '--file', help='select one file (migration also accepts a quoted glob)')
        if name in ('diff', 'apply', 'clean', 'migrate'):
            selection.add_argument('--all', action='store_true', help='select all proposed changes')
        if name == 'clean':
            selection.add_argument('-s', '--session', nargs='?', const=True, dest='clean_session', default=argparse.SUPPRESS,
                                   metavar='id', help='discard the entire session directory (active session when omitted)')
    for name in ('read', 'write'):
        p = command_parsers[name]
        p.add_argument('-f', '--file', required=True, help='exact relative file path (no fuzzy matching)')
        p.add_argument('--offset', type=nonnegative, help='zero-based byte offset')
        p.add_argument('--start-line', type=positive, help=('one-based first line to read' if name == 'read'
                       else 'one-based first line; without --end-line, insert before it'))
        p.add_argument('--end-line', type=positive, help=('inclusive last line (default: EOF)' if name == 'read'
                       else 'inclusive last line to replace'))
        p.add_argument('--json', action='store_true', help='print structured output including the full-file SHA-256')
    p = command_parsers['read']
    p.add_argument('--workspace', action='store_true', help='read the workspace original instead of staging')
    p.add_argument('--length', type=nonnegative, help='maximum number of bytes to read (default: through EOF)')
    p = command_parsers['write']
    payload = p.add_mutually_exclusive_group(required=True)
    payload.add_argument('--stdin', action='store_true', help='read replacement bytes from standard input')
    payload.add_argument('--text', help='replacement UTF-8 text; empty text is allowed')
    p.add_argument('--delete-count', type=nonnegative, help='bytes to replace at --offset (default: 0, insert)')
    p.add_argument('--append', action='store_true', help='append input bytes at EOF')
    p.add_argument('--from-workspace', action='store_true', help='seed a missing staged file from the workspace before editing')
    p.add_argument('--expect-sha256', help='reject the edit if the full source file hash differs')
    for name in ('create', 'copy', 'rename', 'delete'):
        p = command_parsers[name]
        p.add_argument('-f', '--file', required=True, help='exact relative file path (no fuzzy matching)')
        p.add_argument('--json', action='store_true', help='print structured operation results')
    command_parsers['delete'].add_argument('--workspace', action='store_true', help='record a workspace deletion for later apply; never delete the workspace file now')
    p = command_parsers['create']
    payload = p.add_mutually_exclusive_group()
    payload.add_argument('--text', help='initial UTF-8 contents (default: empty file)')
    payload.add_argument('--stdin', action='store_true', help='read initial bytes from standard input')
    p = command_parsers['copy']
    p.add_argument('--workspace', action='store_true', help='read the source from the real workspace; destination stays in staging')
    p.add_argument('--to', help='new staged destination path (default: source path)')
    command_parsers['rename'].add_argument('--to', required=True, help='new staged destination path')
    p = command_parsers['summarize']
    p.add_argument('-f', '--file', help='exact proposed path; use rename destination or deleted original path')
    payload = p.add_mutually_exclusive_group()
    payload.add_argument('-m', '--message', help='summary text, usually one sentence and at most three')
    payload.add_argument('--stdin', action='store_true', help='read summary text from standard input')
    payload.add_argument('--clear', action='store_true', help='clear the selected session or file summary')
    p.add_argument('--summary', help='update the session summary alongside a file summary')
    p.add_argument('--json', action='store_true', help='print the complete structured summaries object')
    p = command_parsers['init']
    p.add_argument('id', nargs='?', help='conversation ID; generates a UUID when omitted')
    p.add_argument('--json', action='store_true', help='print machine-readable session paths')
    p = command_parsers['diff']
    p.add_argument('-a', '--apply', action='store_true', help='apply proposed changes before any requested clean')
    p.add_argument('-c', '--clean', action='store_true', help='clean proposed changes; with --apply, clean only after apply succeeds')
    comparison = p.add_mutually_exclusive_group()
    comparison.add_argument('--between', nargs=2, metavar=('SESSION1', 'SESSION2'), help='compare proposed files in two sessions')
    comparison.add_argument('--compare-session', help='compare the active session with another session')
    for name in ('diff', 'apply'):
        command_parsers[name].add_argument('--force', action='store_true', help='allow protected-branch apply')
        command_parsers[name].add_argument('-y', '--yes', action='store_true', help='confirm branch drift or clean')
    p = command_parsers['clean']
    p.add_argument('-y', '--yes', action='store_true', help='confirm discarding proposed changes')
    p = command_parsers['path']
    group = p.add_mutually_exclusive_group()
    group.add_argument('-s', '--staged', action='store_true', help='print proposed-file path (default)')
    group.add_argument('-w', '--workspace', action='store_true', help='print the original workspace path')
    p = command_parsers['open']
    p.add_argument('--meta', action='store_true', help='open an editable session metadata file instead of a proposed file')
    p = command_parsers['use']
    p.add_argument('id', nargs='?', help='session ID or unique prefix to bind to this shell')
    p.add_argument('--clear', action='store_true', help='clear current shell session and tool bindings')
    p = command_parsers['set']
    p.add_argument('--default', action='store_true', help='global preferences (the default)')
    p.add_argument('--repo', action='store_true', help='save in this workspace .staged.json')
    p.add_argument('--default-session', help='session ID or unique prefix to use by default')
    p.add_argument('--branch-protection', choices=['true', 'false'], help='enable or disable protected-branch apply checks')
    p.add_argument('--protected-branch', action='append', help='replace protected patterns (default: none); repeat for each pattern')
    p.add_argument('--session-root', action='append', help='additional discovery root; repeat for each root')
    p = command_parsers['set-tool']
    p.add_argument('id', help='ID for the custom editor adapter')
    p.add_argument('--name', required=True, help='display name for the editor')
    p.add_argument('--diff-cmd', required=True, help='diff command template with {orig} and {staged} placeholders')
    p.add_argument('--open-cmd', required=True, help='open command template with a {staged} placeholder')
    p = command_parsers['migrate']
    p.add_argument('--from', dest='source', required=True, help='source session ID or unique prefix')
    p.add_argument('--to', help='existing session or new session ID')
    p.add_argument('--force', action='store_true', help='replace target proposals despite conflicts')
    p = command_parsers['install-skill']
    p.add_argument('--default', action='store_true', help='install in the user-level skill directory (default)')
    p.add_argument('--target-dir', help='explicit directory containing the installed SKILL.md')
    p.add_argument('--configure-sandbox', action='store_true', help='merge staging-root permissions where supported')
    p = command_parsers['uninstall']
    p.add_argument('-y', '--yes', action='store_true', help='confirm uninstall (does not opt into session deletion)')
    group = p.add_mutually_exclusive_group()
    group.add_argument('--remove-sessions', action='store_true', help='delete sessions across all known roots and repositories')
    group.add_argument('--keep-sessions', action='store_true', help='keep sessions without prompting')
    return parser, command_parsers


def completion_options(words, parser, commands):
    """Derive public candidates from the parser, skipping global option values."""
    selected = parser
    remaining = 0
    for word in words:
        if remaining:
            remaining -= 1
            continue
        if word == 'help':
            return list(commands)
        if word in commands:
            selected = commands[word]
            break
        action = parser._option_string_actions.get(word.split('=', 1)[0])
        if action and action.nargs != 0 and '=' not in word:
            remaining = 1
    options = [flag for action in selected._actions if action.help != argparse.SUPPRESS
               for flag in action.option_strings]
    return (list(commands) if selected is parser else []) + options


def completion_shell():
    return 'powershell' if os.name == 'nt' else Path(os.environ.get('SHELL', '')).name


def zsh_rc():
    return Path(os.environ.get('ZDOTDIR') or HOME) / '.zshrc'


def completion_installed(shell):
    filename = {'bash': 'staged.bash', 'zsh': '_staged', 'powershell': 'staged.ps1'}[shell]
    target = CONFIG_DIR / 'completions' / filename
    if not target.is_file():
        return False
    # PowerShell's profile varies by host; installation prints its loader command.
    if shell == 'powershell':
        return True
    profiles = [zsh_rc()] if shell == 'zsh' else [Path(HOME) / '.bashrc', Path(HOME) / '.bash_profile']
    for path in profiles:
        if path.is_file():
            content = path.read_text(encoding='utf-8')
            if (COMPLETION_MARKER_START in content and COMPLETION_MARKER_END in content
                    and str(target if shell == 'bash' else target.parent) in content):
                return True
    return False


def setup_prompts_enabled():
    return (not os.environ.get('CI') and not os.environ.get('STAGED_NO_PROMPT')
            and all(stream.isatty() for stream in (sys.stdin, sys.stdout, sys.stderr)))


def offer_completion_install(shell=None):
    """Offer setup once per supported shell, only on interactive overview/init."""
    if not setup_prompts_enabled():
        return
    shell = shell or completion_shell()
    if shell not in ('bash', 'zsh', 'powershell'):
        return
    state_path = CONFIG_DIR / 'completion-setup.json'
    try:
        state = load_json(state_path)
        if state.get(shell) or completion_installed(shell):
            return
        detail = ('Install the script and show how to add it to $PROFILE' if shell == 'powershell'
                  else 'Update {}'.format(zsh_rc() if shell == 'zsh' else '~/.bashrc and ~/.bash_profile'))
        print('Enable staged tab completion for {}? {}. [y/N] '.format(shell, detail),
              end='', file=sys.stderr, flush=True)
        answer = sys.stdin.readline()
        if not answer:  # No answer is not a saved preference.
            return
        if answer.strip().lower() in ('y', 'yes'):
            install_completion(shell)
            state[shell] = 'installed'
        else:
            print('You can enable it later: staged install-completion --shell ' + shell, file=sys.stderr)
            state[shell] = 'declined'
        save_json(state_path, state)
    except (OSError, StagedError, ValueError) as exc:
        # Optional onboarding must never prevent the requested command from running.
        print('Completion setup skipped: {}. Run staged install-completion --shell {} to retry.'.format(exc, shell),
              file=sys.stderr)


def install_launcher():
    if sys.platform != 'win32':
        raise StagedError('The standalone cmd launcher is only supported on Windows.')
    launcher = CONFIG_DIR / 'bin/staged.cmd'
    # Percent signs in literal batch-file paths must not expand environment variables.
    python = sys.executable.replace('%', '%%')
    engine = str(REPO_ROOT / 'staged').replace('%', '%%')
    write_text_file(launcher, '@echo off\n"{}" "{}" %*\n'.format(python, engine))
    record_installed_file(launcher)
    print('Launcher: {}. Add {} to your user PATH.'.format(launcher, launcher.parent))


def offer_launcher_install():
    if sys.platform != 'win32' or not setup_prompts_enabled():
        return
    launcher = CONFIG_DIR / 'bin/staged.cmd'
    state_path = CONFIG_DIR / 'launcher-setup.json'
    try:
        # npm already supplies a command shim; do not offer a competing launcher.
        if launcher.is_file() or shutil.which('staged') or load_json(state_path).get('answered'):
            return
        print('Install the standalone staged.cmd launcher at {}? PATH will remain unchanged. [y/N] '.format(launcher),
              end='', file=sys.stderr, flush=True)
        answer = sys.stdin.readline()
        if not answer:
            return
        if answer.strip().lower() in ('y', 'yes'):
            install_launcher()
        else:
            print('You can install it later: python staged install-launcher', file=sys.stderr)
        save_json(state_path, {'answered': True})
    except (OSError, StagedError, ValueError) as exc:
        print('Launcher setup skipped: {}. Run python staged install-launcher to retry.'.format(exc), file=sys.stderr)


def install_completion_file(name, target):
    source = REPO_ROOT / 'completions' / name
    if not source.is_file():
        raise StagedError('Missing bundled completion script: ' + str(source))
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.is_symlink() and target.resolve() == source.resolve():
        return
    # Replace old installed copies without touching the versioned source file.
    fd, temporary = tempfile.mkstemp(prefix='.staged-link-', dir=str(target.parent))
    os.close(fd)
    os.unlink(temporary)
    try:
        try:
            os.symlink(str(source), temporary)
        except OSError as exc:
            if os.name != 'nt' or name != 'staged.ps1' or getattr(exc, 'winerror', None) != 1314:
                raise
            # Windows may deny symlinks without Developer Mode or elevation.
            # A dot-source loader still reads the package's current script.
            write_text_file(target, ". '{}'\n".format(str(source).replace("'", "''")))
            print('Windows denied symlink creation; installed a PowerShell loader pointing to ' + str(source))
            return
        os.replace(temporary, target)
    finally:
        if os.path.lexists(temporary):
            os.unlink(temporary)


def install_completion(shell=None):
    shell = shell or completion_shell() or 'bash'
    directory = CONFIG_DIR / 'completions'
    if shell == 'bash':
        target = directory / 'staged.bash'
        install_completion_file('staged.bash', target)
        hook = '{}\nsource {}\n{}\n'.format(COMPLETION_MARKER_START, shlex.quote(str(target)), COMPLETION_MARKER_END)
        upsert_shell_block(str(Path(HOME) / '.bashrc'), hook)
        upsert_shell_block(str(Path(HOME) / '.bash_profile'), hook)
    elif shell == 'zsh':
        target = directory / '_staged'
        install_completion_file('_staged', target)
        hook = '{}\nfpath=({} $fpath)\nautoload -Uz compinit\ncompinit\n' \
               'unfunction _staged 2>/dev/null\nautoload -Uz _staged\ncompdef _staged staged\n{}\n'.format(
            COMPLETION_MARKER_START, shlex.quote(str(directory)), COMPLETION_MARKER_END)
        # Old completion files can claim the same command, and compinit may reuse
        # a cached mapping. Register explicitly after other shell initialization.
        upsert_shell_block(str(zsh_rc()), hook, move_to_end=True)
    elif shell == 'powershell':
        target = directory / 'staged.ps1'
        install_completion_file('staged.ps1', target)
        print("Load in PowerShell (add to $PROFILE to persist): . '{}'".format(str(target).replace("'", "''")))
    else:
        raise StagedError('Choose --shell bash, zsh or powershell.')
    record_installed_file(target)
    profiles = [Path(HOME) / '.bashrc', Path(HOME) / '.bash_profile'] if shell == 'bash' else ([zsh_rc()] if shell == 'zsh' else [])
    for profile in profiles:
        record_install('profiles', str(profile))
    print('Installed: {}'.format(target))
    if shell == 'zsh':
        print('Activate in your current shell: source {} (or open a new terminal).'.format(shlex.quote(str(zsh_rc()))))
    elif shell == 'bash':
        print('Activate in your current shell: source {} (or open a new terminal).'.format(shlex.quote(str(target))))


def record_install(key, value):
    """Remember nonstandard install locations so uninstall can find them later."""
    path = CONFIG_DIR / 'installations.json'
    data = load_json(path)
    values = data.setdefault(key, [])
    if value not in values:
        values.append(value)
        save_json(path, data)


def record_installed_file(path):
    path = Path(path)
    receipt = CONFIG_DIR / 'installations.json'
    data = load_json(receipt)
    data.setdefault('files', {})[str(path.absolute())] = hashlib.sha256(path.read_bytes()).hexdigest()
    save_json(receipt, data)


def uninstall_sessions(ctx, receipt):
    roots = [DATA_DIR] + ctx.roots()
    for settings in (ctx.global_state, ctx.local):
        roots.extend(Path(p).expanduser() for p in settings.get('session_roots', []))
        if settings.get('staging_root'):
            roots.append(Path(settings['staging_root']).expanduser())
    roots.extend(Path(p).expanduser() for p in receipt.get('roots', []))
    roots.extend(Path(tool.root).expanduser() for tool in ctx.registry.values() if tool.root)
    sessions = []
    for root in dict.fromkeys(p.resolve() for p in roots):
        if not root.is_dir():
            continue
        for directory in sorted(root.iterdir()):
            if directory.is_symlink() or not directory.is_dir():
                continue
            marker = directory / '.workspace'
            if marker.is_symlink() or not marker.is_file() or not (directory / 'staging').is_dir():
                continue
            workspace = Path(marker.read_text(encoding='utf-8').strip())
            # A session must never contain the workspace it claims to protect.
            if not workspace.is_absolute() or directory == ctx.workspace or directory in ctx.workspace.parents:
                continue
            if directory == workspace.resolve() or directory in workspace.resolve().parents:
                continue
            if directory not in sessions:
                sessions.append(directory)
    return [directory for directory in sessions if not any(parent in sessions for parent in directory.parents)]


def npm_uninstall_command():
    """Use npm only when its global package resolves to this running installation."""
    npm = shutil.which('npm')
    if not npm:
        return None
    # npm.cmd needs cmd.exe on Windows. Keep all arguments fixed and validate the executable.
    def command(*args):
        tokens = [npm] + list(args)
        if os.name == 'nt' and npm.lower().endswith(('.cmd', '.bat')):
            if any(ch in npm for ch in '\r\n%"&|<>^!'):
                raise StagedError('Cannot safely run npm launcher: ' + npm)
            shell = subprocess.list2cmdline([os.environ.get('COMSPEC', 'cmd.exe')])
            return '{} /d /s /c "{}"'.format(shell, ' '.join('"{}"'.format(t) for t in tokens))
        return tokens
    result = subprocess.run(command('root', '--global'), capture_output=True, text=True)
    if result.returncode:
        raise StagedError('Cannot inspect npm global installation: ' + result.stderr.strip())
    value = result.stdout.strip()
    if not value or not Path(value).is_absolute():
        raise StagedError('npm returned an invalid global package directory.')
    package = Path(value) / '@melchi/staged'
    if package.exists() and package.resolve() == REPO_ROOT:
        return command('uninstall', '--global', '--ignore-scripts', '@melchi/staged')
    return None


def windows_launcher_path_edit():
    if sys.platform != 'win32':
        return None
    import winreg
    try:
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, 'Environment') as key:
            value, kind = winreg.QueryValueEx(key, 'Path')
    except FileNotFoundError:
        return None
    target = ntpath.normcase(ntpath.normpath(str(CONFIG_DIR / 'bin')))
    parts = value.split(';')
    kept = [part for part in parts if ntpath.normcase(ntpath.normpath(
        os.path.expandvars(part.strip().strip('"')))) != target]
    return (';'.join(kept), kind) if kept != parts else None


def uninstall(ctx):
    receipt = load_json(CONFIG_DIR / 'installations.json')
    sessions = uninstall_sessions(ctx, receipt)
    npm_command = npm_uninstall_command()
    # Recognize legacy default installs; receipts also cover custom paths and old versions.
    files = dict(receipt.get('files', {}))
    skill_source = REPO_ROOT / 'SKILL.md'
    if skill_source.is_file():
        digest = hashlib.sha256(skill_source.read_bytes()).hexdigest()
        for location in ('.cursor/skills', '.claude/skills', '.agents/skills',
                         '.codeium/windsurf/skills', '.gemini/config/skills'):
            files.setdefault(str(Path(HOME) / location / 'stage/SKILL.md'), digest)
    for name in ('staged.bash', '_staged', 'staged.ps1'):
        source = REPO_ROOT / 'completions' / name
        if source.is_file():
            files.setdefault(str(CONFIG_DIR / 'completions' / name), hashlib.sha256(source.read_bytes()).hexdigest())
    launcher = CONFIG_DIR / 'bin/staged.cmd'
    legacy_launcher = '@echo off\n"{}" "{}" %*\n'.format(
        sys.executable.replace('%', '%%'), str(REPO_ROOT / 'staged').replace('%', '%%'))
    files.setdefault(str(launcher), hashlib.sha256(legacy_launcher.replace('\n', os.linesep).encode()).hexdigest())
    removable = []
    for value, digest in files.items():
        path = Path(value)
        # Never remove a source file when someone installed directly over the checkout.
        if path.resolve() == REPO_ROOT or REPO_ROOT in path.resolve().parents:
            if not path.is_symlink():
                continue
        if path.is_symlink() and (not path.exists() or path.resolve() in
                [REPO_ROOT / 'completions' / name for name in ('staged.bash', '_staged', 'staged.ps1')]):
            removable.append(path)
        elif path.is_file() and hashlib.sha256(path.read_bytes()).hexdigest() == digest:
            removable.append(path)
        elif path.exists():
            print('Keeping modified installation: ' + str(path))
    candidates = [Path(HOME) / '.local/bin/staged']
    found = shutil.which('staged')
    if found:
        candidates.append(Path(found))
    for path in candidates:
        if path.is_symlink() and path.resolve() == REPO_ROOT / 'staged' and path not in removable:
            removable.append(path)
    profiles = {Path(HOME) / '.bashrc', Path(HOME) / '.bash_profile', zsh_rc()}
    profiles.update(Path(p) for p in receipt.get('profiles', []))
    pattern = re.compile(r'(?m)^' + re.escape(COMPLETION_MARKER_START) + r'\n.*?^' +
                         re.escape(COMPLETION_MARKER_END) + r'[^\S\n]*\n?', re.DOTALL)
    # PowerShell installers print an exact loader to add manually to a profile.
    powershell_dirs = [Path(HOME) / 'Documents' / name for name in ('PowerShell', 'WindowsPowerShell')]
    powershell_dirs.append(Path(os.environ.get('XDG_CONFIG_HOME', Path(HOME) / '.config')) / 'powershell')
    if os.environ.get('OneDrive'):
        powershell_dirs.extend(Path(os.environ['OneDrive']) / 'Documents' / name for name in ('PowerShell', 'WindowsPowerShell'))
    for directory in powershell_dirs:
        if directory.is_dir():
            profiles.update(directory.glob('*profile.ps1'))
    loader = ". '{}'".format(str(CONFIG_DIR / 'completions/staged.ps1').replace("'", "''"))
    profile_edits = []
    for profile in sorted(profiles):
        if profile.is_file():
            content = profile.read_text(encoding='utf-8')
            updated = pattern.sub('', content)
            if profile.suffix == '.ps1':
                updated = ''.join(line for line in updated.splitlines(keepends=True) if line.strip() != loader)
            if content != updated:
                profile_edits.append((profile, updated))
    path_edit = windows_launcher_path_edit()
    print('Uninstall staged: {} installed files, {} shell profiles, global settings and shell bindings.'.format(
        len(removable), len(profile_edits)))
    if npm_command:
        print('Remove the global npm package @melchi/staged.')
    else:
        print('Source checkout is retained: ' + str(REPO_ROOT))
    for directory in sessions:
        print('Session: ' + str(directory))
    confirm('Uninstall staged?', ctx.args.yes)
    remove_sessions = ctx.args.remove_sessions
    if sessions and not remove_sessions and not ctx.args.keep_sessions:
        if sys.stdin.isatty():
            remove_sessions = input('Also permanently delete all {} listed sessions? [y/N] '.format(len(sessions))).strip().lower() in ('y', 'yes')
        else:
            print('Keeping sessions; pass --remove-sessions to delete them.')
    # Run the package manager first: a permissions failure must leave cleanup retryable.
    if npm_command:
        result = subprocess.run(npm_command)
        if result.returncode:
            raise StagedError('npm uninstall failed; settings and sessions were kept. Retry with the required npm permissions.')
    if path_edit is not None:
        import winreg
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, 'Environment', 0, winreg.KEY_SET_VALUE) as key:
            winreg.SetValueEx(key, 'Path', 0, path_edit[1], path_edit[0])
        print('Removed standalone launcher directory from user PATH.')
    for profile, content in profile_edits:
        # Preserve permissions and follow a user's profile symlink rather than replacing it.
        profile.write_text(content, encoding='utf-8')
        print('Removed completion hook: ' + str(profile))
    for value, field, token in receipt.get('permissions', []):
        path = Path(value)
        if not path.is_file():
            continue
        data = load_json(path)
        parent = data
        for key in field.split('.')[:-1]:
            parent = parent.get(key, {}) if isinstance(parent, dict) else {}
        key = field.split('.')[-1]
        if isinstance(parent, dict) and isinstance(parent.get(key), list) and token in parent[key]:
            parent[key].remove(token)
            save_json(path, data)
    for path in removable:
        if path.is_file() or path.is_symlink():
            path.unlink()
            print('Removed: ' + str(path))
        # Only remove an empty directory owned by the skill or completion installer.
        if path.name == 'SKILL.md' or path.parent in (CONFIG_DIR / 'completions', CONFIG_DIR / 'bin'):
            if path.parent.is_dir() and not path.parent.is_symlink() and not any(path.parent.iterdir()):
                path.parent.rmdir()
    if remove_sessions:
        for directory in sessions:
            shutil.rmtree(directory)
            print('Deleted session: ' + str(directory))
    for name in ('state.json', 'completion-setup.json', 'launcher-setup.json', 'installations.json'):
        path = CONFIG_DIR / name
        if path.is_file() or path.is_symlink():
            path.unlink()
    bindings = CONFIG_DIR / 'shell_sessions'
    if bindings.is_dir() and not bindings.is_symlink():
        for path in bindings.glob('*.json'):
            if path.is_file() or path.is_symlink():
                path.unlink()
        if not any(bindings.iterdir()):
            bindings.rmdir()
    if CONFIG_DIR.is_dir() and not CONFIG_DIR.is_symlink() and not any(CONFIG_DIR.iterdir()):
        CONFIG_DIR.rmdir()
    print('Uninstall complete. {} {} sessions.'.format('Deleted' if remove_sessions else 'Kept', len(sessions)))
    print('Open a new terminal to refresh PATH and clear loaded completions.')


def set_preferences(ctx):
    args = ctx.args
    data = dict(ctx.local if args.repo else ctx.global_state)
    if args.repo and args.default:
        raise StagedError('--repo and --default are mutually exclusive.')
    if args.tool:
        data['default_tool'] = ctx.tool().id
    if args.default_session:
        data['default_session'] = ctx.find_session(args.default_session).id
    if args.root:
        data['staging_root'] = str(Path(args.root).expanduser().resolve())
    if args.branch_protection:
        data['branch_protection'] = args.branch_protection == 'true'
    if args.protected_branch is not None:
        data['protected_branches'] = args.protected_branch
    if args.session_root is not None:
        data['session_roots'] = [str(Path(r).expanduser().resolve()) for r in args.session_root]
    path = ctx.workspace / '.staged.json' if args.repo else GLOBAL_STATE_FILE
    save_json(path, data)
    print('Updated ' + str(path))


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    parser, commands = make_parser()
    # Completion must work with incomplete arguments and without loading user configuration.
    if argv[:1] == ['--complete-options']:
        print('\n'.join(completion_options(argv[1:], parser, commands)))
        return
    if '--help-all' in argv:
        parser.print_help()
        for command in commands.values():
            print('\n' + '=' * 72)
            command.print_help()
        return
    # Handle help before parsing required values or reading any configuration.
    if '--help' in argv or '-h' in argv or argv[:1] == ['help']:
        command = next((arg for arg in argv if arg in commands), None)
        (commands.get(command) or parser).print_help()
        return
    args = parser.parse_args(argv)
    if args.command in ('read', 'write'):
        validate_file_range_args(commands[args.command], args)
    if args.command == 'diff' and (args.apply or args.clean or args.between or args.compare_session):
        if args.file is None and not args.all:
            commands['diff'].error('choose --file <file> or --all')
    if args.command == 'install-launcher':
        install_launcher()
        return
    if not argv or (args.command == 'init' and not args.json):
        offer_completion_install(args.shell)
    ctx = Context(args)
    if args.command == 'uninstall':
        uninstall(ctx)
        return
    if args.complete_tools:
        print('\n'.join(sorted(ctx.registry)))
        return
    if args.all_repos or args.sessions or args.complete_sessions:
        sessions = ctx.sessions(args.all_repos)
        if args.complete_sessions:
            for session in sessions:
                print(session.id)
            return
        rows = []
        for session in sessions:
            count = len(session.paths())
            rows.append((session, '{} {}'.format(count, 'change' if count == 1 else 'changes')))
        id_width = max((len(session.id) for session, _ in rows), default=0)
        count_width = max((len(count) for _, count in rows), default=0)
        for session, count in rows:
            print('{}\t{}\t{}\n\t{}'.format(
                color(session.id.ljust(id_width), '36'), color(count.ljust(count_width), '33'),
                color(session.workspace, '1'), color(session.staging, '2')))
            print('\tSummary: {}'.format(summary_text(session.summaries()['session'])))
        return
    if args.complete_open or args.complete_meta:
        try:
            print('\n'.join(ctx.active(notify=False).openable_paths(meta=args.complete_meta)))
        except StagedError as exc:
            if not str(exc).startswith('No staging session'):
                raise
        return
    if args.complete or args.list:
        try:
            print('\n'.join(ctx.active(notify=False).paths()))
        except StagedError as exc:
            if not str(exc).startswith('No staging session'):
                raise
        return
    if args.command == 'delete':
        delete_file(ctx.active(notify=False), args)
        return
    if args.command in ('create', 'copy', 'rename'):
        file_operation(ctx.active(notify=False), args)
        return
    if args.command == 'summarize':
        update_summary(ctx.active(notify=False), args)
        return
    if args.command in ('read', 'write'):
        session = ctx.active(notify=False)
        (read_file_range if args.command == 'read' else write_file_range)(session, args)
        return
    if args.shell == 'powershell' and args.command != 'path' and not getattr(args, 'json', False):
        offer_launcher_install()
    if args.command == 'init':
        session = init_session(ctx, args.id or args.session or str(uuid.uuid4()))
        ctx.shell['session'] = session.id
        ctx.shell.pop('deleted_session', None)
        save_json(ctx.shell_path, ctx.shell)
        result = {'session': session.id, 'workspace': str(session.workspace), 'staging': str(session.staging),
                  'branch': session.metadata.get('branch'), 'directory': str(session.directory)}
        if args.json:
            print(json.dumps(result))
        else:
            print('Session: {}\nStaging: {}\nReview: staged --session {}'.format(session.id, session.staging, session.id))
        return
    if args.command == 'use':
        if args.id and args.session:
            raise StagedError('Choose either --session <id> or a positional session ID.')
        binding = args.session or args.id
        if args.clear:
            if binding or args.tool:
                raise StagedError('--clear cannot be combined with a session or tool.')
            if ctx.shell_path.exists():
                ctx.shell_path.unlink()
            print('Cleared shell binding.')
            return
        if not binding and not args.tool:
            raise StagedError('Provide --session <id>, --tool or --clear.')
        if binding:
            ctx.shell['session'] = ctx.find_session(binding).id
            ctx.shell.pop('deleted_session', None)
        if args.tool:
            ctx.shell['tool'] = ctx.tool().id
        save_json(ctx.shell_path, ctx.shell)
        print('Shell binding: ' + json.dumps(ctx.shell))
        return
    if args.command == 'set':
        set_preferences(ctx)
        return
    if args.command == 'set-tool':
        key = session_id(args.id)
        if key in TOOL_REGISTRY:
            raise StagedError('Choose a custom ID; built-in adapters cannot be replaced.')
        diff, opening = shlex.split(args.diff_cmd), shlex.split(args.open_cmd)
        if not diff or not opening or '{orig}' not in args.diff_cmd or '{staged}' not in args.diff_cmd or '{staged}' not in args.open_cmd:
            raise StagedError('Diff requires {orig} and {staged}; open requires {staged}.')
        ctx.global_state.setdefault('tools', {})[key] = {'name': args.name, 'diff_cmd': diff, 'open_cmd': opening, 'root': args.root}
        save_json(GLOBAL_STATE_FILE, ctx.global_state)
        print('Registered tool: ' + key)
        return
    if args.command == 'install-skill':
        tool = ctx.tool()
        path = tool.install_skill(args.target_dir)
        root = ctx.staging_root()
        root.mkdir(parents=True, exist_ok=True)
        if args.configure_sandbox:
            if tool.configure_sandbox(root):
                print('Configured staging-root permissions for ' + tool.name)
            else:
                print('Automatic sandbox configuration is unavailable for {}. Add {} to your harness writable roots.'.format(tool.name, root))
        if args.default:
            ctx.global_state['default_tool'] = tool.id
        ctx.global_state['staging_root'] = str(root)
        save_json(GLOBAL_STATE_FILE, ctx.global_state)
        print('Installed /stage: {}'.format(path))
        print('Staging root: {}. Skill installation alone does not grant filesystem permissions.'.format(root))
        return
    if args.command == 'install-completion':
        install_completion(args.shell)
        return
    if args.command == 'migrate':
        migrate(ctx)
        return
    if args.command == 'diff' and (args.between or args.compare_session):
        cross_diff(ctx)
        return
    if args.command == 'clean' and isinstance(args.clean_session, str):
        session = ctx.find_session(args.clean_session)
    else:
        session = ctx.active()
    if args.command == 'path':
        rel = match_file(args.file, session.paths())
        if args.workspace:
            print(session.original(rel))
        elif rel in session.deletions:
            raise StagedError('Deletion has no staged file; use --workspace.')
        else:
            print(safe_path(session.staging, rel))
    elif args.command == 'open':
        open_file(ctx, session, args.file)
    elif args.command == 'apply' or (args.command == 'diff' and args.apply):
        apply_changes(ctx, session, args.file)
        if args.command == 'diff' and args.clean:
            clean_session(ctx, session)
    elif args.command == 'clean' or (args.command == 'diff' and getattr(args, 'clean', False)):
        clean_session(ctx, session)
    elif args.command == 'diff' and (args.file is not None or args.all):
        review(ctx, session, args.file)
    else:
        overview(ctx, session)


if __name__ == '__main__':
    try:
        main()
    except (StagedError, OSError, ValueError, subprocess.SubprocessError) as exc:
        print('Error: {}'.format(exc), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print('\nAborted.', file=sys.stderr)
        sys.exit(130)
