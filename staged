def run_editor(command, terminal=False):
    # Native .exe files need no shell. Batch launchers require cmd.exe on Windows.
    if os.name == 'nt' and command[0].lower().endswith(('.cmd', '.bat')):
        if any(any(ch in arg for ch in '\r\n%"&|<>^!') for arg in command):
            raise StagedError('Batch launcher cannot safely represent these arguments; use a native executable.')
        shell = subprocess.list2cmdline([os.environ.get('COMSPEC', 'cmd.exe')])
        quoted = ' '.join('"{}"'.format(arg) for arg in command)
        command = '{} /d /s /c "{}"'.format(shell, quoted)
    result = subprocess.run(command)
    if result.returncode not in ((0, 1) if terminal else (0,)):
        raise StagedError('Editor/diff command failed with exit code {}'.format(result.returncode))


def init_session(ctx, key, root=None):
    key = session_id(key)
    root = root or ctx.staging_root()
    try:
        root.relative_to(ctx.workspace)
    except ValueError:
        pass
    else:
        raise StagedError('Staging root must be outside the workspace: ' + str(root))
    directory = safe_path(root, key)
    if directory.exists():
        if not (directory / '.workspace').is_file():
            raise StagedError('Directory already exists without session metadata: ' + str(directory))
        session = Session(directory)
        if session.workspace != ctx.workspace:
            raise StagedError('Session belongs to a different workspace: ' + str(session.workspace))
        record_install('roots', str(root))
        return session
    (directory / 'staging').mkdir(parents=True)
    write_text_file(directory / '.workspace', str(ctx.workspace) + '\n')
    save_json(directory / 'session.json', {'id': key, 'branch': get_git_branch(ctx.workspace), 'created_at': time.time()})
    save_json(directory / 'renames.json', {})
    record_install('roots', str(root))
    return Session(directory)


def summary_text(value):
    # Keep multiline author input readable in terminal lists.
    return ' '.join(value.split()) or '(no summary yet)'


# Human output layout: headings at column 0, file rows at column 2, and anything nested
# 4 columns deeper than its parent. Labels end in a colon and line up within a block.
ROW_INDENT = '  '
NESTED = '    '


def text_width(indent):
    return max(40, min(100, shutil.get_terminal_size((100, 24)).columns) - len(indent))


def heading_line(label, value):
    return '{} {}'.format(color(label, '1'), color(value, '1;36'))


def label_lines(pairs, indent=''):
    """Aligned `Label:  value` lines; a list value continues under the first, wrapped to the terminal."""
    width = max(len(pair[0]) for pair in pairs) + 2
    lines = []
    for label, value, *code in pairs:
        values = value if isinstance(value, list) else [value]
        pad = indent + ' ' * (width + 1)
        first = True
        for item in values or ['']:
            wrapped = textwrap.wrap(str(item), text_width(pad), break_long_words=False, break_on_hyphens=False) or ['']
            for line in wrapped:
                text = color(line, code[0]) if code and code[0] else line
                lines.append((indent + color((label + ':').ljust(width), '1') + ' ' if first else pad) + text)
                first = False
    return lines


def show_session_summary(session, summaries):
    print(heading_line('Session', session.id), flush=True)
    show_summary_text(summaries['session'])


def show_summary_text(value, indent='    ', separate=True):
    print(wrapped_summary(value, indent), flush=True)
    if separate:
        print(flush=True)


def status_sort_key(status):
    try:
        return STATUS_ORDER.index(status)
    except ValueError:
        return len(STATUS_ORDER)


def grouped_by_status(session, paths, proposed=None):
    """Order paths by status group, then path, for human-readable listings."""
    known = None if proposed is None else set(proposed)
    rows = []
    for rel in paths:
        status = session.status(rel) if known is None or rel in known else None
        rows.append((status_sort_key(status), rel, status))
    rows.sort(key=lambda item: (item[0], item[1]))
    return [(status, rel) for _, rel, status in rows]


def update_summary(session, args):
    summaries = session.summaries()
    if args.file is not None:
        safe_path(session.staging, args.file)
        if args.file not in session.paths(fresh=True):
            raise StagedError('No staged change at exact path: ' + args.file)
    if not (args.message is not None or args.stdin or args.clear):
        raise StagedError('Nothing to write; pass --message, --stdin or --clear. View summaries with staged --summary.')
    if args.session_message is not None and args.file is None:
        raise StagedError('--session-message requires a file summary update with --file.')
    value = read_message_arg(args, 'Summary')
    value = '' if args.clear else value.strip()
    if args.file is None:
        summaries['session'] = value
    elif value:
        summaries['files'][args.file] = value
    else:
        summaries['files'].pop(args.file, None)
    if args.session_message is not None:
        summaries['session'] = args.session_message.strip()
    session.save_summaries(summaries)
    if args.json:
        print(json.dumps(summaries))
    else:
        print('Updated summary: ' + (args.file or session.id))


def wrapped_summary(value, indent=NESTED):
    text = summary_text(value)
    if not value.strip():
        return color(indent + text, '2')
    lines = textwrap.wrap(text, text_width(indent)) or [text]
    return color('\n'.join(indent + line for line in lines), '36')


def show_summaries(session, target, as_json=False):
    summaries = session.summaries()
    proposed = session.paths()
    paths = proposed
    if target is not None:
        if target not in proposed and target not in summaries['files']:
            target = match_file(target, proposed)
        paths = [target]
    if as_json:
        if target is None:
            print(json.dumps(summaries))
        else:
            print(json.dumps({'session': summaries['session'], 'path': target,
                              'summary': summaries['files'].get(target, '')}))
        return
    if target is None:
        intent = session.intent()
        if intent['text'] or intent['refs']:
            show_intent_block(session, intent)
        show_session_summary(session, summaries)
        if not paths:
            print(color('No staged changes yet.', '2'))
    previous = None
    for status, rel in grouped_by_status(session, paths, proposed):
        if previous is not None and status != previous:
            print(flush=True)
        previous = status
        if status:
            print(status_row(status, color(rel, '1'), ROW_INDENT))
        else:
            print(ROW_INDENT + color(rel, '1'))
        show_summary_text(summaries['files'].get(rel, ''), indent=ROW_INDENT + NESTED)


def read_message_arg(args, label):
    """Return -m/--stdin text for a write command, or None when neither was given."""
    if not getattr(args, 'stdin', False):
        return args.message
    if sys.stdin.isatty():
        raise StagedError('--stdin requires piped or redirected input; use --message for inline content.')
    try:
        return sys.stdin.buffer.read().decode('utf-8')
    except UnicodeDecodeError as exc:
        raise StagedError('{} input must be UTF-8: {}'.format(label, exc))


def update_intent(session, args):
    intent = session.intent()
    adding = [ref.strip() for ref in (args.ref or []) if ref.strip()]
    removing = [ref.strip() for ref in (getattr(args, 'remove_ref', None) or [])]
    if not (args.message is not None or args.stdin or args.clear or adding or removing):
        raise StagedError('Nothing to write; pass --message, --stdin, --ref, --remove-ref or --clear. '
                          'View the intent with staged --intent.')
    now = time.time()
    if args.clear:
        intent = {'text': '', 'refs': []}
    value = read_message_arg(args, 'Intent')
    if value is not None:
        intent['text'] = value.strip()
    missing = [ref for ref in removing if ref not in intent['refs']]
    if missing:
        raise StagedError('Intent has no reference: ' + ', '.join(missing))
    intent['refs'] = [ref for ref in intent['refs'] if ref not in removing]
    intent['refs'] += [ref for ref in dict.fromkeys(adding) if ref not in intent['refs']]
    if intent['text'] or intent['refs']:
        intent.setdefault('recorded_at', now)
        intent['updated_at'] = now
    session.save_intent(intent)
    if getattr(args, 'quiet', False):
        return
    if args.json:
        print(json.dumps(session.intent()))
    else:
        print(('Cleared intent: ' if not (intent['text'] or intent['refs']) else 'Updated intent: ') + session.id)


def format_timestamp(value):
    return time.strftime('%Y-%m-%d %H:%M', time.localtime(value)) if value else None


def show_intent_block(session, intent, indent=NESTED):
    print(heading_line('Intent', session.id), flush=True)
    if intent['text']:
        for paragraph in intent['text'].splitlines():
            lines = textwrap.wrap(paragraph, text_width(indent)) if paragraph.strip() else ['']
            print(color('\n'.join(indent + line for line in lines), '35'), flush=True)
    else:
        print(color(indent + '(no intent recorded)', '2'), flush=True)
    pairs = []
    if intent['refs']:
        pairs.append(('Refs', intent['refs'], '4;34'))
    recorded = format_timestamp(intent.get('recorded_at'))
    if recorded:
        pairs.append(('Recorded', recorded, '2'))
    updated = format_timestamp(intent.get('updated_at'))
    if updated and updated != recorded:
        pairs.append(('Updated', updated, '2'))
    if session.metadata.get('branch'):
        pairs.append(('Branch', '{}'.format(session.metadata['branch']), '2'))
    if pairs:
        for line in label_lines(pairs, indent):
            print(line, flush=True)
    print(flush=True)


def show_intent(session, as_json=False):
    intent = session.intent()
    if as_json:
        print(json.dumps(dict(intent, session=session.id, branch=session.metadata.get('branch'))))
        return
    show_intent_block(session, intent)
    if not (intent['text'] or intent['refs']):
        print(color('Record it with: staged intent -m "<original request>" --ref <PR/MR/issue URL>', '2'))


def list_sessions(sessions, as_json=False):
    rows = []
    for session in sessions:
        count = len(session.paths())
        rows.append({'session': session.id, 'workspace': str(session.workspace),
                     'workspace_exists': session.workspace.is_dir(), 'staging': str(session.staging),
                     'changes': count, 'branch': session.metadata.get('branch'),
                     'summary': session.summaries()['session'], 'intent': session.intent()})
    if as_json:
        print(json.dumps(rows))
        return
    id_width = max((len(row['session']) for row in rows), default=0)
    for index, row in enumerate(rows):
        if index:
            print()
        count = '{} {}'.format(row['changes'], 'change' if row['changes'] == 1 else 'changes')
        workspace = row['workspace'] + ('' if row['workspace_exists'] else ' (workspace not found)')
        print('{}  {}  {}'.format(color(row['session'].ljust(id_width), '1;36'), color(count.ljust(10), '33'),
                                  color(workspace, '1')))
        pairs = [('Staging', row['staging'], '2')]
        intent = row['intent']
        if intent['text']:
            text = summary_text(intent['text'])
            pairs.append(('Intent', text if len(text) <= 160 else text[:157] + '...', '35'))
        if intent['refs']:
            pairs.append(('Refs', intent['refs'], '4;34'))
        pairs.append(('Summary', summary_text(row['summary']), '36' if row['summary'].strip() else '2'))
        for line in label_lines(pairs, NESTED):
            print(line)


def overview_data(ctx, session):
    branch = get_git_branch(session.workspace)
    summaries = session.summaries()
    files = []
    for status, rel in grouped_by_status(session, session.paths()):
        path = safe_path(session.staging, rel)
        stats = file_diff_stats(session, rel)
        files.append({'path': rel, 'status': status, 'summary': summaries['files'].get(rel, ''),
                      'staged': str(path) if path.exists() else None, 'workspace': str(session.original(rel)),
                      'added': stats[0], 'removed': stats[1]})
    return {'session': session.id, 'workspace': str(session.workspace), 'staging': str(session.staging),
            'tool': ctx.tool().id, 'branch': branch, 'origin_branch': session.metadata.get('branch'),
            'intent': session.intent(), 'summary': summaries['session'], 'files': files}


def overview(ctx, session, as_json=False):
    if as_json:
        print(json.dumps(overview_data(ctx, session)))
        session.refresh_index()
        return
    branch = get_git_branch(session.workspace)
    protected = ctx.setting('branch_protection', True) and is_branch_protected(branch, ctx.setting('protected_branches', DEFAULT_PROTECTED_BRANCHES))
    for line in label_lines([('Repository', str(session.workspace)), ('Session', session.id, '36'),
                             ('Tool', ctx.tool().name, '36'),
                             ('Branch', branch or '(not a Git repository)', '31' if protected else '32'),
                             ('Staging', str(session.staging))]):
        print(line)
    print(flush=True)
    summaries = session.summaries() if ctx.args.verbose else None
    if summaries is not None:
        intent = session.intent()
        if intent['text'] or intent['refs']:
            show_intent_block(session, intent)
        show_session_summary(session, summaries)
    paths = session.paths()
    if not paths:
        print(color('No staged changes yet.', '2'))
    previous = None
    for status, rel in grouped_by_status(session, paths):
        if previous is not None and status != previous:
            print(flush=True)
        previous = status
        print(status_row(status, rel, ROW_INDENT))
        if ctx.args.verbose:
            nested = ROW_INDENT + NESTED
            show_summary_text(summaries['files'].get(rel, ''), indent=nested, separate=False)
            path = safe_path(session.staging, rel)
            pairs = [('Staged', str(path) if path.exists() else '(deletion)'),
                     ('Workspace', str(session.original(rel))),
                     ('Changes', format_diff_stats(session, rel))]
            if path.exists():
                pairs += [('Size', '{} bytes'.format(path.stat().st_size)),
                          ('Modified', time.ctime(path.stat().st_mtime))]
            for line in label_lines(pairs, nested):
                print(line)
            print(flush=True)
    session.refresh_index()


def review(ctx, session, target):
    tool = ctx.tool()
    terminal = tool.id in ('cli', 'codex', 'claudecode')
    summaries = session.summaries() if ctx.args.verbose else None
    if summaries is not None:
        show_session_summary(session, summaries)
    for rel in selected(session, target):
        if target is None and session.status(rel) == 'APPLIED':
            continue
        original = session.original(rel)
        proposed = safe_path(session.staging, rel)
        if rel not in session.deletions and not proposed.is_file():
            raise StagedError('Missing staged contents: ' + rel)
        # GUI launchers often return before opening tabs; keep the empty side on disk.
        empty = safe_path(session.directory, '.review/empty/' + rel)
        write_text_file(empty, '')
        left = original if original.is_file() else empty
        right = empty if rel in session.deletions else proposed
        print('Review {}: {}'.format(status_token(session.status(rel)), rel), flush=True)
        if summaries is not None:
            show_summary_text(summaries['files'].get(rel, ''))
        run_editor(tool.get_diff_command(left, right), terminal)


META_ALIASES = {
    'staging': 'staged_changes.md',
    'staging.md': 'staged_changes.md',
    'staged': 'staged_changes.md',
    'staged.md': 'staged_changes.md',
    'diff': 'diff_viewer.md',
    'diff.md': 'diff_viewer.md',
}


def resolve_meta_alias(target, paths):
    if target not in paths and target.lower() in META_ALIASES and META_ALIASES[target.lower()] in paths:
        return META_ALIASES[target.lower()]
    return target


def resolve_location(session, query, where='staged', must_exist=False):
    """Resolve `-f` for `path` and `open` to (name, absolute path).

    `where` is staged (default), workspace, meta or sandbox. Every kind accepts the same fuzzy
    matching as `diff -f`: exact path, case-insensitive path, file name, subsequence, then a close
    spelling. A --meta name that matches nothing may be a file that does not exist yet.
    """
    if where == 'sandbox':
        rel = match_file(query, session.sandbox_entries(), 'sandbox entry')
        return rel, session.staging / rel
    if where == 'meta':
        names = session.openable_paths(meta=True)
        query = resolve_meta_alias(query, names)
        try:
            rel = match_file(query, names, 'session file')
        except StagedError as exc:
            if must_exist or str(exc).startswith('Ambiguous'):
                raise
            rel = query  # A new metadata file: range_path validates the name.
        return rel, range_path(session, rel, meta=True)
    rel = match_file(query, session.paths())
    if where == 'workspace':
        return rel, session.original(rel)
    if rel in session.deletions:
        raise StagedError('Deletion has no staged file; use --workspace: ' + rel)
    return rel, safe_path(session.staging, rel)


def location_kind(args):
    for kind in ('workspace', 'meta', 'sandbox'):
        if getattr(args, kind, False):
            return kind
    return 'staged'


def open_file(ctx, session, target):
    rel, path = resolve_location(session, target, location_kind(ctx.args), must_exist=True)
    if not path.exists():
        raise StagedError('File does not exist: ' + str(path))
    print('Open: {}'.format(rel), flush=True)
    run_editor(ctx.tool().get_open_command(path))


def guard_apply(ctx, session):
    branch = get_git_branch(session.workspace)
    patterns = ctx.setting('protected_branches', DEFAULT_PROTECTED_BRANCHES)
    if ctx.setting('branch_protection', True) and is_branch_protected(branch, patterns):
        if not ctx.args.force:
            raise StagedError("Protected branch '{}'; switch branches or pass --force.".format(branch))
        print("Warning: applying to protected branch '{}' (--force).".format(branch), file=sys.stderr)
    origins = {session.metadata.get('branch')}
    origins.update(item.get('branch') for item in session.metadata.get('migrated_from', []))
    drifted = sorted(origin for origin in origins if origin and origin != branch)
    if drifted:
        confirm("Branch changed from '{}' to '{}'. Apply here?".format(', '.join(drifted), branch), ctx.args.yes)


def preflight(session, paths):
    files = session.files(fresh=True)
    destinations = set(paths) - set(session.deletions)
    all_destinations = set(files)
    if set(files) & set(session.deletions):
        raise StagedError('A path cannot be both a staged file and a deletion.')
    sources = []
    for rel in paths:
        dest = safe_path(session.workspace, rel)
        original = session.original(rel)
        if dest.exists() and not dest.is_file() or original.exists() and not original.is_file():
            raise StagedError('Apply requires regular file destinations: ' + rel)
        for parent in dest.parents:
            if parent == session.workspace:
                break
            if parent.exists() and not parent.is_dir():
                raise StagedError('Destination parent is a file: ' + str(parent))
        if rel not in session.deletions:
            if rel not in files:
                raise StagedError('Missing staged contents: ' + rel)
            old = session.manifest.get(rel, rel)
            if old != rel:
                if old in all_destinations or old in session.deletions:
                    raise StagedError('Overlapping rename/deletion sources require separate sessions: ' + old)
                sources.append(old)
    if len(sources) != len(set(sources)):
        raise StagedError('Multiple staged files cannot rename the same source.')
    for rel in destinations:
        if any(parent.as_posix() in destinations for parent in Path(rel).parents if str(parent) != '.'):
            raise StagedError('Conflicting staged file and directory: ' + rel)



# ===========================================================================
# Base-Snapshot Conflict Protection, 3-Way Merge & Workspace Undo
# ===========================================================================

def file_sha256(path):
    path = Path(path)
    if not path.is_file():
        return None
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(block)
    return digest.hexdigest()


def file_mode(path):
    path = Path(path)
    if not path.is_file():
        return None
    return stat.S_IMODE(path.stat().st_mode)


def is_utf8_text_file(path):
    path = Path(path)
    if not path.is_file():
        return False
    try:
        raw = path.read_bytes()
        if b'\x00' in raw:
            return False
        raw.decode('utf-8')
        return True
    except (OSError, UnicodeDecodeError):
        return False


def base_metadata_path(session):
    return safe_path(session.directory, '.base.json')


def base_files_root(session):
    root = session.directory / '.base'
    if root.is_symlink():
        raise StagedError('Session .base directory cannot be a symlink: {}'.format(root))
    return root


def load_base_metadata(session):
    path = base_metadata_path(session)
    data = load_json(path)
    if not isinstance(data.get('files', {}), dict):
        raise StagedError('.base.json requires a files object.')
    data.setdefault('files', {})
    return data


def save_base_metadata(session, data):
    save_json(base_metadata_path(session), data)


def record_base_snapshot(session, workspace_rel, reset=False):
    """Record the workspace baseline for workspace_rel on first touch in the session."""
    ws_file = safe_path(session.workspace, workspace_rel)
    base_root = base_files_root(session)
    base_root.mkdir(parents=True, exist_ok=True)
    base_file = safe_path(base_root, workspace_rel)
    data = load_base_metadata(session)
    files = data['files']

    if not reset and workspace_rel in files:
        existing_entry = files[workspace_rel]
        if existing_entry.get('existed'):
            if base_file.is_file():
                return existing_entry
        else:
            return existing_entry

    now = time.time()
    if ws_file.is_file():
        copy_atomic(ws_file, base_file)
        st = ws_file.stat()
        entry = {
            'sha256': file_sha256(base_file),
            'size': st.st_size,
            'mode': stat.S_IMODE(st.st_mode),
            'recorded_at': now,
            'existed': True,
        }
    else:
        if base_file.is_file():
            base_file.unlink()
        entry = {
            'existed': False,
            'recorded_at': now,
        }
    files[workspace_rel] = entry
    save_base_metadata(session, data)
    return entry


def remove_base_snapshot(session, workspace_rel):
    """Remove a single path's base snapshot entry and stored file."""
    data = load_base_metadata(session)
    files = data['files']
    files.pop(workspace_rel, None)
    base_root = base_files_root(session)
    if base_root.exists():
        base_file = safe_path(base_root, workspace_rel)
        if base_file.is_file():
            base_file.unlink()
            parent = base_file.parent
            while parent != base_root and parent.is_dir() and not any(parent.iterdir()):
                parent.rmdir()
                parent = parent.parent
    if files:
        save_base_metadata(session, data)
    else:
        meta_path = base_metadata_path(session)
        if meta_path.is_file():
            meta_path.unlink()
        if base_root.is_dir() and not any(base_root.iterdir()):
            shutil.rmtree(base_root)


def clear_all_base_snapshots(session):
    """Remove all base snapshots in the session."""
    meta_path = base_metadata_path(session)
    if meta_path.is_file():
        meta_path.unlink()
    base_root = base_files_root(session)
    if base_root.exists():
        shutil.rmtree(base_root)


def three_way_merge_difflib(ours_text, base_text, theirs_text):
    """Deterministic pure-Python non-overlapping hunk 3-way merge using difflib.

    Returns (merged_text, clean_bool).
    """
    base_lines = base_text.splitlines(keepends=True)
    ours_lines = ours_text.splitlines(keepends=True)
    theirs_lines = theirs_text.splitlines(keepends=True)

    def extract_edits(src, dst):
        matcher = difflib.SequenceMatcher(None, src, dst, autojunk=False)
        edits = []
        for tag, i1, i2, j1, j2 in matcher.get_opcodes():
            if tag != 'equal':
                edits.append((i1, i2, dst[j1:j2]))
        return edits

    ours_edits = extract_edits(base_lines, ours_lines)
    theirs_edits = extract_edits(base_lines, theirs_lines)

    combined = []
    oi, ti = 0, 0
    while oi < len(ours_edits) or ti < len(theirs_edits):
        if oi < len(ours_edits) and (ti >= len(theirs_edits) or ours_edits[oi][0] <= theirs_edits[ti][0]):
            edit = ('ours', ours_edits[oi][0], ours_edits[oi][1], ours_edits[oi][2])
            oi += 1
        else:
            edit = ('theirs', theirs_edits[ti][0], theirs_edits[ti][1], theirs_edits[ti][2])
            ti += 1
        combined.append(edit)

    merged_edits = []
    for side, start, end, repl in combined:
        if not merged_edits:
            merged_edits.append([side, start, end, repl])
            continue
        prev_side, prev_start, prev_end, prev_repl = merged_edits[-1]
        if start < prev_end or (start == prev_end and (prev_start == prev_end or start == end)):
            if start == prev_start and end == prev_end and repl == prev_repl:
                continue
            return None, False
        merged_edits.append([side, start, end, repl])

    out = []
    cursor = 0
    for _, start, end, repl in merged_edits:
        out.extend(base_lines[cursor:start])
        out.extend(repl)
        cursor = end
    out.extend(base_lines[cursor:])
    return ''.join(out), True


def three_way_merge(ours_path, base_path, theirs_path, prefer_pure_python=False):
    """Attempt a clean 3-way merge of ours_path, base_path, theirs_path.

    First tries `git merge-file -p` if git is on PATH (unless prefer_pure_python=True),
    and falls back to `three_way_merge_difflib`.
    Returns (merged_bytes, True) on clean merge, or (None, False) on conflict / non-UTF8.
    """
    for p in (ours_path, base_path, theirs_path):
        if not is_utf8_text_file(p):
            return None, False

    if not prefer_pure_python and shutil.which('git'):
        with tempfile.TemporaryDirectory(prefix='.staged-merge-') as tmpdir:
            tmp_ours = Path(tmpdir) / 'ours'
            tmp_base = Path(tmpdir) / 'base'
            tmp_theirs = Path(tmpdir) / 'theirs'
            shutil.copy2(ours_path, tmp_ours)
            shutil.copy2(base_path, tmp_base)
            shutil.copy2(theirs_path, tmp_theirs)
            try:
                res = subprocess.run(
                    ['git', 'merge-file', '-p', str(tmp_ours), str(tmp_base), str(tmp_theirs)],
                    capture_output=True
                )
                if res.returncode == 0:
                    return res.stdout, True
                elif res.returncode > 0:
                    return None, False
            except OSError:
                pass

    ours_text = Path(ours_path).read_text(encoding='utf-8')
    base_text = Path(base_path).read_text(encoding='utf-8')
    theirs_text = Path(theirs_path).read_text(encoding='utf-8')
    merged_text, ok = three_way_merge_difflib(ours_text, base_text, theirs_text)
    if not ok:
        return None, False
    return merged_text.encode('utf-8'), True


def write_bytes_atomic(path, data, mode=None):
    path = Path(path)
    if mode is None and path.is_file():
        mode = stat.S_IMODE(path.stat().st_mode)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.staged-', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
        if mode is not None:
            os.chmod(name, mode)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def check_workspace_drifted(ws_file, base_entry):
    """Return True if ws_file drifted relative to base_entry."""
    if base_entry is None:
        return False
    existed = bool(base_entry.get('existed', False))
    currently_exists = ws_file.is_file()
    if existed != currently_exists:
        return True
    if not existed:
        return False
    current_hash = file_sha256(ws_file)
    return current_hash != base_entry.get('sha256')


def plan_apply_changes(ctx, session, paths):
    """Inspect all paths before mutating the workspace."""
    force = bool(getattr(ctx.args, 'force', False))
    no_merge = bool(getattr(ctx.args, 'no_merge', False))
    base_data = load_base_metadata(session)
    base_files = base_data.get('files', {})
    base_root = base_files_root(session)
    plan = []

    for rel in paths:
        orig_rel = session.manifest.get(rel, rel)
        dest = safe_path(session.workspace, rel)
        old = safe_path(session.workspace, orig_rel)
        orig_base = base_files.get(orig_rel)
        dest_base = base_files.get(rel)

        if rel in session.deletions:
            if not dest.exists():
                plan.append({'rel': rel, 'orig_rel': orig_rel, 'action': 'delete', 'dest': dest, 'old': old})
                continue
            if orig_base is not None and check_workspace_drifted(dest, orig_base):
                if not force:
                    raise StagedError(
                        "Workspace file '{}' was modified since staging began. Pass --force to delete anyway.".format(rel)
                    )
            plan.append({'rel': rel, 'orig_rel': orig_rel, 'action': 'delete', 'dest': dest, 'old': old})
            continue

        staged_file = safe_path(session.staging, rel)
        if equal_files(dest, staged_file):
            if old == dest or not old.exists():
                plan.append({
                    'rel': rel, 'orig_rel': orig_rel, 'action': 'noop',
                    'dest': dest, 'old': old, 'staged': staged_file,
                    'mode': file_mode(staged_file)
                })
                continue
            elif orig_base is None or not check_workspace_drifted(old, orig_base):
                # Destination already matches staged, but old rename source exists and hasn't drifted
                plan.append({
                    'rel': rel, 'orig_rel': orig_rel, 'action': 'apply',
                    'dest': dest, 'old': old, 'staged': staged_file,
                    'mode': file_mode(staged_file)
                })
                continue

        drifted_orig = check_workspace_drifted(old, orig_base) if orig_base is not None else False
        drifted_dest = (
            rel != orig_rel
            and dest.exists()
            and not equal_files(dest, staged_file)
            and (dest_base is None or check_workspace_drifted(dest, dest_base))
        )
        if not drifted_orig and not drifted_dest:
            plan.append({
                'rel': rel, 'orig_rel': orig_rel, 'action': 'apply',
                'dest': dest, 'old': old, 'staged': staged_file,
                'mode': file_mode(staged_file)
            })
            continue

        base_snapshot_file = safe_path(base_root, orig_rel) if base_root.exists() else None
        can_try_merge = (
            not no_merge
            and orig_base is not None
            and orig_base.get('existed') is True
            and base_snapshot_file is not None
            and base_snapshot_file.is_file()
            and old.is_file()
            and not drifted_dest
        )

        if can_try_merge:
            prefer_py = bool(getattr(ctx.args, 'prefer_pure_python_merge', False))
            merged_bytes, ok = three_way_merge(old, base_snapshot_file, staged_file, prefer_pure_python=prefer_py)
            if ok:
                plan.append({
                    'rel': rel, 'orig_rel': orig_rel, 'action': 'merge',
                    'dest': dest, 'old': old, 'staged': staged_file,
                    'merged_bytes': merged_bytes,
                    'mode': file_mode(staged_file) or file_mode(old)
                })
                continue

        if not force:
            raise StagedError(
                "Conflict in '{}': workspace file was modified concurrently and overlaps with staged changes. "
                "Reconcile in staging or pass --force to overwrite.".format(rel)
            )

        plan.append({
            'rel': rel, 'orig_rel': orig_rel, 'action': 'apply',
            'dest': dest, 'old': old, 'staged': staged_file,
            'mode': file_mode(staged_file)
        })

    return plan


def backups_root(session):
    root = session.directory / '.backups'
    if root.is_symlink():
        raise StagedError('Session .backups directory cannot be a symlink: {}'.format(root))
    return root


def create_backup_dir(session):
    root = backups_root(session)
    root.mkdir(parents=True, exist_ok=True)
    ts_ms = int(time.time() * 1000)
    short_id = uuid.uuid4().hex[:8]
    backup_id = '{}_{}'.format(ts_ms, short_id)
    bdir = safe_path(root, backup_id)
    bdir.mkdir(parents=True, exist_ok=False)
    (bdir / 'files').mkdir(parents=True, exist_ok=True)
    return backup_id, bdir


def begin_backup(session, rels):
    """Snapshot workspace paths before an apply so `staged undo` can restore them."""
    backup_id, bdir = create_backup_dir(session)
    entries = []
    for p_rel in dict.fromkeys(rels):
        ws_path = safe_path(session.workspace, p_rel)
        existed = ws_path.is_file()
        if existed:
            copy_atomic(ws_path, safe_path(bdir / 'files', p_rel))
        entries.append({
            'path': p_rel,
            'existed': existed,
            'sha256_before': file_sha256(ws_path) if existed else None,
            'sha256_after': None,
            'mode': file_mode(ws_path) if existed else None,
        })
    return backup_id, bdir, entries


def finish_backup(session, backup_id, bdir, entries):
    for entry in entries:
        ws_path = safe_path(session.workspace, entry['path'])
        entry['sha256_after'] = file_sha256(ws_path) if ws_path.is_file() else None
    save_json(bdir / 'backup.json', {'id': backup_id, 'created_at': time.time(), 'entries': entries})


def apply_changes(ctx, session, target):
    paths = selected(session, target)
    preflight(session, paths)
    guard_apply(ctx, session)
    plan = plan_apply_changes(ctx, session, paths)

    backup_id, bdir, recorded_paths = begin_backup(
        session, [p for item in plan for p in (item['orig_rel'], item['rel'])])
    results = []

    for item in plan:
        rel = item['rel']
        orig_rel = item['orig_rel']
        action = item['action']
        dest = item['dest']
        old = item['old']

        if action == 'delete':
            if dest.exists():
                dest.unlink()
            remove_base_snapshot(session, rel)
            results.append(('DELETED', rel))
        elif action == 'merge':
            write_bytes_atomic(dest, item['merged_bytes'], mode=item['mode'])
            if old != dest and old.is_file():
                old.unlink()
                remove_base_snapshot(session, orig_rel)
            write_bytes_atomic(item['staged'], item['merged_bytes'], mode=item['mode'])
            record_base_snapshot(session, rel, reset=True)
            results.append(('MERGED', rel))
        elif action == 'apply':
            copy_atomic(item['staged'], dest)
            if old != dest and old.is_file():
                old.unlink()
                remove_base_snapshot(session, orig_rel)
            record_base_snapshot(session, rel, reset=True)
            results.append(('APPLIED', rel))
        elif action == 'noop':
            record_base_snapshot(session, rel, reset=True)
            results.append(('APPLIED', rel))

    finish_backup(session, backup_id, bdir, recorded_paths)
    session.refresh_index()
    if not getattr(ctx.args, 'json', False):
        for status, rel in results:
            print(status_row(status, rel))
    return {'session': session.id, 'backup': backup_id,
            'applied': [{'path': rel, 'status': status} for status, rel in results]}


def list_backups(session):
    root = backups_root(session)
    if not root.is_dir():
        return []
    backups = []
    for d in sorted(root.iterdir()):
        if d.is_dir() and not d.is_symlink() and (d / 'backup.json').is_file():
            backups.append(d)
    return backups


def undo_apply(ctx, session):
    """Restore workspace files from the latest backup in <session>/.backups/."""
    backups = list_backups(session)
    if not backups:
        raise StagedError('No applied changes to undo in session {}.'.format(session.id))
    latest_dir = backups[-1]
    meta = load_json(latest_dir / 'backup.json')
    entries = meta.get('entries', [])
    if not isinstance(entries, list):
        raise StagedError('Invalid backup metadata in {}'.format(latest_dir))

    force = bool(getattr(ctx.args, 'force', False))
    yes = bool(getattr(ctx.args, 'yes', False))
    as_json = bool(getattr(ctx.args, 'json', False))

    drifted = []
    for entry in entries:
        rel = entry['path']
        ws_path = safe_path(session.workspace, rel)
        current_sha = file_sha256(ws_path) if ws_path.is_file() else None
        if current_sha != entry.get('sha256_after'):
            drifted.append(rel)

    if drifted and not force:
        confirm(
            "Workspace file(s) modified after apply ({}). Overwrite and undo anyway?".format(', '.join(drifted)),
            yes
        )

    backup_files_root = latest_dir / 'files'
    restored_paths = []
    for entry in entries:
        rel = entry['path']
        ws_path = safe_path(session.workspace, rel)
        if entry.get('existed'):
            src = safe_path(backup_files_root, rel)
            if not src.is_file():
                raise StagedError('Missing backup file for {}: {}'.format(rel, src))
            copy_atomic(src, ws_path)
            if entry.get('mode') is not None:
                os.chmod(ws_path, entry['mode'])
            record_base_snapshot(session, rel, reset=True)
        else:
            if ws_path.is_file():
                ws_path.unlink()
            record_base_snapshot(session, rel, reset=True)
        restored_paths.append(rel)

    shutil.rmtree(latest_dir)
    root = backups_root(session)
    if root.is_dir() and not any(root.iterdir()):
        root.rmdir()

    session.refresh_index()

    if as_json:
        print(json.dumps({
            'operation': 'undo',
            'session': session.id,
            'backup_id': meta.get('id', latest_dir.name),
            'restored': restored_paths,
        }))
    else:
        for rel in restored_paths:
            print(status_row('UNDONE', rel))

