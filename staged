def resolve_meta_alias(target, paths):
    if target not in paths and target.lower() in META_ALIASES and META_ALIASES[target.lower()] in paths:
        return META_ALIASES[target.lower()]
    return target


def open_file(ctx, session, target):
    meta = ctx.args.meta
    paths = session.openable_paths(fresh=True, meta=meta)
    if not paths:
        raise StagedError('No {} files to open.'.format('metadata' if meta else 'staged'))
    rel = match_file(resolve_meta_alias(target, paths) if meta else target, paths)
    path = safe_path(session.directory if meta else session.staging, rel)
