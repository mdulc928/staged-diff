def run_editor(command, terminal=False):
    # Native .exe files need no shell. Batch launchers require cmd.exe on Windows.
    if os.name == 'nt' and command[0].lower().endswith(('.cmd', '.bat')):
        if any(any(ch in arg for ch in '\r\n%"&|<>^!') for arg in command):
            raise StagedError('Batch launcher cannot safely represent these arguments; use a native executable.')
        shell = subprocess.list2cmdline([os.environ.get('COMSPEC', 'cmd.exe')])
        quoted = ' '.join('"{}"'.format(arg) for arg in command)
        command = '{} /d /s /c "{}"'.format(shell, quoted)
    result = subprocess.run(command)
    if result.returncode not in ((0, 1) if terminal else (0,)):
        raise StagedError('Editor/diff command failed with exit code {}'.format(result.returncode))


def init_session(ctx, key, root=None):
    key = session_id(key)
    root = root or ctx.staging_root()
    try:
        root.relative_to(ctx.workspace)
    except ValueError:
        pass
    else:
        raise StagedError('Staging root must be outside the workspace: ' + str(root))
    directory = safe_path(root, key)
    if directory.exists():
        if not (directory / '.workspace').is_file():
            raise StagedError('Directory already exists without session metadata: ' + str(directory))
        session = Session(directory)
        if session.workspace != ctx.workspace:
            raise StagedError('Session belongs to a different workspace: ' + str(session.workspace))
        record_install('roots', str(root))
        return session
    (directory / 'staging').mkdir(parents=True)
    write_text_file(directory / '.workspace', str(ctx.workspace) + '\n')
    save_json(directory / 'session.json', {'id': key, 'branch': get_git_branch(ctx.workspace), 'created_at': time.time()})
    save_json(directory / 'renames.json', {})
    record_install('roots', str(root))
    return Session(directory)


def summary_text(value):
    # Keep multiline author input readable in terminal lists.
    return ' '.join(value.split()) or '(no summary yet)'


def show_session_summary(session, summaries):
    print('{} {}'.format(color('Session', '1'), color(session.id, '1;36')), flush=True)
    show_summary_text(summaries['session'])


def show_summary_text(value, indent='    ', separate=True):
    print(wrapped_summary(value, indent), flush=True)
    if separate:
        print(flush=True)


def status_sort_key(status):
    try:
        return STATUS_ORDER.index(status)
    except ValueError:
        return len(STATUS_ORDER)


def grouped_by_status(session, paths, proposed=None):
    """Order paths by status group, then path, for human-readable listings."""
    known = None if proposed is None else set(proposed)
    rows = []
    for rel in paths:
        status = session.status(rel) if known is None or rel in known else None
        rows.append((status_sort_key(status), rel, status))
    rows.sort(key=lambda item: (item[0], item[1]))
    return [(status, rel) for _, rel, status in rows]


def update_summary(session, args):
    summaries = session.summaries()
    if args.file is not None:
        safe_path(session.staging, args.file)
        if args.file not in session.paths(fresh=True):
            raise StagedError('No staged change at exact path: ' + args.file)
    if not (args.message is not None or args.stdin or args.clear):
        raise StagedError('Nothing to write; pass --message, --stdin or --clear. View summaries with staged --summary.')
    if args.session_message is not None and args.file is None:
        raise StagedError('--session-message requires a file summary update with --file.')
    value = args.message
    if args.stdin:
        if sys.stdin.isatty():
            raise StagedError('--stdin requires piped or redirected input; use --message for inline content.')
        try:
            value = sys.stdin.buffer.read().decode('utf-8')
        except UnicodeDecodeError as exc:
            raise StagedError('Summary input must be UTF-8: {}'.format(exc))
    value = '' if args.clear else value.strip()
    if args.file is None:
        summaries['session'] = value
    elif value:
        summaries['files'][args.file] = value
    else:
        summaries['files'].pop(args.file, None)
    if args.session_message is not None:
        summaries['session'] = args.session_message.strip()
    session.save_summaries(summaries)
    if args.json:
        print(json.dumps(summaries))
    else:
        print('Updated summary: ' + (args.file or session.id))


def wrapped_summary(value, indent='    '):
    text = summary_text(value)
    if not value.strip():
        return color(indent + text, '2')
    width = max(40, min(100, shutil.get_terminal_size((100, 24)).columns) - len(indent))
    lines = textwrap.wrap(text, width) or [text]
    return color('\n'.join(indent + line for line in lines), '36')


def show_summaries(session, target, as_json=False):
    summaries = session.summaries()
    proposed = session.paths()
    paths = proposed
    if target is not None:
        if target not in proposed and target not in summaries['files']:
            target = match_file(target, proposed)
        paths = [target]
    if as_json:
        if target is None:
            print(json.dumps(summaries))
        else:
            print(json.dumps({'session': summaries['session'], 'path': target,
                              'summary': summaries['files'].get(target, '')}))
        return
    if target is None:
        show_session_summary(session, summaries)
        if not paths:
            print(color('No staged changes yet.', '2'))
    previous = None
    for status, rel in grouped_by_status(session, paths, proposed):
        if previous is not None and status != previous:
            print(flush=True)
        previous = status
        print('{} {}'.format(status_token(status, width=9) if status else '', color(rel, '1')).strip())
        show_summary_text(summaries['files'].get(rel, ''))


def overview(ctx, session):
    branch = get_git_branch(session.workspace)
    protected = ctx.setting('branch_protection', True) and is_branch_protected(branch, ctx.setting('protected_branches', DEFAULT_PROTECTED_BRANCHES))
    for label, value in [('Repository:', session.workspace), ('Active Session:', color(session.id, '36')),
                         ('Active Tool:', color(ctx.tool().name, '36')),
                         ('Git Branch:', color(branch or '(not a Git repository)', '31' if protected else '32')),
                         ('Staging:', session.staging)]:
        print('{} {}'.format(color('{:15}'.format(label), '1'), value))
    summaries = session.summaries() if ctx.args.verbose else None
    if summaries is not None:
        show_session_summary(session, summaries)
    paths = session.paths()
    if not paths:
        print('No staged changes yet.')
    previous = None
    for status, rel in grouped_by_status(session, paths):
        if previous is None:
            if summaries is None:
                print(flush=True)
        elif status != previous:
            print(flush=True)
        previous = status
        print('  {} {}'.format(status_token(status, width=9), rel))
        if ctx.args.verbose:
            show_summary_text(summaries['files'].get(rel, ''), separate=False)
            path = safe_path(session.staging, rel)
            print('    Staged:    {}'.format(path if path.exists() else '(deletion)'))
            print('    Workspace: {}'.format(session.original(rel)))
            print('    Changes:   {}'.format(format_diff_stats(session, rel)))
            if path.exists():
                print('    Size: {} bytes; modified: {}'.format(path.stat().st_size, time.ctime(path.stat().st_mtime)))
            print(flush=True)
    session.refresh_index()


def review(ctx, session, target):
    tool = ctx.tool()
    terminal = tool.id in ('cli', 'codex', 'claudecode')
    summaries = session.summaries() if ctx.args.verbose else None
    if summaries is not None:
        show_session_summary(session, summaries)
    for rel in selected(session, target):
        if target is None and session.status(rel) == 'APPLIED':
            continue
        original = session.original(rel)
        proposed = safe_path(session.staging, rel)
        if rel not in session.deletions and not proposed.is_file():
            raise StagedError('Missing staged contents: ' + rel)
        # GUI launchers often return before opening tabs; keep the empty side on disk.
        empty = safe_path(session.directory, '.review/empty/' + rel)
        write_text_file(empty, '')
        left = original if original.is_file() else empty
        right = empty if rel in session.deletions else proposed
        print('Review {}: {}'.format(status_token(session.status(rel)), rel), flush=True)
        if summaries is not None:
            show_summary_text(summaries['files'].get(rel, ''))
        run_editor(tool.get_diff_command(left, right), terminal)


META_ALIASES = {
