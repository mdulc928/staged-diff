#compdef staged
_staged() {
  local -a candidates
  local file_helper=--list
  if (( ${words[(Ie)open]} )); then
    file_helper=--complete-open
    if (( ${words[(Ie)--meta]} )); then file_helper=--complete-meta; fi
  fi
  case "${words[CURRENT-1]}" in
    --tool|-t) candidates=("${(@f)$(command staged --complete-tools 2>/dev/null)}") ;;
    --session|--from|--between|--compare-session|--default-session)
      candidates=("${(@f)$(command staged --complete-sessions 2>/dev/null)}") ;;
    --to)
      if (( ${words[(Ie)copy]} || ${words[(Ie)rename]} )); then
        candidates=()
      else
        candidates=("${(@f)$(command staged --complete-sessions 2>/dev/null)}")
      fi ;;
    use)
      candidates=("${(@f)$(command staged --complete-sessions 2>/dev/null)}"
                  "${(@f)$(command staged --complete-options "${(@)words[2,CURRENT-1]}" 2>/dev/null)}") ;;
    -s)
      if (( ${words[(Ie)path]} )); then
        candidates=("${(@f)$(command staged --complete-options "${(@)words[2,CURRENT-1]}" 2>/dev/null)}")
      else
        candidates=("${(@f)$(command staged --complete-sessions 2>/dev/null)}")
      fi ;;
    --branch-protection) candidates=(true false) ;;
    --file|-f)
      candidates=("${(@f)$(command staged "$file_helper" 2>/dev/null)}")
      local candidate query="${words[CURRENT]:l}"
      local -a matches=()
      for candidate in "${candidates[@]}"; do
        if [[ "${candidate:l}" == *"$query"* ]]; then
          matches+=("$candidate")
        fi
      done
      # Matching is already done; allow insertion of a full path for a substring query.
      compadd -U -- "${matches[@]}"
      if (( ${#matches[@]} > 1 )); then
        # A common prefix can be empty for substring matches. List on the first
        # Tab without replacing the query; another Tab begins menu selection.
        if [[ "${compstate[old_list]}" == (yes|shown) || "${compstate[insert]}" == menu* ]]; then
          compstate[insert]=menu
        else
          compstate[insert]=''
          compstate[list]=list
        fi
      fi
      return ;;
    --shell)
      candidates=(bash zsh powershell) ;;
    *)
      if (( CURRENT >= 3 )) && [[ "${words[CURRENT-2]}" == --between ]]; then
        candidates=("${(@f)$(command staged --complete-sessions 2>/dev/null)}")
      else
        candidates=("${(@f)$(command staged --complete-options "${(@)words[2,CURRENT-1]}" 2>/dev/null)}")
      fi ;;
  esac
  compadd -M 'm:{a-zA-Z}={A-Za-z}' -- "${candidates[@]}"
}
_staged "$@"
