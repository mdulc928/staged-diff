#!/usr/bin/env python3
"""
staged: Universal side-by-side diff launcher and staging manager.
Pure Python 3 standard library implementation.
Supports: Cursor, Antigravity IDE, Windsurf, VS Code, JetBrains, Zed, Claude Code, Codex, CLI.
"""

import os
import sys
import json
import glob
import shutil
import subprocess
import re
import time
import filecmp
import textwrap
from pathlib import Path

HOME = os.path.expanduser("~")
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DEFAULT_STAGING_ROOT = os.path.join(HOME, ".local", "share", "stage")
LEGACY_CURSOR_ROOT = os.path.join(HOME, ".local", "share", "cursor-artifact-staging")
LEGACY_ANTIGRAVITY_ROOT = os.path.join(HOME, ".gemini", "antigravity-ide", "brain")

CONFIG_DIR = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config", "staged")
GLOBAL_STATE_DIR = os.path.join(HOME, ".staged-diff")
GLOBAL_STATE_FILE = os.path.join(GLOBAL_STATE_DIR, "state.json")
SHELL_SESSIONS_DIR = os.path.join(GLOBAL_STATE_DIR, "shell_sessions")

DEFAULT_PROTECTED_BRANCHES = ["main", "master", "production", "release/*", "staging", "develop"]

STATUS_COLORS = {
    "APPLIED": "32",   # Green
    "MODIFIED": "33",  # Yellow
    "NEW FILE": "36",  # Cyan
    "RENAMED": "35",   # Magenta
    "RELOCATED": "35", # Magenta
}

SUBCOMMANDS = {
    "diff", "apply", "clean", "rename", "path", "use",
    "set", "set-tool", "migrate", "install-skill", "help"
}

# --- Styling & Output Helpers ---

def colorize(text, color_code):
    if sys.stdout.isatty():
        return f"\033[{color_code}m{text}\033[0m"
    return text

def colorize_placeholders(text):
    return "".join(
        colorize(part, "33") if part.startswith("<") and part.endswith(">") else part
        for part in re.split(r"(<[^>]+>)", text)
    )

def colorize_usage_invocation(invocation, program):
    def paint(token):
        if token == program or token in ("stage", "staged", "staged-diff"):
            return colorize(token, "1;36")
        if token in SUBCOMMANDS or token == "all":
            return colorize(token, "1")
        if token.startswith("<") and token.endswith(">"):
            return colorize(token, "33")
        if token.startswith("--") or re.fullmatch(r"-[A-Za-z],?", token):
            return colorize(token, "36")
        if token.startswith("[") and token.endswith("]") and "|" in token:
            inner = token[1:-1]
            painted = "|".join(
                colorize(part, "36") if part.startswith("-") else part
                for part in inner.split("|")
            )
            return "[" + painted + "]"
        return token

    return "".join(
        paint(token) if not token.isspace() else token
        for token in re.findall(r"\s+|\S+", invocation)
    )

def print_usage_line(line, program="staged"):
    gaps = list(re.finditer(r" {2,}(?=[A-Z])", line))
    if not gaps:
        print(colorize_usage_invocation(line, program))
        return
    gap = gaps[-1]
    print(
        f"{colorize_usage_invocation(line[:gap.start()], program)}"
        f"{gap.group(0)}{line[gap.end():]}"
    )

def print_status_legend(status, description):
    tag = f"[{status}]"
    print(f"  {colorize(tag, STATUS_COLORS[status])}{' ' * (13 - len(tag))}{description}")

def format_relative_time(ts):
    now = time.time()
    diff = max(0, now - ts)
    if diff < 60:
        return "just now"
    elif diff < 3600:
        return f"{int(diff / 60)}m ago"
    elif diff < 86400:
        return f"{int(diff / 3600)}h ago"
    else:
        return f"{int(diff / 86400)}d ago"

def is_file_equal(path1, path2):
    if not (path1 and path2 and os.path.isfile(path1) and os.path.isfile(path2)):
        return False
    try:
        if filecmp.cmp(path1, path2, shallow=False):
            return True
        with open(path1, "r", encoding="utf-8", errors="replace") as f1, \
             open(path2, "r", encoding="utf-8", errors="replace") as f2:
            c1 = f1.read().replace("\r\n", "\n").rstrip()
            c2 = f2.read().replace("\r\n", "\n").rstrip()
            if c1 == c2:
                return True
            lines1 = [l.strip() for l in c1.splitlines() if l.strip()]
            lines2 = [l.strip() for l in c2.splitlines() if l.strip()]
            return lines1 == lines2
    except Exception:
        return False

# --- Git Helpers ---

def get_git_root(path):
    try:
        res = subprocess.run(
            ["git", "-C", path, "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True
        )
        out = os.path.realpath(res.stdout.strip())
        if out == os.path.realpath(HOME):
            return None
        return out
    except Exception:
        return None

def get_git_branch(path):
    try:
        res = subprocess.run(
            ["git", "-C", path, "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True, text=True, check=True
        )
        return res.stdout.strip()
    except Exception:
        return None

def is_branch_protected(branch_name, protected_list=None):
    if not branch_name:
        return False
    if protected_list is None:
        protected_list = DEFAULT_PROTECTED_BRANCHES
    for pattern in protected_list:
        if pattern.endswith("*"):
            prefix = pattern[:-1]
            if branch_name.startswith(prefix):
                return True
        elif branch_name == pattern:
            return True
    return False

# --- Tool Adapters Engine ---

JETBRAINS_CLI_NAMES = ("charm", "pycharm", "idea")

def detect_jetbrains_binary():
    """Resolve JetBrains IDE CLI (charm / pycharm / idea) when Toolbox scripts are not on PATH."""
    for name in JETBRAINS_CLI_NAMES:
        found = shutil.which(name)
        if found:
            return found
    toolbox_dirs = [
        os.path.join(HOME, "Library", "Application Support", "JetBrains", "Toolbox", "scripts"),
        os.path.join(HOME, ".local", "share", "JetBrains", "Toolbox", "scripts"),
    ]
    for toolbox in toolbox_dirs:
        if not os.path.isdir(toolbox):
            continue
        for name in JETBRAINS_CLI_NAMES:
            script = os.path.join(toolbox, name)
            if os.path.isfile(script):
                return script
    if sys.platform == "darwin":
        for pattern in (
            "/Applications/PyCharm*.app/Contents/MacOS/pycharm",
            "/Applications/IntelliJ IDEA*.app/Contents/MacOS/idea",
            "/Applications/WebStorm*.app/Contents/MacOS/webstorm",
        ):
            matches = sorted(glob.glob(pattern))
            if matches:
                return matches[0]
    return None

def jetbrains_cli_missing_message():
    return (
        "JetBrains command-line launcher not found (tried: charm, pycharm, idea).\n"
        "In JetBrains Toolbox: Settings → Tools → Generate shell scripts, then ensure "
        "the scripts directory is on your PATH.\n"
        "macOS default: ~/Library/Application Support/JetBrains/Toolbox/scripts"
    )

def run_editor_command(cmd, tool_adapter):
    exe = cmd[0] if cmd else ""
    if not exe:
        print("Error: Empty editor command.", file=sys.stderr)
        sys.exit(1)
    missing = not os.path.isfile(exe) and shutil.which(exe) is None
    if missing:
        if tool_adapter.tool_id == "pycharm":
            print(colorize("Error: " + jetbrains_cli_missing_message(), "31"), file=sys.stderr)
        else:
            print(f"Error: Editor executable not found: {exe}", file=sys.stderr)
        sys.exit(1)
    try:
        subprocess.run(cmd, check=False)
    except FileNotFoundError:
        if tool_adapter.tool_id == "pycharm":
            print(colorize("Error: " + jetbrains_cli_missing_message(), "31"), file=sys.stderr)
        else:
            print(f"Error: Failed to run: {exe}", file=sys.stderr)
        sys.exit(1)

class ToolAdapter:
    def __init__(self, tool_id, name, default_root, diff_cmd, open_cmd):
        self.tool_id = tool_id
        self.name = name
        self.default_root = os.path.expanduser(default_root)
        self.diff_cmd = diff_cmd
        self.open_cmd = open_cmd

    def detect_binary(self):
        cmd = self.diff_cmd[0]
        if self.tool_id == "pycharm":
            jetbrains = detect_jetbrains_binary()
            if jetbrains:
                return jetbrains
        found = shutil.which(cmd)
        if found:
            return found
        if sys.platform == "darwin":
            mac_paths = {
                "cursor": "/Applications/Cursor.app/Contents/Resources/app/bin/cursor",
                "antigravity-ide": "/Applications/Antigravity IDE.app/Contents/Resources/app/bin/antigravity-ide",
                "windsurf": "/Applications/Windsurf.app/Contents/Resources/app/bin/windsurf",
                "code": "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code",
                "zed": "/Applications/Zed.app/Contents/MacOS/zed",
            }
            cand = mac_paths.get(cmd)
            if cand and os.path.isfile(cand):
                return cand
        return cmd

    def build_diff_args(self, orig_file, staged_file):
        bin_path = self.detect_binary()
        args = []
        for token in self.diff_cmd:
            if token == "{orig}":
                args.append(orig_file)
            elif token == "{staged}":
                args.append(staged_file)
            elif token == self.diff_cmd[0]:
                args.append(bin_path)
            else:
                args.append(token)
        return args

    def build_open_args(self, staged_file):
        bin_path = self.detect_binary()
        args = []
        for token in self.open_cmd:
            if token == "{staged}":
                args.append(staged_file)
            elif token == self.open_cmd[0]:
                args.append(bin_path)
            else:
                args.append(token)
        return args

